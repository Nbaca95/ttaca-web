---
// src/components/WhatsAppButton.astro
import { getLocaleFromUrl, getTranslations } from "../i18n";

const locale = getLocaleFromUrl(Astro.url);
const t = getTranslations(locale);
---

<div class="fixed bottom-6 right-6 z-50 flex items-center">
  <a
    href="https://wa.me/50684483410"
    target="_blank"
    rel="noopener noreferrer"
    class="group relative flex items-center rounded-full bg-[#25D366] p-3 text-white shadow-[0_8px_30px_rgba(37,211,102,0.45)] transition-all duration-300 hover:scale-105"
    aria-label={t.whatsapp.ariaLabel}
  >
    <!-- Anillo animado de pulso -->
    <span class="absolute inset-0 rounded-full bg-green-400 opacity-30 animate-ping pointer-events-none"></span>

    <!-- Icono de WhatsApp -->
    <span class="relative flex h-8 w-8 shrink-0 items-center justify-center">
      <svg viewBox="0 0 24 24" class="h-8 w-8" fill="currentColor" aria-hidden="true">
        <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.33 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.004c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.003a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.22 8.22 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.26-8.24 2.2 0 4.28.86 5.83 2.42a8.18 8.18 0 0 1 2.42 5.83c0 4.55-3.7 8.24-8.26 8.24Zm4.52-6.17c-.25-.12-1.47-.73-1.7-.81-.23-.08-.39-.12-.56.13-.17.24-.64.8-.78.97-.15.16-.29.18-.54.06-.25-.12-1.04-.38-1.98-1.22-.73-.65-1.23-1.46-1.37-1.7-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.14.16-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.55-1.34-.76-1.83-.2-.48-.4-.42-.56-.42-.14-.01-.31-.01-.48-.01a.93.93 0 0 0-.67.31c-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.02 2.57.12.16 1.75 2.67 4.24 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.16-.48-.28Z" />
      </svg>
    </span>

    <!-- Texto expandible dentro del botón verde -->
    <span class="ml-0 max-w-0 overflow-hidden whitespace-nowrap text-sm font-medium opacity-0 transition-all duration-300 ease-in-out group-hover:ml-2.5 group-hover:max-w-xs group-hover:opacity-100 group-focus-visible:ml-2.5 group-focus-visible:max-w-xs group-focus-visible:opacity-100">
      {t.whatsapp.tooltip}
    </span>
  </a>
</div>
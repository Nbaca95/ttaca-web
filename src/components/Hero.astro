---
import { Image } from "astro:assets";

// Importación de tus imágenes locales
import logoHpe from "../assets/logo-hpe-2025-white.png";
import logoAruba from "../assets/aruba.png";
import bgCircuit from "../assets/content.png";

// Imágenes de servicios
import hero1Img from "../assets/images/Hero15.gif"; // Tu GIF Hero14
import hero2Img from "../assets/images/Hero11.jpg";
import hero4Img from "../assets/images/Symantec.jpg";
import hero12Gif from "../assets/images/Hero12.gif"; // Tu GIF Hero12

import { getLocaleFromUrl, getTranslations, localizedPath } from "../i18n";

const locale = getLocaleFromUrl(Astro.url);
const t = getTranslations(locale);
const contactHref = localizedPath(locale, "/contact");

const darkFrame = "bg-gradient-to-br from-slate-900 to-slate-950";

const slideVisuals = [
  { 
    image: logoHpe, 
    imageAlt: "HPE Logo",
    tintClass: "bg-emerald-500", 
    variant: "logo",
    frameClass: darkFrame,
    logoClass: "w-[60%] max-h-[55%]",
    glow: true,
  },
  { 
    image: logoAruba, 
    imageAlt: "Aruba Logo",
    tintClass: "bg-orange-500", 
    variant: "logo",
    frameClass: darkFrame,
    logoClass: "w-[68%] max-h-[55%]",
    glow: true,
    hidden: true, // <--- Esto oculta el slide de Aruba manteniendo los índices intactos
  },
  { 
    image: hero12Gif, 
    imageAlt: "Outsourcing de TI", 
    tintClass: "bg-sky-500", 
    variant: "photo-wide", 
    frameClass: "bg-slate-900",
  },
  { 
    image: hero1Img, 
    imageAlt: "Consultoría de TI", 
    tintClass: "bg-purple-500", 
    variant: "photo-wide", 
    frameClass: "bg-slate-900",
  },
  { 
    image: hero2Img, 
    imageAlt: "Infraestructura de Redes", 
    tintClass: "bg-cyan-500", 
    variant: "photo-wide",
    frameClass: "bg-slate-900",
  },
  { 
    image: hero4Img, 
    imageAlt: "Ciberseguridad y Soluciones", 
    tintClass: "bg-amber-500", 
    variant: "logo",
    frameClass: "bg-white",
    logoClass: "w-[82%] max-h-[82%]",
    glow: false,
  },
];

// Unimos los slides y filtramos únicamente los que no estén marcados como ocultos
const slides = t.heroCarousel.slides
  .map((slide, index) => ({
    ...slide,
    ...slideVisuals[index],
  }))
  .filter((slide) => !slide.hidden);

const sliderTextData = slides.map(({ tag, title, desc }) => ({ tag, title, desc }));
---

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

<section class="relative w-full min-h-[calc(100vh-6rem)] bg-gradient-to-b from-[#060b19] via-[#0b132b] to-[#111d42] flex items-center overflow-hidden py-12">

    <!-- Fondo de circuitos decorativo -->
    <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden">
        <div
            class="absolute inset-0 bg-repeat opacity-[0.09] mix-blend-overlay"
            style={`background-image: url(${bgCircuit.src}); background-size: 450px;`}
        ></div>
        <div class="absolute inset-0 bg-gradient-to-b from-[#060b19] via-transparent via-25% to-transparent"></div>
    </div>

    <!-- Contenedor principal -->
    <div class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 flex flex-col-reverse md:grid md:grid-cols-12 gap-8 md:gap-8 items-center relative z-10">

        <!-- LADO IZQUIERDO (Texto y botones) -->
        <div class="w-full md:col-span-6 flex flex-col justify-center text-white text-center md:text-left">
            
            <div class="mb-4">
                <span id="hero-tag" class="inline-block bg-white/15 backdrop-blur-md text-tyta-amber text-sm font-bold tracking-widest uppercase px-4 py-1.5 rounded-full border border-white/10 opacity-0 transition-opacity duration-300">
                    {slides[0]?.tag}
                </span>
            </div>

            <h1
                id="hero-title"
                class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight leading-snug sm:leading-tight mb-6 opacity-0 transition-opacity duration-300"
                set:html={slides[0]?.title}
            />

            <p id="hero-desc" class="text-sm sm:text-base text-slate-300 max-w-xl mx-auto md:mx-0 font-normal leading-relaxed mb-8 opacity-0 transition-opacity duration-300">
                {slides[0]?.desc}
            </p>

            <div class="flex flex-col sm:flex-row justify-center md:justify-start gap-4">
                <a
                    href={contactHref}
                    class="group relative inline-flex items-center justify-center bg-tyta-blue text-white text-sm font-bold tracking-wider uppercase px-8 py-4 rounded-full overflow-hidden transition-all duration-300 shadow-[0_4px_20px_rgba(0,112,243,0.3)] hover:shadow-[0_6px_25px_rgba(0,180,134,0.4)] hover:-translate-y-0.5 text-center"
                >
                    <span class="absolute inset-0 w-full h-full bg-gradient-to-r from-emerald-500/0 via-white/20 to-emerald-500/0 -translate-x-full group-hover:translate-x-full transition-transform duration-700 ease-out"></span>
                    <span class="relative z-10 flex items-center gap-2">
                        {t.heroCarousel.ctaPrimary}
                        <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                    </span>
                </a>
                
                <a
                    href="#servicios"
                    class="group relative inline-flex items-center justify-center bg-white/5 hover:bg-white/10 text-white text-sm font-bold tracking-wider uppercase px-8 py-4 rounded-full backdrop-blur-md border border-white/15 hover:border-white/40 transition-all duration-300 hover:-translate-y-0.5 shadow-sm hover:shadow-[0_4px_20px_rgba(255,255,255,0.1)] text-center"
                >
                    <span class="relative z-10">
                        {t.heroCarousel.ctaSecondary}
                    </span>
                </a>
            </div>
        </div>

        <!-- LADO DERECHO (Carrusel) -->
        <div class="w-full md:col-span-6 h-[320px] sm:h-[400px] md:h-[520px] flex items-center justify-center">
            <div class="swiper hero-swiper w-full h-full">
                <div class="swiper-wrapper">
                    {slides.map((slide, index) => {
                        const imageSrc = typeof slide.image === 'string' ? slide.image : (slide.image && 'src' in slide.image ? slide.image.src : '');
                        const isGif = imageSrc.endsWith('.gif');

                        return (
                            <div class="swiper-slide flex items-center justify-center">
                                <div class="group relative flex justify-center w-full p-2">

                                    <div
                                        class={`relative w-full max-w-[380px] sm:max-w-[480px] md:max-w-[580px] aspect-[4/3] overflow-hidden rounded-3xl border border-white/10 shadow-[0_20px_50px_rgba(0,0,0,0.6)] flex items-center justify-center ${slide.frameClass}`}
                                    >
                                        {slide.variant === "logo" && (
                                            <Fragment>
                                                {slide.glow && (
                                                    <div class={`absolute w-2/3 aspect-square rounded-full blur-3xl opacity-25 ${slide.tintClass}`}></div>
                                                )}
                                                <Image
                                                    src={slide.image}
                                                    alt={slide.imageAlt || "T&TA Service Image"}
                                                    width={800}
                                                    loading={index === 0 ? "eager" : "lazy"}
                                                    class={`relative z-10 h-auto object-contain ${slide.logoClass}`}
                                                />
                                            </Fragment>
                                        )}

                                        {slide.variant === "photo-wide" && (
                                            isGif ? (
                                                <img
                                                    src={imageSrc}
                                                    alt={slide.imageAlt || "T&TA Service Image"}
                                                    loading={index === 0 ? "eager" : "lazy"}
                                                    class="absolute inset-0 w-full h-full object-fill transition-transform duration-700 group-hover:scale-105"
                                                />
                                            ) : (
                                                <Image
                                                    src={slide.image}
                                                    alt={slide.imageAlt || "T&TA Service Image"}
                                                    width={1000}
                                                    loading={index === 0 ? "eager" : "lazy"}
                                                    class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                                                />
                                            )
                                        )}

                                        {slide.variant === "photo-tall" && (
                                            <Fragment>
                                                {isGif ? (
                                                    <img
                                                        src={imageSrc}
                                                        alt=""
                                                        aria-hidden="true"
                                                        class="absolute inset-0 w-full h-full object-cover scale-125 blur-2xl opacity-60"
                                                    />
                                                ) : (
                                                    <Image
                                                        src={slide.image}
                                                        alt=""
                                                        aria-hidden="true"
                                                        width={400}
                                                        class="absolute inset-0 w-full h-full object-cover scale-125 blur-2xl opacity-60"
                                                    />
                                                )}

                                                <div class="absolute inset-0 bg-slate-950/40"></div>

                                                {isGif ? (
                                                    <img
                                                        src={imageSrc}
                                                        alt={slide.imageAlt || "T&TA Service Image"}
                                                        loading={index === 0 ? "eager" : "lazy"}
                                                        class="relative z-10 h-full w-full object-fill"
                                                    />
                                                ) : (
                                                    <Image
                                                        src={slide.image}
                                                        alt={slide.imageAlt || "T&TA Service Image"}
                                                        width={1000}
                                                        loading={index === 0 ? "eager" : "lazy"}
                                                        class="relative z-10 h-full w-auto max-w-full object-contain"
                                                    />
                                                )}
                                            </Fragment>
                                        )}
                                    </div>
                                </div>
                            </div>
                        );
                    })}
                </div>
            </div>
        </div>

    </div>

    <div class="absolute inset-0 bg-[radial-gradient(circle_at_70%_120%,rgba(0,180,134,0.03),transparent_50%)] pointer-events-none"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_120%,rgba(242,142,43,0.02),transparent_40%)] pointer-events-none"></div>
</section>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" is:inline></script>
<script define:vars={{ slides: sliderTextData }}>
    document.addEventListener('DOMContentLoaded', () => {
        const tagEl = document.getElementById('hero-tag');
        const titleEl = document.getElementById('hero-title');
        const descEl = document.getElementById('hero-desc');

        function updateTexts(index) {
            const data = slides[index];
            if (tagEl && titleEl && descEl && data) {
                tagEl.textContent = data.tag;
                titleEl.innerHTML = data.title;
                descEl.textContent = data.desc;
                tagEl.style.opacity = '1';
                titleEl.style.opacity = '1';
                descEl.style.opacity = '1';
            }
        }

        const swiper = new Swiper('.hero-swiper', {
            loop: true,
            effect: 'creative',
            creativeEffect: {
                prev: { opacity: 0, translate: [-20, 0, -100] },
                next: { opacity: 0, translate: [20, 0, -100] }
            },
            autoplay: {
                delay: 4000,
                disableOnInteraction: false,
            },
            on: {
                init: function() {
                    updateTexts(this.realIndex);
                },
                slideChange: function () {
                    const index = this.realIndex;
                    const data = slides[index];

                    if (tagEl && titleEl && descEl && data) {
                        [tagEl, titleEl, descEl].forEach(el => el.style.opacity = '0');

                        setTimeout(() => {
                            tagEl.textContent = data.tag;
                            titleEl.innerHTML = data.title;
                            descEl.textContent = data.desc;

                            [tagEl, titleEl, descEl].forEach(el => el.style.opacity = '1');
                        }, 200);
                    }
                }
            }
        });
    });
</script>
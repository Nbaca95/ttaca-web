---
// src/components/pages/AboutPage.astro
import { Image } from "astro:assets";
import grupoImage from "../../assets/20anos.jpg";
import bgCircuit from "../../assets/content.png";
import { getLocaleFromUrl, getTranslations } from "../../i18n";

const locale = getLocaleFromUrl(Astro.url);
const t = getTranslations(locale);

// Socios estratégicos con sus colores distintivos para el efecto hover
const partnerLogos = [
    { name: 'Kaspersky', colorClass: 'hover:text-[#005B94]' },
    { name: 'VMware', colorClass: 'hover:text-[#607078]' },
    { name: 'Thales', colorClass: 'hover:text-[#00A3E0]' },
    { name: 'Microsoft', colorClass: 'hover:text-[#00A4EF]' },
    { name: 'Veeam', colorClass: 'hover:text-[#00B259]' },
    { name: 'Trend Micro', colorClass: 'hover:text-[#D71920]' },
    { name: 'Micro Focus', colorClass: 'hover:text-[#38C6F4]' },
    { name: 'Fortinet', colorClass: 'hover:text-[#EE3124]' }
];

// Certificaciones y alianzas oficiales para consultoría empresarial
const certifications = [
    { name: 'Hewlett Packard Enterprise (HPE)', category: locale === 'en' ? 'Enterprise Infrastructure Partner' : 'Socio de Infraestructura Empresarial', badgeId: 'hpe', color: '#01A982' },
    { name: 'VMware Certified Professional', category: locale === 'en' ? 'Virtualization & Cloud Expert' : 'Experto en Virtualización y Nube', badgeId: 'vmware', color: '#717074' },
    { name: 'Veeam Modern Data Protection', category: locale === 'en' ? 'Backup & Recovery Specialist' : 'Especialista en Resguardo y Recuperación', badgeId: 'veeam', color: '#00B259' },
    { name: 'HPE Aruba Networking', category: locale === 'en' ? 'Edge-to-Cloud Connectivity' : 'Conectividad de Extremo a Nube', badgeId: 'aruba', color: '#FF8300' },
    { name: 'Dell Technologies Partner', category: locale === 'en' ? 'Servers & Storage Solutions' : 'Soluciones de Servidores y Almacenamiento', badgeId: 'dell', color: '#0076CE' },
    { name: 'Lenovo Enterprise Solutions', category: locale === 'en' ? 'Datacenter Hardware Expert' : 'Experto en Hardware de Centro de Datos', badgeId: 'lenovo', color: '#E2231A' },
    { name: 'Cisco Select Partner', category: locale === 'en' ? 'Networking & Security' : 'Redes y Seguridad', badgeId: 'cisco', color: '#1BA0D7' },
    { name: 'Microsoft Solutions Partner', category: locale === 'en' ? 'Cloud Platform & Infrastructure' : 'Plataforma en la Nube e Infraestructura', badgeId: 'microsoft', color: '#00A4EF' },
    { name: 'ISO/IEC 27001', category: locale === 'en' ? 'Information Security Management' : 'Gestión de Seguridad de la Información', badgeId: 'iso27001', color: '#003DA5' },
    { name: 'ITIL Foundation', category: locale === 'en' ? 'IT Service Management' : 'Gestión de Servicios de TI', badgeId: 'itil', color: '#00A9E0' },
    { name: 'ISO/IEC 20000-1', category: locale === 'en' ? 'IT Service Management System' : 'Sistema de Gestión de Servicios de TI', badgeId: 'iso20000', color: '#003DA5' },
    { name: 'PMP® – Project Management Professional', category: locale === 'en' ? 'Project Management' : 'Gestión de Proyectos', badgeId: 'pmp', color: '#6E2585' },
];
---

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

<style>
    /* Estilos para animación de entrada */
    .reveal {
        opacity: 0;
        transform: translateY(30px);
        transition: all 0.8s ease-out;
    }
    .reveal.active {
        opacity: 1;
        transform: translateY(0);
    }

    /* Estilos modernos y limpios para el carrusel de testimonios sin flechas */
    .testimonials-swiper { 
        padding-bottom: 50px !important; 
    }
    .testimonials-swiper .swiper-pagination { 
        bottom: 0px !important; 
    }
    .testimonials-swiper .swiper-pagination-bullet {
        width: 10px;
        height: 10px;
        background: #cbd5e1;
        opacity: 1;
        transition: all 0.3s ease;
    }
    .testimonials-swiper .swiper-pagination-bullet-active {
        width: 28px;
        border-radius: 6px;
        background: #0f172a;
    }
</style>

<main class="bg-white">
    <!-- Trayectoria / Línea de Tiempo -->
    <section class="py-24 bg-slate-900 text-white overflow-hidden relative">
        <div class="max-w-7xl mx-auto px-6">
            <div class="text-center max-w-3xl mx-auto mb-20">
                <!-- Píldora superior armonizada con Home (Fondo Oscuro) -->
                <span class="inline-block px-6 py-2 mb-6 text-xs font-extrabold uppercase tracking-widest bg-slate-800 rounded-full text-tyta-amber border border-slate-700 shadow-md">
                    {t.aboutPage.journey.title}
                </span>
                
               <!-- <h2 class="text-3xl sm:text-4xl font-extrabold text-white mb-4">
                    {locale === 'en' ? 'Our History & Evolution' : 'Nuestra Historia y Evolución'}
                </h2> -->
                
                <p class="text-xl text-slate-300 leading-relaxed">{t.aboutPage.journey.text}</p>
            </div>

            <!-- Contenedor de la Línea de Tiempo -->
            <div class="relative wrap overflow-hidden py-4">
                <div class="hidden md:block absolute border-l-2 border-slate-700 h-full left-1/2 transform -translate-x-1/2"></div>

                {t.aboutPage.journey.milestones.map((milestone, index) => {
                    const isEven = index % 2 === 0;
                    return (
                        <div class={`mb-16 flex justify-between items-center w-full reveal ${isEven ? 'md:flex-row-reverse' : 'md:flex-row'}`}>
                            <div class="hidden md:block w-5/12"></div>
                            <div class="z-20 hidden md:flex items-center justify-center bg-slate-800 border-4 border-tyta-amber w-12 h-12 rounded-full shadow-lg absolute left-1/2 transform -translate-x-1/2">
                                <div class="w-3 h-3 bg-tyta-amber rounded-full animate-pulse"></div>
                            </div>
                            <div class="w-full md:w-5/12 bg-slate-800/90 border border-slate-700/80 p-8 rounded-2xl shadow-xl hover:border-tyta-amber/50 transition-all duration-300 group">
                                <span class="inline-block px-3 py-1 mb-3 text-xs font-bold tracking-wider bg-tyta-amber/20 text-tyta-amber rounded-full border border-tyta-amber/30">
                                    {milestone.year}
                                </span>
                                <h3 class="text-2xl font-bold mb-3 text-white group-hover:text-tyta-amber transition-colors duration-300">
                                    {milestone.title}
                                </h3>
                                <p class="text-slate-300 leading-relaxed text-sm md:text-base">
                                    {milestone.description}
                                </p>
                            </div>
                        </div>
                    );
                })}
            </div>
        </div>
    </section>

    <!-- Misión y Visión -->
    <section class="bg-slate-50 py-20 px-6">
        <div class="max-w-7xl mx-auto">
            <!-- Píldora de sección general (Fondo Blanco) -->
            <div class="text-center max-w-2xl mx-auto mb-16">
              <!--  <span class="inline-block px-6 py-2 mb-4 text-xs font-extrabold uppercase tracking-widest bg-blue-50 text-tyta-blue rounded-full border border-blue-100 shadow-sm">
                    {locale === 'en' ? 'Purpose & Direction' : 'Propósito y Dirección'}
                </span>
                <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900">
                    {locale === 'en' ? 'Mission & Vision' : 'Misión y Visión'}
                </h2> -->
            </div>

            <div class="grid md:grid-cols-2 gap-12">
                <div class="reveal bg-white p-10 rounded-2xl shadow-sm border border-slate-100 flex flex-col items-center text-center group hover:-translate-y-2 hover:shadow-xl hover:border-tyta-amber/50 transition-all duration-300">
                    <div class="text-4xl text-tyta-blue mb-4 transform group-hover:scale-110 group-hover:rotate-6 transition-transform duration-300">🔍</div>
                    <h3 class="text-2xl font-bold mb-6 text-tyta-blue group-hover:text-tyta-amber transition-colors duration-300">{t.about.mission}</h3>
                    <p class="text-slate-600 leading-relaxed">{t.aboutPage.missionVision.missionText}</p>
                </div>

                <div class="reveal bg-white p-10 rounded-2xl shadow-sm border border-slate-100 flex flex-col items-center text-center group hover:-translate-y-2 hover:shadow-xl hover:border-tyta-amber/50 transition-all duration-300">
                    <div class="text-4xl text-tyta-blue mb-4 transform group-hover:scale-110 group-hover:rotate-6 transition-transform duration-300">🚀</div>
                    <h3 class="text-2xl font-bold mb-6 text-tyta-blue group-hover:text-tyta-amber transition-colors duration-300">{t.about.vision}</h3>
                    <p class="text-slate-600 leading-relaxed">{t.aboutPage.missionVision.visionText}</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Nuestros Valores -->
    <section class="relative py-20 px-6 bg-gradient-to-b from-[#060b19] via-[#0b132b] to-[#111d42] overflow-hidden">
        <div class="absolute inset-0 z-0 pointer-events-none">
            <div
                class="absolute inset-0 bg-repeat opacity-[0.09] mix-blend-overlay"
                style={`background-image: url(${bgCircuit.src}); background-size: 450px;`}
            ></div>
        </div>

        <div class="relative z-10 max-w-7xl mx-auto text-center">
            <!-- Píldora superior armonizada con Home (Fondo Oscuro) -->
            <span class="inline-block px-6 py-2 mb-4 text-xs font-extrabold uppercase tracking-widest bg-slate-800 rounded-full text-tyta-amber border border-slate-700 shadow-md">
                {locale === 'en' ? 'Our Values' : 'Nuestros Valores'}
            </span>
            <!-- <h2 class="reveal text-3xl sm:text-4xl font-extrabold text-white mb-4">{t.aboutPage.values.title}</h2> -->
            <p class="reveal text-slate-300 mb-12 max-w-2xl mx-auto">{t.aboutPage.values.subtitle}</p>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
                {t.aboutPage.values.items.map((value) => (
                    <div class="reveal relative overflow-hidden p-8 bg-slate-800/70 backdrop-blur-sm rounded-2xl border border-slate-700/80 text-center group hover:-translate-y-2 hover:shadow-xl hover:shadow-tyta-amber/10 hover:border-tyta-amber transition-all duration-300 flex flex-col items-center">
                        <div class="text-5xl mb-4 transform group-hover:scale-110 group-hover:-rotate-3 transition-transform duration-300">{value.icon}</div>
                        <h4 class="font-bold text-tyta-amber mb-3 text-xl group-hover:text-amber-400 transition-colors">{value.title}</h4>
                        <p class="text-sm text-slate-300 leading-relaxed flex-grow">{value.desc}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Sección: Insignias y Alianzas Oficiales (Certificaciones) -->
    <section class="py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto bg-white border-t border-slate-100">
        <div class="text-center max-w-2xl mx-auto mb-16">
            <!-- Píldora superior armonizada con Home (Fondo Blanco) -->
            <span class="inline-block px-6 py-2 mb-4 text-xs font-extrabold uppercase tracking-widest bg-blue-50 text-tyta-blue rounded-full border border-blue-100 shadow-sm">
                {locale === 'en' ? 'Accreditations, Certifications, and Official Partnerships' : 'Acreditaciones, Certificaciones y Alianzas oficiales'}
            </span>
          <!--  <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mb-4">
                {locale === 'en' ? 'Our Accreditations & Certifications' : 'Acreditaciones, Certificaciones y Alianzas oficiales'}
            </h2> -->
            <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
                {locale === 'en'
                    ? 'Endorsements from world-class technology leaders guaranteeing the highest execution standards for your business projects.'
                    : 'Avales de líderes tecnológicos globales que garantizan los más altos estándares de ejecución para los proyectos de su empresa.'}
            </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {certifications.map((cert) => (
                <div class="bg-slate-50/50 p-6 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-xl hover:border-tyta-blue/40 transition-all duration-300 flex flex-col items-center text-center group">
                    <div class="w-full h-32 bg-white rounded-xl border-2 border-dashed border-slate-300 flex flex-col items-center justify-center mb-5 group-hover:bg-blue-50/50 group-hover:border-tyta-blue/50 transition-colors">
                        <svg class="w-8 h-8 text-slate-400 mb-1 group-hover:text-tyta-blue transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                        </svg>
                        <span class="text-[11px] font-medium text-slate-400 group-hover:text-tyta-blue">
                            {locale === 'en' ? 'Upload Badge Image' : 'Cargar insignia oficial'}
                        </span>
                    </div>

                    <h3 class="font-extrabold text-slate-900 text-base mb-1 group-hover:text-tyta-blue transition-colors">
                        {cert.name}
                    </h3>
                    <p class="text-xs text-slate-500 font-medium">
                        {cert.category}
                    </p>
                </div>
            ))}
        </div>
    </section>

    <!-- Políticas -->
    <section class="py-20 bg-slate-900 text-white">
        <div class="max-w-7xl mx-auto px-6 text-center">
            <!-- Píldora superior armonizada con Home (Fondo Oscuro) -->
            <span class="inline-block px-6 py-2 mb-4 text-xs font-extrabold uppercase tracking-widest bg-slate-800 rounded-full text-tyta-amber border border-slate-700 shadow-md">
                {locale === 'en' ? 'Our Policies' : 'Nuestras Políticas'}
            </span>
            <!-- <h2 class="text-3xl sm:text-4xl font-extrabold mb-4">{t.aboutPage.policies.title}</h2> -->
            <p class="text-slate-400 mb-16">{t.aboutPage.policies.subtitle}</p>
            
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-8">
                {t.aboutPage.policies.items.map((politica) => (
                    <div class="reveal group flex flex-col items-center gap-4 cursor-pointer">
                        <div class="w-20 h-20 rounded-full border-2 border-slate-600 flex items-center justify-center text-3xl transition-all duration-300 group-hover:-translate-y-2 group-hover:scale-110 group-hover:bg-tyta-amber group-hover:border-tyta-amber group-hover:shadow-lg group-hover:shadow-tyta-amber/20">
                            <span class="transform group-hover:rotate-6 transition-transform duration-300">{politica.icon}</span>
                        </div>
                        <span class="text-sm font-medium text-slate-300 group-hover:text-white transition-colors">{politica.label}</span>
                    </div>
                ))}
            </div>
        </div>
    </section>
</main>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" is:inline></script>
<script is:inline>
    // Scroll Reveal Effect
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) entry.target.classList.add('active');
        });
    }, { threshold: 0.1 });

    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

    // Swiper Configuración Moderna
    document.addEventListener('DOMContentLoaded', () => {
        new Swiper('.testimonials-swiper', {
            loop: true, 
            slidesPerView: 1, 
            spaceBetween: 30, 
            autoHeight: false,
            breakpoints: { 
                768: { slidesPerView: 2 } 
            },
            pagination: { 
                el: '.swiper-pagination', 
                clickable: true 
            },
            autoplay: { 
                delay: 6000, 
                disableOnInteraction: false 
            }
        });
    });
</script>
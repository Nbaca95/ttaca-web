---
// src/components/pages/services/HpeAuthorizedCenterPage.astro
import { getLocaleFromUrl, getTranslations } from "../../../i18n";

const locale = getLocaleFromUrl(Astro.url);
const t = getTranslations(locale);
const content = t.servicesPages.hpeAuthorizedCenter;
---

<main class="animate-fade-in">
    <section class="bg-gradient-to-r from-slate-900 to-blue-900 py-20 px-4 text-white">
        <div class="max-w-4xl mx-auto text-center">
            <span class="text-tyta-amber font-semibold tracking-wider uppercase text-sm">{content.hero.eyebrow}</span>
            <h1 class="text-5xl font-bold mb-6 mt-4">{content.hero.title}</h1>
            <p class="text-xl text-blue-100">{content.hero.text}</p>
        </div>
    </section>

    <section class="max-w-6xl mx-auto px-4 py-16">
        <div class="grid md:grid-cols-3 gap-8">
            {content.items.map((item) => (
                <div class="p-8 border border-slate-200 rounded-xl hover:shadow-2xl hover:border-tyta-amber transition-all duration-300 transform hover:-translate-y-2">
                    <h3 class="text-xl font-bold mb-4 text-slate-900">{item.title}</h3>
                    <p class="text-slate-600">{item.desc}</p>
                </div>
            ))}
        </div>
    </section>
</main>

<style>
    .animate-fade-in { animation: fadeIn 0.8s ease-in; }
    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
</style>
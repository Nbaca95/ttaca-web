---
// src/components/pages/services/HpeAuthorizedCenterPage.astro
import { Image } from "astro:assets";
import {
    getLocaleFromUrl,
    getTranslations,
    localizedPath,
} from "../../../i18n";

// Imágenes provisionales para las tarjetas y sub-secciones NOTA: poder usar la imagen SoporteHPE.png
import soporte from "../../../assets/images/soporte-hpe.jpg";
import hero1Img from "../../../assets/images/SoporteHPE1.png";
import instalacion from "../../../assets/images/Instalacion.png";
import alletra from "../../../assets/images/Alletra-Family-v1.webm";
import cinematic from "../../../assets/images/cinematic.webm";
import almacenamiento from "../../../assets/images/Almacenamiento.png";
import almace from "../../../assets/images/almace.png";
import almacena from "../../../assets/images/almacena.png";
import aduana from "../../../assets/images/aduana.png";
import distribucion from "../../../assets/images/distribucion.png";
import Synergy from "../../../assets/images/Synergy.png";
import simplivity from "../../../assets/images/Simplivity.png";
import servidores from "../../../assets/images/Proliant.png";

const locale = getLocaleFromUrl(Astro.url);
const t = getTranslations(locale);
const contactHref = localizedPath(locale, "/contact");

// Atajo para textos bilingües / traducciones
const L = (es: string, en: string) => (locale === "en" ? en : es);

// Tarjetas de navegación rápida superiores
const summaryCards = [
    {
        id: "area-soporte",
        image: soporte,
        imageAlt: L(
            "Soporte Técnico Autorizado HPE",
            "Certified HPE Technical Support",
        ),
        cardTitle: L("Soporte Técnico Autorizado", "Authorized Tech Support"),
        cardShort: L(
            "Atención de garantías, diagnósticos y mantenimiento para ProLiant, Synergy, Alletra y más.",
            "Warranty service, diagnostics, and maintenance for ProLiant, Synergy, Alletra, and more.",
        ),
    },
    {
        id: "area-instalacion",
        image: instalacion,
        imageAlt: L(
            "Instalación y Configuración de Servidores",
            "Server Installation & Configuration",
        ),
        cardTitle: L("Instalación de Servidores", "Server Installation"),
        cardShort: L(
            "Montaje físico, configuración RAID, actualización de firmware y pruebas de estrés.",
            "Physical mounting, RAID setup, firmware updates, and stress testing.",
        ),
    },
    {
        id: "area-respuestos",
        image: almace,
        imageAlt: L(
            "Servicios logísticos y almacenamiento",
            "Logistics and parts storage",
        ),
        cardTitle: L("Logística y Almacenamiento", "Logistics & Part Storage"),
        cardShort: L(
            "Bodegas propias con control de inventario 24/7, nacionalización y cobertura nacional.",
            "Proprietary warehouses with 24/7 stock control, customs clearance, and national coverage.",
        ),
    },
];

/* ------------------------------------------------------------------ */
/* 1. CATÁLOGO Y MODELOS DE SOPORTE HPE                                */
/* ------------------------------------------------------------------ */
const hpeSupportLines = [
    {
        title: L(
            "Servidores ProLiant (Rack / Torre)",
            "ProLiant Servers (Rack / Tower)",
        ),
        desc: L(
            "Mantenimiento correctivo/preventivo, reemplazo de fuentes, discos, placas madre y módulos de memoria en familias DL (Rack) y ML (Torre).",
            "Corrective/preventive maintenance, replacement of PSUs, drives, motherboards, and RAM in DL (Rack) and ML (Tower) families.",
        ),
        image: servidores,
        items: [
            L(
                "Reemplazo de partes en caliente (Hot-plug)",
                "Hot-plug parts replacement",
            ),
            L(
                "Actualización de iLO y ROM Firmware",
                "iLO & ROM Firmware updates",
            ),
            L(
                "Diagnósticos avanzados con Insight Diagnostics",
                "Advanced diagnostics via Insight Diagnostics",
            ),
        ],
    },
    {
        title: L(
            "Infraestructura Synergy",
            "Synergy Infrastructure",
        ),
        desc: L(
            "Soporte especializado a nivel de chasis, módulos de cómputo (Compute Modules), interconexiones de red y gestión con HPE OneView.",
            "Specialized support for chassis frames, compute modules, network interconnects, and HPE OneView management.",
        ),
        image: Synergy,
        items: [
            L(
                "Mantenimiento a nivel de Frame y Midplane",
                "Frame and Midplane maintenance",
            ),
            L(
                "Reemplazo de módulos de cómputo y FC Switches",
                "Compute modules & FC Switches replacement",
            ),
            L(
                "Verificación de perfiles de servidor OneView",
                "OneView server profile validation",
            ),
        ],
    },
    {
        title: L(
            "Almacenamiento Alletra & Primera",
            "Alletra & Primera Storage Arrays",
        ),
        desc: L(
            "Atención técnica para arreglos All-Flash y NVMe de misión crítica. Diagnóstico de controladoras, arreglos SSD y fuentes redundantes.",
            "Technical service for mission-critical All-Flash & NVMe arrays. Diagnosis of controllers, SSD enclosures, and redundant PSUs.",
        ),
        image: alletra,
        items: [
            L(
                "Mantenimiento de nodos y controladoras",
                "Node & controller maintenance",
            ),
            L(
                "Sustitución de unidades SSD sin interrupción",
                "Zero-downtime SSD drive replacement",
            ),
            L(
                "Análisis de salud con InfoSight AI",
                "Health analysis with InfoSight AI",
            ),
        ],
    },
    {
        title: L(
            "Sistemas Hiperconvergentes SimpliVity",
            "SimpliVity HCI Platforms",
        ),
        desc: L(
            "Soporte integral a la capa de hardware y aceleradores OmniStack para plataformas hiperconvergentes empresariales.",
            "End-to-end support for hardware layers and OmniStack accelerators in enterprise hyperconverged setups.",
        ),
        image: simplivity,
        items: [
            L(
                "Sustitución de aceleradores de tarjeta OmniStack",
                "OmniStack card replacement",
            ),
            L(
                "Mantenimiento de nodos de cómputo y almacenamiento",
                "Compute & storage node maintenance",
            ),
            L("Pruebas de salud del clúster HCI", "HCI cluster health testing"),
        ],
    },
    {
        title: L(
            "Almacenamiento MSA, Nimble & StoreEver",
            "MSA, Nimble & StoreEver Storage",
        ),
        desc: L(
            "Atención autorizada para cabezales SAN, expasiones de discos en caliente, librerías de cinta StoreEver y switches Fibre Channel.",
            "Authorized support for SAN controllers, hot expansion enclosures, StoreEver tape libraries, and Fibre Channel switches.",
        ),
        image: almacenamiento,
        items: [
            L(
                "Reemplazo de drives SAS/SATA y Robótica LTO",
                "SAS/SATA drive & LTO robotics replacement",
            ),
            L(
                "Mantenimiento de switches SAN Brocade/HPE",
                "Brocade/HPE SAN switch maintenance",
            ),
            L(
                "Reconfiguración de pools y LUNs de respaldo",
                "Pool & backup LUN re-configuration",
            ),
        ],
    },
];

/* ------------------------------------------------------------------ */
/* 2. SUB-ÁREAS DE INSTALACIÓN Y CONFIGURACIÓN                        */
/* ------------------------------------------------------------------ */
const installationPhases = [
    {
        step: "01",
        title: L(
            "Montaje Físico y Cableado Estructurado",
            "Physical Mounting & Cabling",
        ),
        desc: L(
            "Anclaje profesional en gabinete/rack, gestión térmica de flujo de aire, rotulación y canalización de cableado de red y energía redundante.",
            "Professional rack anchoring, thermal airflow management, labeling, and redundant power/network cable routing.",
        ),
        image: instalacion,
    },
    {
        step: "02",
        title: L(
            "Configuración Lógica y Arreglos RAID",
            "Logical Setup & RAID Configurations",
        ),
        desc: L(
            "Configuración de controladoras Smart Array / MR, creación de volúmenes LUN/RAID (1, 5, 6, 10), provisioning de almacenamiento e iLO.",
            "Smart Array / MR controller setup, LUN/RAID volume creation (1, 5, 6, 10), storage provisioning, and iLO management setup.",
        ),
        image: Synergy,
    },
    {
        step: "03",
        title: L(
            "Actualizaciones y Pruebas de Estrés",
            "Updates & Stress Validation",
        ),
        desc: L(
            "Flash de Service Pack for ProLiant (SPP), actualización de firmwares críticos de fábrica y ejecución de pruebas térmicas y de carga sintética.",
            "Flashing Service Pack for ProLiant (SPP), critical factory firmware updates, and synthetic load/thermal stress testing.",
        ),
        image: hero1Img,
    },
];

/* ------------------------------------------------------------------ */
/* 3. SUB-ÁREAS LOGÍSTICAS Y MANEJO DE PARTES                         */
/* ------------------------------------------------------------------ */
const logisticsSubAreas = [
    {
        title: L(
            "Bodegas Propias y Custodia 24/7",
            "Proprietary Warehousing & 24/7 Custody",
        ),
        desc: L(
            "Infraestructura segura con climatización controlada y control antiestático (ESD) para partes sensibles como placas madre, procesadores y tarjetas de red.",
            "Secure climate-controlled facilities with electrostatic discharge (ESD) protection for sensitive motherboards, CPUs, and NICs.",
        ),
        badge: "Control 24/7",
        image: almacena,
    },
    {
        title: L(
            "Nacionalización y Gestión Aduanera",
            "Customs Clearance & Import/Export",
        ),
        desc: L(
            "Trámite expedito de desaduanaje para el ingreso inmediato de componentes de repuesto críticos directo desde los centros de distribución regional de HPE.",
            "Expedited customs management for instant import of critical spare parts directly from HPE regional hubs.",
        ),
        badge: "Tránsito Exprés",
        image: aduana,
    },
    {
        title: L(
            "Distribución y Cobertura Nacional",
            "Nationwide Logistics & Delivery",
        ),
        desc: L(
            "Logística dedicada para la entrega e instalación en sitio de repuestos en cualquier punto del territorio nacional bajo compromisos de SLA contractuales.",
            "Dedicated logistics for on-site delivery and installation of spare parts anywhere nationwide under strict contractual SLAs.",
        ),
        badge: "Entrega en Sitio",
        image: distribucion,
    },
];
---

<style>
    html {
        scroll-behavior: smooth;
    }

    .reveal-on-scroll {
        opacity: 0;
        transform: translateY(30px);
        transition:
            opacity 0.8s ease-out,
            transform 0.8s ease-out;
    }

    .reveal-on-scroll.is-visible {
        opacity: 1;
        transform: translateY(0);
    }
</style>

<main class="bg-slate-50 overflow-hidden">
    <!-- Hero Section -->
    <section
        class="relative bg-gradient-to-br from-[#060b19] via-[#0b132b] to-[#00529B] py-24 px-4 text-white overflow-hidden"
    >
        <div
            class="absolute inset-0 bg-gradient-to-t from-[#060b19]/80 via-transparent to-transparent"
        >
        </div>

        <div
            class="relative max-w-5xl mx-auto text-center z-10 reveal-on-scroll"
        >
            <div class="inline-block mb-4">
                <span
                    class="bg-white/10 backdrop-blur-md border border-white/15 text-tyta-amber font-bold tracking-widest uppercase text-xs px-4 py-1.5 rounded-full shadow-lg"
                >
                    {L("Centro Autorizado HPE", "Authorized Center HPE")}
                </span>
            </div>
            <h1
                class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-white tracking-tight leading-tight mt-2 mb-6"
            >
                {
                    L(
                        "Servicios Especializados para Infraestructura HPE",
                        "Specialized Services for HPE Infrastructure",
                    )
                }
            </h1>
            <p
                class="text-lg sm:text-xl text-slate-300 max-w-3xl mx-auto font-normal leading-relaxed"
            >
                {
                    L(
                        "Garantizamos el máximo rendimiento y continuidad operativa de su centro de datos con soporte técnico oficial de fábrica, despliegue especializado de servidores y logística avanzada de repuestos.",
                        "We guarantee maximum uptime and performance for your data center with official factory technical support, specialized server deployment, and advanced spare parts logistics.",
                    )
                }
            </p>
        </div>

        <div
            class="absolute -bottom-10 left-1/2 -translate-x-1/2 w-3/4 h-20 bg-tyta-accent/20 blur-3xl pointer-events-none rounded-full"
        >
        </div>
    </section>

    <!-- Tarjetas de Navegación Rápida -->
    <section
        class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-12 relative z-20 mb-20 reveal-on-scroll"
    >
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {
                summaryCards.map((card) => (
                    <a
                        href={`#${card.id}`}
                        class="bg-white rounded-2xl shadow-xl shadow-slate-200/50 border border-slate-100 overflow-hidden hover:shadow-2xl hover:-translate-y-1.5 transition-all duration-300 group flex flex-col"
                    >
                        <div class="h-36 overflow-hidden relative">
                            <div class="absolute inset-0 bg-blue-950/20 group-hover:bg-blue-950/0 transition-colors z-10" />
                            <Image
                                src={card.image}
                                alt={card.cardTitle}
                                width={600}
                                height={360}
                                class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
                            />
                        </div>
                        <div class="p-5 flex-1 flex flex-col justify-between gap-4">
                            <div>
                                <h3 class="font-bold text-slate-900 text-base mb-1 group-hover:text-tyta-amber transition-colors duration-300">
                                    {card.cardTitle}
                                </h3>
                                <p class="text-xs text-slate-500 leading-relaxed">
                                    {card.cardShort}
                                </p>
                            </div>
                            <span class="inline-flex items-center gap-1.5 text-xs font-bold text-tyta-amber opacity-0 -translate-y-1 group-hover:opacity-100 group-hover:translate-y-0 group-hover:gap-2.5 transition-all duration-300">
                                {L("Ver detalle", "See details")}
                                <svg
                                    class="w-3.5 h-3.5"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2.5"
                                        d="M14 5l7 7m0 0l-7 7m7-7H3"
                                    />
                                </svg>
                            </span>
                        </div>
                    </a>
                ))
            }
        </div>
    </section>

    <!-- ==================================================================== -->
    <!-- 1. SOPORTE TÉCNICO AUTORIZADO HPE (BANNER INMERSIVO CON VIDEO)       -->
    <!-- ==================================================================== -->
    <section
        id="area-soporte"
        class="w-full p-0 border-b border-slate-200/60 scroll-mt-24 reveal-on-scroll"
    >
        <div class="space-y-12">
            <!-- Banner Inmersivo de Fondo con Video y Texto Sobrepuesto -->
            <div
                class="relative w-full min-h-[680px] sm:min-h-[600px] lg:min-h-[560px] overflow-hidden flex items-center"
            >
                <!-- Video de Fondo Principal (.webm) -->
                <video
                    src={cinematic}
                    autoplay
                    loop
                    muted
                    playsinline
                    class="absolute inset-0 w-full h-full object-cover object-[center_top] md:object-[center_10%]"
                ></video>

                <!-- Overlay de Degradado Oscuro -->
                <div
                    class="absolute inset-0 bg-gradient-to-r from-slate-950/95 via-slate-950/80 to-slate-950/30"
                >
                </div>

                <!-- Contenido sobrepuesto -->
                <div
                    class="relative z-10 w-full px-6 py-16 sm:px-10 sm:py-16 lg:px-16 lg:py-20 max-w-5xl space-y-6 text-white"
                >
                    <!-- Etiqueta -->
                    <div
                        class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-md text-tyta-amber px-3.5 py-1.5 rounded-full text-xs font-extrabold tracking-widest uppercase border border-white/15 shadow-md"
                    >
                        {L("Excelencia Autorizada", "Authorized Excellence")}
                    </div>

                    <!-- Título -->
                    <h2
                        class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight leading-tight text-white drop-shadow-sm"
                    >
                        {
                            L(
                                "Soporte Técnico Autorizado HPE",
                                "Certified HPE Technical Support",
                            )
                        }
                    </h2>

                    <!-- Descripción -->
                    <p
                        class="text-slate-200 text-sm sm:text-base lg:text-lg leading-relaxed font-normal max-w-3xl"
                    >
                        {
                            L(
                                "Como Centro de Servicio Autorizado oficial de Hewlett Packard Enterprise, brindamos atención técnica especializada, diagnósticos originales, sustitución de partes de fábrica y resolución de garantías directas para todo el ecosistema de servidores y almacenamiento empresarial.",
                                "As an official Hewlett Packard Enterprise Authorized Service Center, we deliver specialized technical care, genuine factory diagnostics, original spare parts replacement, and direct warranty handling across the full enterprise server and storage lineup.",
                            )
                        }
                    </p>

                    <!-- Lista rápida de Garantías -->
                    <div
                        class="pt-2 grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs font-semibold text-slate-200"
                    >
                        <div
                            class="flex items-center gap-2 bg-white/10 backdrop-blur-sm px-3 py-2 rounded-xl border border-white/10"
                        >
                            <span
                                class="w-2 h-2 rounded-full bg-tyta-amber shrink-0"
                            ></span>
                            {L("Garantías Oficiales HPE", "Official HPE Warranties")}
                        </div>

                        <div
                            class="flex items-center gap-2 bg-white/10 backdrop-blur-sm px-3 py-2 rounded-xl border border-white/10"
                        >
                            <span
                                class="w-2 h-2 rounded-full bg-tyta-amber shrink-0"
                            ></span>
                            {L("Ingenieros Certificados", "Certified Engineers")}
                        </div>

                        <div
                            class="flex items-center gap-2 bg-white/10 backdrop-blur-sm px-3 py-2 rounded-xl border border-white/10"
                        >
                            <span
                                class="w-2 h-2 rounded-full bg-tyta-amber shrink-0"
                            ></span>
                            {
                                L(
                                    "Diagnosticos y mantenimientos",
                                    "Diagnostics and Maintenance",
                                )
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sub-sección: Tarjetas en Cuadrícula (Estilo Fases de Implementación) -->
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-12 space-y-6">
                <h3
                    class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-6"
                >
                    {
                        L(
                            "Modelos y Plataformas Soportadas",
                            "Supported HPE Lines & Models",
                        )
                    }
                </h3>

                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                    {
                        hpeSupportLines.map((line) => (
                            <div class="bg-white rounded-3xl border border-slate-200 shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden flex flex-col group">
                                {/* Imagen superior de la tarjeta */}
                                <div class="relative h-48 overflow-hidden bg-slate-100">
                                    {typeof line.image === "string" ? (
                                        <video
                                            src={line.image}
                                            autoplay
                                            loop
                                            muted
                                            playsinline
                                            class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                                        />
                                    ) : (
                                        <Image
                                            src={line.image}
                                            alt={line.title}
                                            width={600}
                                            height={360}
                                            class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
                                        />
                                    )}
                                    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-transparent to-transparent" />
                                    <h4 class="absolute bottom-4 left-4 right-4 font-extrabold text-white text-lg tracking-tight drop-shadow-md">
                                        {line.title}
                                    </h4>
                                </div>

                                {/* Contenido de la tarjeta */}
                                <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
                                    <p class="text-xs text-slate-600 leading-relaxed">
                                        {line.desc}
                                    </p>

                                    <div class="pt-3 border-t border-slate-100">
                                        <ul class="space-y-2">
                                            {line.items.map((item) => (
                                                <li class="flex items-center gap-2 text-xs text-slate-700 font-medium">
                                                    <span class="w-1.5 h-1.5 rounded-full bg-blue-600 shrink-0" />
                                                    {item}
                                                </li>
                                            ))}
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </section>

    <!-- ==================================================================== -->
    <!-- 2. INSTALACIÓN Y CONFIGURACIÓN DE SERVIDORES (BANNER INMERSIVO)      -->
    <!-- ==================================================================== -->
    <section
        id="area-instalacion"
        class="w-full p-0 border-b border-slate-200/60 scroll-mt-24 reveal-on-scroll"
    >
        <div class="space-y-12">
            <!-- Banner Inmersivo de Fondo con Texto Sobrepuesto -->
            <div
                class="relative w-full min-h-[680px] sm:min-h-[600px] lg:min-h-[560px] overflow-hidden flex items-center"
            >
                <!-- Imagen de Fondo Principal -->
                <Image
                    src={hero1Img}
                    alt={L(
                        "Instalación y Configuración de Servidores",
                        "Server Installation & Configuration",
                    )}
                    width={1600}
                    height={800}
                    class="absolute inset-0 w-full h-full object-cover object-[center_top] md:object-[center_10%]"
                />

                <!-- Overlay de Degradado Oscuro -->
                <div
                    class="absolute inset-0 bg-gradient-to-r from-slate-950/95 via-slate-950/80 to-slate-950/30"
                >
                </div>

                <!-- Contenido sobrepuesto -->
                <div
                    class="relative z-10 w-full px-6 py-16 sm:px-10 sm:py-16 lg:px-16 lg:py-20 max-w-5xl space-y-6 text-white"
                >
                    <!-- Etiqueta -->
                    <div
                        class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-md text-emerald-400 px-3.5 py-1.5 rounded-full text-xs font-extrabold tracking-widest uppercase border border-white/15 shadow-md"
                    >
                        {L("Despliegue Profesional", "Professional Deployment")}
                    </div>

                    <!-- Título -->
                    <h2
                        class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight leading-tight text-white drop-shadow-sm"
                    >
                        {
                            L(
                                "Instalación de Servidores",
                                "Server Installation",
                            )
                        }
                    </h2>

                    <!-- Descripción -->
                    <p
                        class="text-slate-200 text-sm sm:text-base lg:text-lg leading-relaxed font-normal max-w-3xl"
                    >
                        {
                            L(
                                "Asegure un despliegue sin fallas de sus nuevos servidores e infraestructura de centro de datos. Ejecutamos protocolos rigurosos que abarcan desde el montaje físico hasta el tuning lógico de rendimiento.",
                                "Ensure a flawless rollout of your new servers and data center gear. We execute rigorous protocols spanning from physical mounting to logical performance tuning.",
                            )
                        }
                    </p>

                    <!-- Lista rápida de Fases/Garantías -->
                    <div
                        class="pt-2 grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs font-semibold text-slate-200"
                    >
                        <div
                            class="flex items-center gap-2 bg-white/10 backdrop-blur-sm px-3 py-2 rounded-xl border border-white/10"
                        >
                            <span
                                class="w-2 h-2 rounded-full bg-emerald-400 shrink-0"
                            ></span>
                            {L("Montaje y Cableado", "Mounting & Cabling")}
                        </div>

                        <div
                            class="flex items-center gap-2 bg-white/10 backdrop-blur-sm px-3 py-2 rounded-xl border border-white/10"
                        >
                            <span
                                class="w-2 h-2 rounded-full bg-emerald-400 shrink-0"
                            ></span>
                            {L("Configuración RAID", "RAID Configuration")}

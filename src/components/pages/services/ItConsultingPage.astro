            { 
                title: L('Evaluación y Optimización', 'Assessment & Optimization'), 
                desc: L('Auditorías profundas de arquitectura, análisis de cuellos de botella y ajuste de rendimiento operativo.', 'Deep architecture audits, bottleneck analysis, and operational performance tuning.') 
            },
            { 

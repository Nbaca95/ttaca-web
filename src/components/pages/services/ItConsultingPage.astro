---

<style>
    html {
        scroll-behavior: smooth;
    }

    .reveal-on-scroll {
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.8s ease-out, transform 0.8s ease-out;
    }

    .reveal-on-scroll.is-visible {
        opacity: 1;
        transform: translateY(0);
    }
</style>

<main class="bg-slate-50 overflow-hidden">
    <!-- Hero Section -->
    <section class="relative bg-gradient-to-br from-[#060b19] via-[#0b132b] to-[#00529B] py-24 px-4 text-white overflow-hidden">
        <div class="absolute inset-0 bg-[url('/assets/content.png')] opacity-10 bg-repeat bg-[length:400px]"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-[#060b19]/80 via-transparent to-transparent"></div>

        <div class="relative max-w-4xl mx-auto text-center z-10 reveal-on-scroll">
            <div class="inline-block mb-4">
                <span class="bg-white/10 backdrop-blur-md border border-white/15 text-tyta-amber font-bold tracking-widest uppercase text-xs px-4 py-1.5 rounded-full shadow-lg">
                    {L('Consultoría y Actualización Tecnológica', 'Enterprise Technology Consulting')}
                </span>
            </div>
            <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-white tracking-tight leading-tight mt-2 mb-6">
                {content.title}
            </h1>
            <p class="text-lg sm:text-xl text-slate-300 max-w-3xl mx-auto font-normal leading-relaxed">
                {L(
                    'En T&TA de Centroamérica ofrecemos servicios de consultoría en TI, especializados en infraestructura y actualización tecnológica, con soluciones de alto impacto.',
                    'At T&TA de Centroamérica, we provide IT consulting services specializing in infrastructure and technology upgrades, delivering high-impact solutions.'
                )}
            </p>
        </div>
        <div class="absolute -bottom-10 left-1/2 -translate-x-1/2 w-3/4 h-20 bg-tyta-amber/15 blur-3xl pointer-events-none rounded-full"></div>
    </section>

    <!-- ==================================================================== -->
    <!-- SECCIÓN DE CONSULTORÍA ESPECIALIZADA (DISEÑO LIMPIO Y POR PILARES)   -->
    <!-- ==================================================================== -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 scroll-mt-24 reveal-on-scroll">
        <!-- Cabecera de la sección -->
        <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
            <span class="inline-flex items-center gap-2 bg-blue-500/10 text-tyta-blue px-3.5 py-1.5 rounded-full text-xs font-extrabold tracking-widest uppercase border border-blue-500/20">
                {L('Expertise Integral', 'Comprehensive Expertise')}
            </span>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
                {L('Áreas Clave de Consultoría y Arquitectura', 'Core Consulting & Architecture Areas')}
            </h2>
            <p class="text-slate-600 text-base leading-relaxed">
                {L(
                    'Estructuramos nuestro acompañamiento técnico en pilares estratégicos para garantizar que cada componente de su infraestructura evolucione con orden, seguridad y alto rendimiento.',
                    'We structure our technical guidance into strategic pillars to ensure every component of your infrastructure evolves with order, security, and high performance.'
                )}
            </p>
        </div>

        <!-- Pilares y Tarjetas organizadas -->
        <div class="space-y-16">
            {consultingPillars.map((pillar) => (
                <div class="bg-white rounded-3xl p-8 sm:p-10 shadow-lg border border-slate-200/80 space-y-8">
                    <!-- Título del pilar -->
                    <div class={`pl-4 ${pillar.themeBorder} space-y-1`}>
                        <h3 class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight">
                            {pillar.category}
                        </h3>
                        <p class="text-xs sm:text-sm text-slate-500">
                            {pillar.desc}
                        </p>
                    </div>

                    <!-- Cuadrícula de servicios del pilar -->
                    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
                        {pillar.items.map((item) => (
                            <div class="bg-slate-50/70 p-6 rounded-2xl border border-slate-200/60 hover:bg-white hover:border-tyta-blue/40 hover:shadow-md transition-all duration-300 flex flex-col justify-between group">
                                <div>
                                    <h4 class="font-extrabold text-slate-900 text-sm mb-2 group-hover:text-tyta-blue transition-colors">
                                        {item.title}
                                    </h4>
                                    <p class="text-xs text-slate-600 leading-relaxed">
                                        {item.desc}
                                    </p>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            ))}
        </div>

        <!-- Subsección informativa adicional: Metodología de Trabajo -->
        <div class="mt-16 bg-slate-900 text-white rounded-3xl p-8 sm:p-12 shadow-xl border border-slate-800 relative overflow-hidden">
            <div class="absolute top-0 right-0 w-80 h-80 bg-tyta-amber/10 rounded-full blur-3xl pointer-events-none"></div>
            <div class="relative z-10 grid lg:grid-cols-12 gap-8 items-center">
                <div class="lg:col-span-7 space-y-4">
                    <span class="text-tyta-amber font-black text-xs uppercase tracking-widest">
                        {L('Metodología de Trabajo', 'Work Methodology')}
                    </span>
                    <h3 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
                        {methodologyInfo.title}
                    </h3>
                    <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
                        {methodologyInfo.description}
                    </p>
                </div>
                <div class="lg:col-span-5">
                    <ul class="space-y-3 border-t lg:border-t-0 lg:border-l border-slate-800 pt-6 lg:pt-0 lg:pl-8">
                        {methodologyInfo.items.map((item) => (
                            <li class="flex items-center gap-3 text-xs sm:text-sm text-slate-200 font-medium">
                                <span class="w-2 h-2 rounded-full bg-tyta-amber shrink-0"></span>
                                {item}
                            </li>
                        ))}
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- Fondo Azul: Ingenieros Certificados y Marcas -->
    <section class="bg-gradient-to-br from-slate-900 via-blue-950 to-slate-900 text-white py-24 px-4 sm:px-6 lg:px-8 relative overflow-hidden reveal-on-scroll">
        <div class="absolute inset-0 bg-[url('/assets/content.png')] opacity-10 bg-repeat bg-[length:300px]"></div>
        
        <div class="max-w-7xl mx-auto relative z-10">
            <div class="text-center max-w-2xl mx-auto mb-16">
                <span class="text-tyta-amber font-bold tracking-widest uppercase text-xs">
                    {L('Ingenieros Certificados', 'Certified Engineers')}
                </span>
                <h2 class="text-3xl sm:text-4xl font-extrabold text-white mt-2 mb-4 tracking-tight">

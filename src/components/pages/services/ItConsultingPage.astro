            },
            { 
                title: L('Servidores, Cómputo e Hiperconvergencia', 'Servers, Compute & Hyperconvergence'), 
                desc: L('Dimensionamiento de hardware de alta densidad e integración de cómputo, almacenamiento y seguridad por software.', 'High-density hardware sizing and software-defined integration of compute, storage, and security.') 
            }
        ]
    },
    {
        category: L('Conectividad, Redes y Ciberseguridad', 'Connectivity, Networks & Cybersecurity'),
        desc: L('Redes corporativas robustas y protección perimetral avanzada.', 'Robust corporate networks and advanced perimeter protection.'),
        themeBorder: 'border-l-4 border-slate-900',
        items: [
            { 
                title: L('Redes y Movilidad', 'Networks & Mobility'), 
                desc: L('Soluciones de conectividad robustas, segmentación lógica segura y acceso remoto confiable para empresas.', 'Robust connectivity solutions, secure logical segmentation, and reliable enterprise remote access.') 

    </section>

    <!-- Certificaciones Oficiales y Alianzas -->
    <section class="py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto reveal-on-scroll">
        <div class="text-center max-w-2xl mx-auto mb-16">
            <span class="text-tyta-amber font-bold tracking-widest uppercase text-xs">
                {L('Insignias y Alianzas Oficiales', 'Official Badges & Partnerships')}
            </span>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mt-2 mb-4">
                {L('Nuestras Acreditaciones y Certificaciones', 'Our Accreditations & Certifications')}
            </h2>
            <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
                {L(
                    'Avales de líderes tecnológicos globales que garantizan los más altos estándares de ejecución para los proyectos de su empresa.',
                    'Endorsements from world-class technology leaders guaranteeing the highest execution standards for your business projects.'
                )}
            </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {certifications.map((cert) => (
                <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-xl hover:border-tyta-blue/40 transition-all duration-300 flex flex-col items-center text-center group">
                    <!-- Espacio reservado para cargar la imagen/insignia oficial de la certificación -->
                    <div class="w-full h-32 bg-slate-100 rounded-xl border-2 border-dashed border-slate-300 flex flex-col items-center justify-center mb-5 group-hover:bg-blue-50/50 group-hover:border-tyta-blue/50 transition-colors">
                        <svg class="w-8 h-8 text-slate-400 mb-1 group-hover:text-tyta-blue transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                        </svg>
                        <span class="text-[11px] font-medium text-slate-400 group-hover:text-tyta-blue">
                            {L('Cargar insignia oficial', 'Upload Badge Image')}

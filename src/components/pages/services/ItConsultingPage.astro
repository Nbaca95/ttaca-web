            </div>

            <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-6">
                {brands.map((brand) => (
                    <a
                        href={localizedPath(locale, `/services/${brand.slug}`)}
                        class="group bg-white/5 backdrop-blur-md p-7 rounded-2xl border border-white/10 hover:border-tyta-amber hover:bg-white/10 hover:scale-105 transition-all duration-300 flex flex-col justify-between shadow-lg"
                    >
                        <div>
                            <span class="block text-lg font-extrabold text-white group-hover:text-tyta-amber transition-colors mb-2">
                                {t.services[brand.key]}
                            </span>
                            <p class="text-xs text-slate-300 leading-relaxed">
                                {locale === 'en' ? brand.descEn : brand.descEs}
                            </p>
                        </div>
                        <div class="mt-6 opacity-0 group-hover:opacity-100 transition-opacity duration-300 inline-flex items-center text-xs font-bold text-tyta-amber">
                            {L('Explorar solución →', 'Explore solution →')}

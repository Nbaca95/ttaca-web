        themeBorder: 'border-l-4 border-blue-600',
        items: [
            { 
                title: L('Gestión de TI', 'IT Management'), 
                desc: L('Gobierno estratégico, alineación operativa tecnológica y definición de políticas de servicio corporativo.', 'Strategic governance, operational alignment, and corporate service policy definition.') 

            }
        ]
    },
    {
        category: L('Infraestructura, Cómputo y Resiliencia', 'Infrastructure, Compute & Resilience'),
        desc: L('Alta disponibilidad, almacenamiento avanzado y continuidad de negocio.', 'High availability, advanced storage, and business continuity.'),
        themeBorder: 'border-l-4 border-tyta-amber',
        items: [
            { 
                title: L('Virtualización, Aplicaciones y Protección', 'Virtualization & Protection'), 
                desc: L('Entornos virtualizados seguros, consolidación inteligente de cargas y alta disponibilidad de aplicaciones.', 'Secure virtualized environments, smart workload consolidation, and application high availability.') 
            },
            { 
                title: L('Almacenamiento de Datos', 'Data Storage'), 
                desc: L('Diseño e implementación de arreglos de almacenamiento escalables, de ultra bajo tiempo de respuesta y alta capacidad.', 'Design and implementation of scalable, low-latency, high-capacity storage arrays.') 
            },
            { 

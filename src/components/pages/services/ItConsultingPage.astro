    </section>

    <!-- CTA Final -->
    <section class="bg-white py-20 px-4 border-t border-slate-200/60 reveal-on-scroll">
        <div class="max-w-4xl mx-auto text-center">
            <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mb-4 tracking-tight">
                {L('¿Listo para llevar su infraestructura de TI al siguiente nivel?', 'Ready to elevate your IT infrastructure?')}
            </h2>
            <p class="text-slate-600 mb-8 max-w-2xl mx-auto text-base sm:text-lg">
                {L(
                    'Póngase en contacto con nuestro equipo de especialistas certificados para diseñar una estrategia a la medida de su empresa.',

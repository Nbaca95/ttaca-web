};

const certifications = [
    {
        name: 'Hewlett Packard Enterprise (HPE)',
        category: L('Socio de Infraestructura Empresarial', 'Enterprise Infrastructure Partner'),
        badgeId: 'hpe'
    },
    {
        name: 'VMware Certified Professional',

                        <div class="w-14 h-14 bg-slate-900 text-tyta-amber rounded-2xl flex items-center justify-center font-bold text-xl mb-6 group-hover:bg-tyta-amber group-hover:text-slate-950 transition-all duration-300 shadow-md group-hover:rotate-6">
                            0{index + 1}

                <h3 class="text-2xl md:text-3xl font-bold mb-4 text-white tracking-tight">{content.cardTitle}</h3>
                <p class="text-slate-300 leading-relaxed mb-8 text-base font-light">{content.cardText}</p>
                <div>
                    <a
                        href={contactHref}
                        class="inline-flex items-center justify-center w-full sm:w-auto bg-tyta-amber text-slate-950 px-8 py-4 rounded-xl font-bold hover:bg-amber-400 transition-all shadow-xl shadow-amber-500/20 transform hover:-translate-y-0.5"
                    >
                        {content.ctaLabel}
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Banner Inferior -->
    <section class="bg-gradient-to-r from-slate-900 via-slate-950 to-blue-950 text-white rounded-[2rem] p-8 md:p-14 text-center shadow-2xl relative overflow-hidden border border-slate-800">
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-blue-900/20 via-transparent to-transparent pointer-events-none"></div>
        <div class="relative z-10 max-w-3xl mx-auto space-y-6">
            <h3 class="text-2xl md:text-3xl font-extrabold tracking-tight">
                {isEn ? "Architected for Absolute Reliability" : "Infraestructura Tecnológica de Alta Confiabilidad"}
            </h3>
            <p class="text-slate-300 text-base md:text-lg leading-relaxed font-light">
                {isEn 
                    ? "Integrate high-end infrastructure solutions tailored to your operational environment, backed by expert deployment and authorized local support." 
                    : "Integre soluciones de infraestructura de alta gama adaptadas a su entorno operativo, respaldadas por despliegue experto y soporte local autorizado en T&TA de Centroamérica."
                }
            </p>
            <div class="pt-2">
                <a
                    href={contactHref}
                    class="inline-flex items-center gap-2 bg-white text-slate-950 px-8 py-4 rounded-xl font-bold hover:bg-slate-100 transition-all shadow-lg hover:shadow-white/10"
                >
                    {isEn ? "Consult an Engineer" : "Consultar con un Ingeniero T&TA"} →

                        <h3 class="text-xl font-bold text-slate-900 mb-3 tracking-tight group-hover:text-blue-600 transition-colors">{sol.title}</h3>
                        <p class="text-slate-600 text-sm leading-relaxed">{sol.desc}</p>
                    </div>
                    <div class="pt-6 mt-6 border-t border-slate-100 flex items-center text-xs font-semibold text-slate-400 group-hover:text-blue-600 transition-colors">
                        <span>{isEn ? "Enterprise Spec" : "Especificación Enterprise"}</span>
                        <span class="ml-auto transform transition-transform duration-300 group-hover:translate-x-1">→</span>
                    </div>
                </div>
            ))}
        </div>
    </section>

    <!-- Sección de Beneficios y CTA -->
    <section class="grid lg:grid-cols-12 gap-12 items-center pt-6">
        <div class="lg:col-span-6 space-y-6">
            <h2 class="text-3xl font-extrabold text-slate-900 tracking-tight">{content.whyTitle}</h2>

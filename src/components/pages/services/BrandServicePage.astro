---
// src/components/pages/services/BrandServicePage.astro
import { getLocaleFromUrl, getTranslations, localizedPath } from "../../../i18n";

type BrandKey = 'veeam' | 'arubaNetworks' | 'vmware' | 'dell' | 'lenovo';

interface Props {
    brand: BrandKey;
}

const { brand } = Astro.props;

const locale = getLocaleFromUrl(Astro.url);
const t = getTranslations(locale);
const brandName = t.services[brand];
const content = t.servicesPages.brands[brand];
const contactHref = localizedPath(locale, "/contact");
---

<main class="animate-fade-in py-16 px-4">
    <!-- Hero Section -->
    <section class="bg-gradient-to-r from-slate-900 to-blue-900 py-20 px-4 text-white rounded-2xl">
        <h1 class="text-4xl text-center md:text-5xl font-bold text-white mb-6">{brandName}</h1>
        <div class="w-24 h-1 bg-tyta-amber mx-auto mb-6"></div>
        <p class="text-xl text-center text-slate-200 max-w-3xl mx-auto">
            {content.tagline}
        </p>
    </section>

    <!-- Detalles del Servicio -->
    <section class="max-w-6xl mx-auto grid md:grid-cols-2 gap-12 items-center mt-16">
        <div class="space-y-6">
            <h2 class="text-3xl font-bold text-slate-900">{content.whyTitle}</h2>
            <p class="text-slate-600 leading-relaxed">{content.whyText}</p>
            <ul class="space-y-3">
                {content.benefits.map((item) => (
                    <li class="flex items-center gap-3">
                        <span class="text-tyta-amber text-lg">●</span> {item}
                    </li>
                ))}
            </ul>
        </div>

        <!-- Tarjeta dinámica -->
        <div class="bg-slate-900 p-8 rounded-2xl text-white transform transition-all duration-500 hover:scale-[1.02] hover:shadow-xl">
            <h3 class="text-2xl font-bold mb-4 text-tyta-amber">{content.cardTitle}</h3>
            <p class="text-slate-300">{content.cardText}</p>
            <div class="mt-8">
                <a
                    href={contactHref}
                    class="inline-block bg-white text-slate-900 px-6 py-2 rounded font-bold hover:bg-tyta-amber transition-colors"
                >
                    {content.ctaLabel}
                </a>
            </div>
        </div>
    </section>
</main>

<style>
    .animate-fade-in { animation: fadeIn 0.8s ease-out; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
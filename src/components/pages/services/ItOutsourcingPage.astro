---
// src/components/pages/services/ItOutsourcingPage.astro
import { getLocaleFromUrl, localizedPath } from "../../../i18n";

const locale = getLocaleFromUrl(Astro.url);
const contactHref = localizedPath(locale, "/contact");
---

<style>
    /* Asegura el desplazamiento suave en toda la página */
    html {
        scroll-behavior: smooth;
    }
</style>

<main class="bg-slate-50 overflow-hidden">
    <!-- Hero Section con estilo corporativo inmersivo -->
    <section class="relative bg-gradient-to-br from-[#060b19] via-[#0b132b] to-[#00529B] py-24 px-4 text-white overflow-hidden">
        <div class="absolute inset-0 bg-[url('/assets/content.png')] opacity-10 bg-repeat bg-[length:400px]"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-[#060b19]/80 via-transparent to-transparent"></div>

        <div class="relative max-w-5xl mx-auto text-center z-10">
            <div class="inline-block mb-4">
                <span class="bg-white/10 backdrop-blur-md border border-white/15 text-tyta-amber font-bold tracking-widest uppercase text-xs px-4 py-1.5 rounded-full shadow-lg">
                    {locale === 'en' ? 'Business Process & IT Outsourcing' : 'Outsourcing de Procesos y TI'}
                </span>
            </div>
            <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-white tracking-tight leading-tight mt-2 mb-6">
                {locale === 'en' ? 'Strategic Outsourcing & Specialized Talent' : 'Outsourcing Estratégico y Talento Especializado'}
            </h1>
            <p class="text-lg sm:text-xl text-slate-300 max-w-3xl mx-auto font-normal leading-relaxed">
                {locale === 'en' 
                    ? 'Managing and executing your daily business functions with a specialized focus on IT, finance, HR, marketing, and accounting.'
                    : 'Gestionamos y ejecutamos las funciones empresariales diarias con un enfoque especializado en el área de TI, finanzas, RRHH, marketing y contabilidad.'}
            </p>
        </div>

        <div class="absolute -bottom-10 left-1/2 -translate-x-1/2 w-3/4 h-20 bg-tyta-accent/20 blur-3xl pointer-events-none rounded-full"></div>
    </section>

    <!-- 5 Tarjetas de Áreas de Especialización (Resumen superior) -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-12 relative z-20 mb-20">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-5">
            
            <!-- TI -->
            <a href="#area-ti" class="bg-white rounded-2xl shadow-xl shadow-slate-200/50 border border-slate-100 overflow-hidden hover:shadow-2xl hover:-translate-y-1.5 transition-all duration-300 group flex flex-col">
                <div class="h-36 overflow-hidden relative">
                    <div class="absolute inset-0 bg-blue-950/20 group-hover:bg-blue-950/0 transition-colors z-10"></div>
                    <img src="https://images.unsplash.com/photo-1558494949-ef010cbdcc31?auto=format&fit=crop&w=600&q=80" alt="Tecnología e Infraestructura TI" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                    <span class="absolute top-2.5 left-2.5 z-20 bg-white/90 backdrop-blur-sm text-tyta-blue font-bold text-[11px] px-2 py-0.5 rounded-md shadow-sm">💻 TI</span>
                </div>
                <div class="p-5 flex-1 flex flex-col justify-between">
                    <div>
                        <h3 class="font-bold text-slate-900 text-base mb-1">{locale === 'en' ? 'Information Technology' : 'Tecnología (TI)'}</h3>
                        <p class="text-xs text-slate-500 leading-relaxed">{locale === 'en' ? 'Infrastructure, support, and specialized tech roles.' : 'Infraestructura, soporte y perfiles tecnológicos clave.'}</p>
                    </div>
                </div>
            </a>

            <!-- Finanzas -->
            <a href="#area-finanzas" class="bg-white rounded-2xl shadow-xl shadow-slate-200/50 border border-slate-100 overflow-hidden hover:shadow-2xl hover:-translate-y-1.5 transition-all duration-300 group flex flex-col">
                <div class="h-36 overflow-hidden relative">
                    <div class="absolute inset-0 bg-blue-950/20 group-hover:bg-blue-950/0 transition-colors z-10"></div>
                    <img src="https://images.unsplash.com/photo-1590283603385-17ffb3a7f29f?auto=format&fit=crop&w=600&q=80" alt="Finanzas y Contabilidad" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                    <span class="absolute top-2.5 left-2.5 z-20 bg-white/90 backdrop-blur-sm text-emerald-700 font-bold text-[11px] px-2 py-0.5 rounded-md shadow-sm">📊 Finanzas</span>
                </div>
                <div class="p-5 flex-1 flex flex-col justify-between">
                    <div>
                        <h3 class="font-bold text-slate-900 text-base mb-1">{locale === 'en' ? 'Finance & Accounting' : 'Finanzas y Contabilidad'}</h3>
                        <p class="text-xs text-slate-500 leading-relaxed">{locale === 'en' ? 'Control, audits, and daily financial operations.' : 'Control, gestión contable y operaciones financieras.'}</p>
                    </div>
                </div>
            </a>

            <!-- RRHH -->
            <a href="#area-rrhh" class="bg-white rounded-2xl shadow-xl shadow-slate-200/50 border border-slate-100 overflow-hidden hover:shadow-2xl hover:-translate-y-1.5 transition-all duration-300 group flex flex-col">
                <div class="h-36 overflow-hidden relative">
                    <div class="absolute inset-0 bg-blue-950/20 group-hover:bg-blue-950/0 transition-colors z-10"></div>
                    <img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=600&q=80" alt="Recursos Humanos y Reclutamiento" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                    <span class="absolute top-2.5 left-2.5 z-20 bg-white/90 backdrop-blur-sm text-purple-700 font-bold text-[11px] px-2 py-0.5 rounded-md shadow-sm">👥 RRHH</span>
                </div>
                <div class="p-5 flex-1 flex flex-col justify-between">
                    <div>
                        <h3 class="font-bold text-slate-900 text-base mb-1">{locale === 'en' ? 'Human Resources' : 'Recursos Humanos'}</h3>
                        <p class="text-xs text-slate-500 leading-relaxed">{locale === 'en' ? 'Talent acquisition, welfare, and labor legislation.' : 'Reclutamiento, gestión de personal y normativa.'}</p>
                    </div>
                </div>
            </a>

            <!-- Marketing -->
            <a href="#area-marketing" class="bg-white rounded-2xl shadow-xl shadow-slate-200/50 border border-slate-100 overflow-hidden hover:shadow-2xl hover:-translate-y-1.5 transition-all duration-300 group flex flex-col">
                <div class="h-36 overflow-hidden relative">
                    <div class="absolute inset-0 bg-blue-950/20 group-hover:bg-blue-950/0 transition-colors z-10"></div>
                    <img src="https://images.unsplash.com/photo-1557804506-669a67965ba0?auto=format&fit=crop&w=600&q=80" alt="Marketing y Estrategia" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                    <span class="absolute top-2.5 left-2.5 z-20 bg-white/90 backdrop-blur-sm text-amber-700 font-bold text-[11px] px-2 py-0.5 rounded-md shadow-sm">📢 Marketing</span>
                </div>
                <div class="p-5 flex-1 flex flex-col justify-between">
                    <div>
                        <h3 class="font-bold text-slate-900 text-base mb-1">{locale === 'en' ? 'Marketing' : 'Marketing'}</h3>
                        <p class="text-xs text-slate-500 leading-relaxed">{locale === 'en' ? 'Brand positioning, campaigns, and strategies.' : 'Estrategias comerciales, campañas y posicionamiento.'}</p>
                    </div>
                </div>
            </a>

            <!-- Gestión de Talento (Nueva Tarjeta 5) -->
            <a href="#area-gestion" class="bg-white rounded-2xl shadow-xl shadow-slate-200/50 border border-slate-100 overflow-hidden hover:shadow-2xl hover:-translate-y-1.5 transition-all duration-300 group flex flex-col sm:col-span-2 lg:col-span-1">
                <div class="h-36 overflow-hidden relative">
                    <div class="absolute inset-0 bg-blue-950/20 group-hover:bg-blue-950/0 transition-colors z-10"></div>
                    <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=600&q=80" alt="Gestión Integral de Talento" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                    <span class="absolute top-2.5 left-2.5 z-20 bg-white/90 backdrop-blur-sm text-tyta-amber font-bold text-[11px] px-2 py-0.5 rounded-md shadow-sm">⭐ Gestión</span>
                </div>
                <div class="p-5 flex-1 flex flex-col justify-between">
                    <div>
                        <h3 class="font-bold text-slate-900 text-base mb-1">{locale === 'en' ? 'Talent Workflow' : 'Gestión de Talento'}</h3>
                        <p class="text-xs text-slate-500 leading-relaxed">{locale === 'en' ? 'Selection workflows and rigorous quality controls.' : 'Procesos de selección y controles de calidad.'}</p>
                    </div>
                </div>
            </a>

        </div>
    </section>

    <!-- ========================================== -->
    <!-- SECCIONES DETALLADAS DE LAS ÁREAS          -->
    <!-- ========================================== -->

    <!-- 1. Área de Tecnología (TI) -->
    <section id="area-ti" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-b border-slate-200/60 scroll-mt-24">
        <div class="grid lg:grid-cols-12 gap-10 items-center">
            <div class="lg:col-span-7 space-y-6">
                <div class="inline-flex items-center gap-2 bg-blue-500/10 text-blue-700 px-3 py-1 rounded-full text-xs font-bold tracking-widest uppercase border border-blue-500/20">
                    💻 {locale === 'en' ? 'Specialized Domain' : 'Dominio Tecnológico'}
                </div>
                <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
                    {locale === 'en' ? 'Information Technology (IT) Outsourcing' : 'Outsourcing de Tecnología (TI)'}
                </h2>
                <p class="text-slate-600 leading-relaxed">
                    {locale === 'en'
                        ? 'We empower your technical infrastructure with certified engineers, robust cybersecurity solutions, server maintenance, and responsive technical help desk support.'
                        : 'Potenciamos su infraestructura tecnológica con ingenieros certificados, ciberseguridad avanzada, administración de servidores y soporte técnico integral de alta disponibilidad.'}
                </p>
                <div class="grid sm:grid-cols-2 gap-4 pt-2">
                    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm hover:border-blue-300 transition-all">
                        <h4 class="font-bold text-slate-900 text-sm mb-1">🛠️ {locale === 'en' ? 'Hardware & Networks' : 'Hardware y Redes'}</h4>
                        <p class="text-xs text-slate-500">{locale === 'en' ? 'Complete architecture upkeep and connectivity management.' : 'Mantenimiento de arquitectura y gestión de conectividad.'}</p>
                    </div>
                    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm hover:border-blue-300 transition-all">
                        <h4 class="font-bold text-slate-900 text-sm mb-1">🛡️ {locale === 'en' ? 'Cyber Defense' : 'Ciberdefensa'}</h4>
                        <p class="text-xs text-slate-500">{locale === 'en' ? 'Endpoint security oversight and active threat mitigation.' : 'Supervisión de endpoints y mitigación activa de amenazas.'}</p>
                    </div>
                </div>
            </div>
            <div class="lg:col-span-5">
                <div class="relative bg-gradient-to-br from-blue-950 to-blue-900 text-white p-8 rounded-3xl shadow-xl overflow-hidden border border-blue-800/50">
                    <div class="absolute inset-0 bg-[url('/assets/content.png')] opacity-10 bg-repeat bg-[length:200px]"></div>
                    <div class="relative z-15">
                        <h3 class="text-xl font-bold mb-4">{locale === 'en' ? 'Core Tech Standards' : 'Estándares Tecnológicos'}</h3>
                        <ul class="space-y-3 text-sm text-slate-200">
                            <li class="flex items-center gap-2.5">⚡ {locale === 'en' ? 'High-availability uptime tracking' : 'Monitoreo de alta disponibilidad'}</li>
                            <li class="flex items-center gap-2.5">🎓 {locale === 'en' ? 'Senior systems engineering experts' : 'Expertos en ingeniería de sistemas'}</li>
                            <li class="flex items-center gap-2.5">🔄 {locale === 'en' ? 'Automated disaster recovery protocols' : 'Protocolos de recuperación automatizada'}</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 2. Área de Finanzas y Contabilidad -->
    <section id="area-finanzas" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-b border-slate-200/60 scroll-mt-24">
        <div class="grid lg:grid-cols-12 gap-10 items-center">
            <div class="lg:col-span-5 order-2 lg:order-1">
                <div class="relative bg-gradient-to-br from-emerald-950 to-emerald-900 text-white p-8 rounded-3xl shadow-xl overflow-hidden border border-emerald-800/50">
                    <div class="absolute inset-0 bg-[url('/assets/content.png')] opacity-10 bg-repeat bg-[length:200px]"></div>
                    <div class="relative z-15">
                        <h3 class="text-xl font-bold mb-4">{locale === 'en' ? 'Fiscal Execution Pillars' : 'Pilares de Ejecución Fiscal'}</h3>
                        <ul class="space-y-3 text-sm text-slate-200">
                            <li class="flex items-center gap-2.5">📈 {locale === 'en' ? 'Dynamic liquidity forecasting' : 'Proyecciones dinámicas de liquidez'}</li>
                            <li class="flex items-center gap-2.5">📋 {locale === 'en' ? 'Regulatory tax alignment' : 'Alineación tributaria regulatoria'}</li>
                            <li class="flex items-center gap-2.5">💡 {locale === 'en' ? 'Capital allocation advisory' : 'Asesoría en asignación de capital'}</li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="lg:col-span-7 space-y-6 order-1 lg:order-2">
                <div class="inline-flex items-center gap-2 bg-emerald-500/10 text-emerald-700 px-3 py-1 rounded-full text-xs font-bold tracking-widest uppercase border border-emerald-500/20">
                    📊 {locale === 'en' ? 'Financial Sector' : 'Sector Financiero'}
                </div>
                <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
                    {locale === 'en' ? 'Finance & Accounting Outsourcing' : 'Outsourcing de Finanzas y Contabilidad'}
                </h2>
                <p class="text-slate-600 leading-relaxed">
                    {locale === 'en'
                        ? 'Optimize your economic planning and bookkeeping with professional oversight, ensuring compliance, financial clarity, and informed business decision-making.'
                        : 'Optimice su planificación económica y contabilidad con supervisión profesional, garantizando orden fiscal, claridad financiera y toma de decisiones asertiva.'}
                </p>
                <div class="grid sm:grid-cols-2 gap-4 pt-2">
                    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm hover:border-emerald-300 transition-all">
                        <h4 class="font-bold text-slate-900 text-sm mb-1">📑 {locale === 'en' ? 'Ledgers & Audits' : 'Libros y Auditorías'}</h4>
                        <p class="text-xs text-slate-500">{locale === 'en' ? 'Rigorous transaction logs and reconciliation workflows.' : 'Registros transaccionales rigurosos y flujos de conciliación.'}</p>
                    </div>
                    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm hover:border-emerald-300 transition-all">
                        <h4 class="font-bold text-slate-900 text-sm mb-1">📉 {locale === 'en' ? 'Expense Control' : 'Control de Gastos'}</h4>
                        <p class="text-xs text-slate-500">{locale === 'en' ? 'Strategic cost containment and margin expansion.' : 'Contención estratégica de costos y expansión de márgenes.'}</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. Área de Recursos Humanos -->
    <section id="area-rrhh" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-b border-slate-200/60 scroll-mt-24">
        <div class="grid lg:grid-cols-12 gap-10 items-center">
            <div class="lg:col-span-7 space-y-6">
                <div class="inline-flex items-center gap-2 bg-purple-500/10 text-purple-700 px-3 py-1 rounded-full text-xs font-bold tracking-widest uppercase border border-purple-500/20">
                    👥 {locale === 'en' ? 'Human Capital' : 'Capital Humano'}
                </div>
                <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
                    {locale === 'en' ? 'Human Resources Outsourcing' : 'Outsourcing de Recursos Humanos'}
                </h2>
                <p class="text-slate-600 leading-relaxed">
                    {locale === 'en'
                        ? 'We manage the complete talent lifecycle—from recruiting to payroll processing and welfare programs—while strictly respecting local legal frameworks.'
                        : 'Administramos el ciclo de vida completo del talento humano —desde la selección hasta la planilla y programas de bienestar— bajo riguroso cumplimiento normativo.'}
                </p>
                <div class="grid sm:grid-cols-2 gap-4 pt-2">
                    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm hover:border-purple-300 transition-all">
                        <h4 class="font-bold text-slate-900 text-sm mb-1">🌟 {locale === 'en' ? 'Workplace Culture' : 'Clima Organizacional'}</h4>
                        <p class="text-xs text-slate-500">{locale === 'en' ? 'Programs designed to retain top performers and boost morale.' : 'Programas diseñados para retener talento clave y elevar la moral.'}</p>
                    </div>
                    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm hover:border-purple-300 transition-all">
                        <h4 class="font-bold text-slate-900 text-sm mb-1">⚖️ {locale === 'en' ? 'Labor Compliance' : 'Cumplimiento Laboral'}</h4>
                        <p class="text-xs text-slate-500">{locale === 'en' ? 'Adherence to regional legal frameworks and payroll safety.' : 'Apego a marcos legales regionales y seguridad en planillas.'}</p>
                    </div>
                </div>
            </div>
            <div class="lg:col-span-5">
                <div class="relative bg-gradient-to-br from-purple-950 to-purple-900 text-white p-8 rounded-3xl shadow-xl overflow-hidden border border-purple-800/50">
                    <div class="absolute inset-0 bg-[url('/assets/content.png')] opacity-10 bg-repeat bg-[length:200px]"></div>
                    <div class="relative z-15">
                        <h3 class="text-xl font-bold mb-4">{locale === 'en' ? 'HR Operations Focus' : 'Enfoque Operativo de RRHH'}</h3>
                        <ul class="space-y-3 text-sm text-slate-200">
                            <li class="flex items-center gap-2.5">🎯 {locale === 'en' ? 'Targeted talent positioning' : 'Posicionamiento focalizado de talento'}</li>
                            <li class="flex items-center gap-2.5">📊 {locale === 'en' ? 'Performance analytics metrics' : 'Métricas de analítica de desempeño'}</li>
                            <li class="flex items-center gap-2.5">🤝 {locale === 'en' ? 'Smooth employee onboarding' : 'Inducción fluida para colaboradores'}</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 4. Área de Marketing -->
    <section id="area-marketing" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-b border-slate-200/60 scroll-mt-24">
        <div class="grid lg:grid-cols-12 gap-10 items-center">
            <div class="lg:col-span-5 order-2 lg:order-1">
                <div class="relative bg-gradient-to-br from-amber-950 to-amber-900 text-white p-8 rounded-3xl shadow-xl overflow-hidden border border-amber-800/50">
                    <div class="absolute inset-0 bg-[url('/assets/content.png')] opacity-10 bg-repeat bg-[length:200px]"></div>
                    <div class="relative z-15">
                        <h3 class="text-xl font-bold mb-4">{locale === 'en' ? 'Market Growth Pillars' : 'Pilares de Expansión de Mercado'}</h3>
                        <ul class="space-y-3 text-sm text-slate-200">
                            <li class="flex items-center gap-2.5">🚀 {locale === 'en' ? 'Conversion rate optimization' : 'Optimización de tasas de conversión'}</li>
                            <li class="flex items-center gap-2.5">🎨 {locale === 'en' ? 'Creative storytelling identity' : 'Identidad de narrativa creativa'}</li>
                            <li class="flex items-center gap-2.5">📢 {locale === 'en' ? 'Omnichannel reach execution' : 'Ejecución de alcance omnicanal'}</li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="lg:col-span-7 space-y-6 order-1 lg:order-2">
                <div class="inline-flex items-center gap-2 bg-amber-500/10 text-amber-700 px-3 py-1 rounded-full text-xs font-bold tracking-widest uppercase border border-amber-500/20">
                    📢 {locale === 'en' ? 'Commercial Reach' : 'Alcance Comercial'}
                </div>
                <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
                    {locale === 'en' ? 'Marketing Outsourcing' : 'Outsourcing de Marketing'}
                </h2>
                <p class="text-slate-600 leading-relaxed">
                    {locale === 'en'
                        ? 'Accelerate your commercial reach and brand positioning with dedicated marketing strategies, digital content production, and data-driven campaigns.'
                        : 'Acelere su alcance comercial y posicionamiento de marca con estrategias de marketing dedicadas, producción de contenido digital y campañas basadas en datos.'}
                </p>
                <div class="grid sm:grid-cols-2 gap-4 pt-2">
                    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm hover:border-amber-300 transition-all">
                        <h4 class="font-bold text-slate-900 text-sm mb-1">⚡ {locale === 'en' ? 'Performance Ads' : 'Anuncios de Rendimiento'}</h4>
                        <p class="text-xs text-slate-500">{locale === 'en' ? 'Data-driven paid media campaigns and lead funnels.' : 'Campañas de pauta pagada basadas en datos y embudos.'}</p>
                    </div>
                    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm hover:border-amber-300 transition-all">
                        <h4 class="font-bold text-slate-900 text-sm mb-1">🌐 {locale === 'en' ? 'Brand Authority' : 'Autoridad de Marca'}</h4>
                        <p class="text-xs text-slate-500">{locale === 'en' ? 'Consistent digital footprint building and corporate presence.' : 'Construcción constante de huella digital y presencia.'}</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ========================================== -->
    <!-- 5. SECCIÓN DE PROCESO DE SELECCIÓN (ID: area-gestion) -->
    <!-- ========================================== -->
    <section id="area-gestion" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 scroll-mt-24">
        <div class="grid lg:grid-cols-12 gap-12 items-center">
            
            <!-- Izquierda: Proceso de Reclutamiento -->
            <div class="lg:col-span-7 space-y-8">
                <div>
                    <div class="inline-flex items-center gap-2 bg-tyta-amber/10 text-tyta-amber px-3 py-1 rounded-full text-xs font-bold tracking-widest uppercase mb-3 border border-tyta-amber/20">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        {locale === 'en' ? 'Selection Workflow' : 'Gestión Integral de Talento y Procesos'}
                    </div>
                    <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
                        {locale === 'en' ? 'End-to-End Talent Selection Framework' : 'Metodología Integral de Selección de Talento'}
                    </h2>
                    <p class="text-slate-600 mt-4 leading-relaxed text-base">
                        {locale === 'en'
                            ? 'We handle the complete internal recruitment process for your company, from profile definition to hiring, ensuring total alignment with labor laws.'
                            : 'Nos encargamos del proceso completo de reclutamiento interno para su organización, desde la estructuración de perfiles hasta la contratación final, garantizando sintonía legal.'}
                    </p>
                </div>

                <div class="grid sm:grid-cols-2 gap-5">
                    <!-- Tarjeta 1 -->

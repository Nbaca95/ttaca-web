---
// src/components/pages/services/ItOutsourcingPage.astro
import { Image } from "astro:assets";
import { getLocaleFromUrl, localizedPath } from "../../../i18n";

// Imágenes de servicios
import hero1Img from "../../../assets/images/outsourcing.png";
import hero2Img from "../../../assets/images/Finanzas.png";
import hero4Img from "../../../assets/images/Marketing.png";
import logoHpe from "../../../assets/images/RRHH.png";
import logoAruba from "../../../assets/images/GestionTalento.png";

const locale = getLocaleFromUrl(Astro.url);
const contactHref = localizedPath(locale, "/contact");

// Atajo para textos bilingües
const L = (es: string, en: string) => (locale === 'en' ? en : es);

/* ------------------------------------------------------------------ */
/*  ÁREAS CON SECCIÓN DETALLADA (BANNER INMERSIVO)                    */
/* ------------------------------------------------------------------ */
const areas = [
    {
        id: "area-ti",
        image: hero1Img,
        imageAlt: L("Especialista de TI trabajando en un centro de datos", "IT specialist working in a data center"),
        cardTitle: L("Tecnología (TI)", "Information Technology"),
        cardShort: L("Soporte, servidores, redes y seguridad.", "Support, servers, networks and security."),
        badge: L("Dominio Tecnológico", "Technology"),
        title: L("Tecnología e Infraestructura (TI)", "Information & Infrastructure Technology"),
        intro: L(
            "Asumimos la operación integral y el gobierno de la tecnología de su empresa. Garantizamos la continuidad operativa mediante la administración proactiva de centros de datos, redes de alta disponibilidad y ciberseguridad avanzada, liberando a su organización de la carga técnica y operativa.",
            "We assume the comprehensive operation and governance of your company's technology. We guarantee operational continuity through proactive data center management, high-availability networks, and advanced cybersecurity."
        ),
        services: [
            {
                title: L("Mesa de ayuda y soporte técnico N1/N2/N3", "Help Desk and N1/N2/N3 Tech Support"),
                desc: L("Resolución estructurada de incidentes y requerimientos de usuarios finales bajo estrictos acuerdos de nivel de servicio (SLA).", "Structured resolution of end-user incidents and requests under strict Service Level Agreements (SLAs)."),
            },
            {
                title: L("Administración de Servidores y Cloud", "Server & Cloud Administration"),
                desc: L("Gestión, virtualización, respaldo y monitoreo 24/7 de entornos físicos, híbridos y en la nube (AWS, Azure, On-Premise).", "Management, virtualization, backup and 24/7 monitoring of physical, hybrid, and cloud environments."),
            },
            {
                title: L("Redes corporativas y conectividad", "Corporate Networks & Connectivity"),
                desc: L("Diseño, configuración y seguridad de redes LAN/WAN, enlaces VPN corporativos y conectividad Wi-Fi empresarial.", "Design, configuration and security of LAN/WAN networks, corporate VPN links, and enterprise Wi-Fi."),
            },
            {
                title: L("Ciberseguridad y continuidad", "Cybersecurity & Business Continuity"),
                desc: L("Implementación de políticas de respaldo automatizadas, firewalls, gestión de endpoints y planes de recuperación ante desastres.", "Implementation of automated backup policies, firewalls, endpoint management, and disaster recovery plans."),
            },
        ],
        extraInfo: {
            title: L("Excelencia Operativa y Monitoreo Preventivo", "Operational Excellence & Preventive Monitoring"),
            description: L(
                "Nuestra arquitectura de soporte incorpora herramientas de telemetría predictiva, gestión centralizada de parches de seguridad y diagnósticos en tiempo real para anticiparnos a cualquier fallo potencial en la infraestructura.",
                "Our support architecture incorporates predictive telemetry tools, centralized security patch management, and real-time diagnostics to anticipate any potential infrastructure failure."
            ),
            items: [
                L("Auditorías periódicas de vulnerabilidades y estado de red", "Periodic vulnerability audits and network health checks"),
                L("Planes de contingencia ante caídas y respaldos inmutables", "Contingency plans against outages and immutable backups"),
                L("Inventario automatizado de activos tecnológicos y licencias", "Automated inventory of technological assets and software licenses"),
                L("Gestión directa con fabricantes para resolución de garantías", "Direct manufacturer liaison for warranty resolution")
            ]
        },
        panelTitle: L("Beneficios clave para su operación", "Key benefits for your operation"),
        panelItems: [
            L("Reducción drástica de tiempos de inactividad (Downtime)", "Drastic reduction in downtime"),
            L("Especialistas certificados en diversas tecnologías", "Certified specialists across various technologies"),
            L("Optimización y predictibilidad del presupuesto de TI", "Optimization and predictability of IT budget"),
        ],
        theme: {
            badge: "bg-blue-500/10 text-blue-400 border-blue-500/20",
            dotColor: "bg-blue-400",
            hover: "hover:border-blue-300",
        },
    },
    {
        id: "area-finanzas",
        image: hero2Img,
        imageAlt: L("Profesional revisando reportes financieros", "Professional reviewing financial reports"),
        cardTitle: L("Finanzas y Contabilidad", "Finance & Accounting"),
        cardShort: L("Contabilidad, conciliaciones e impuestos.", "Accounting, reconciliations and taxes."),
        badge: L("Finanzas y Contabilidad", "Finance & Accounting"),
        title: L("Gestión Financiera y Contable", "Financial & Accounting Management"),
        intro: L(
            "Blindamos la salud financiera de su empresa con rigor contable, transparencia y estricto apego al marco fiscal vigente. Transformamos datos complejos en reportes claros para la toma de decisiones estratégicas y gerenciales en cada cierre de periodo.",
            "We safeguard your company's financial health with accounting rigor, transparency, and strict adherence to the current tax framework. We transform complex data into clear reports for strategic decision-making."
        ),
        services: [
            {
                title: L("Contabilidad general y cierres", "General Accounting & Closings"),
                desc: L("Registro contable automatizado, conciliaciones bancarias exhaustivas y emisión oportuna de estados financieros.", "Automated bookkeeping, comprehensive bank reconciliations, and timely issuance of financial statements."),
            },
            {
                title: L("Gestión de tesorería y flujos", "Treasury & Cash Flow Management"),
                desc: L("Control riguroso de cuentas por pagar a proveedores y optimización del ciclo de cuentas por cobrar a clientes.", "Rigorous control of accounts payable to suppliers and optimization of the accounts receivable cycle."),
            },
            {
                title: L("Cumplimiento fiscal y tributario", "Tax & Fiscal Compliance"),
                desc: L("Preparación, cálculo y presentación de declaraciones de impuestos corporativos ante las autoridades competentes.", "Preparation, calculation, and filing of corporate tax returns with competent authorities."),
            },
            {
                title: L("Análisis financiero y presupuestario", "Financial & Budget Analysis"),
                desc: L("Evaluación de desviaciones presupuestarias, control de gastos operativos y proyecciones de flujo de caja.", "Evaluation of budget variances, operating expense control, and cash flow projections."),
            },
        ],
        extraInfo: {
            title: L("Control y Gobernanza Financiera", "Financial Control & Governance"),
            description: L(
                "Proporcionamos visibilidad financiera en tiempo real mediante tableros de control gerencial, permitiendo a la alta dirección anticipar escenarios de liquidez, evaluar riesgos fiscales y mantener un control estricto sobre el presupuesto operativo.",
                "We provide real-time financial visibility through management dashboards, enabling upper management to anticipate liquidity scenarios, assess tax risks, and maintain strict control over the operating budget."
            ),
            items: [
                L("Proyecciones financieras y de flujo de caja a mediano plazo", "Mid-term financial and cash flow projections"),
                L("Optimización de capital de trabajo y estructura de costos", "Working capital and cost structure optimization"),
                L("Soporte integral y representación ante auditorías fiscales", "Comprehensive support and representation during tax audits"),
                L("Evaluación de rentabilidad por líneas de negocio o productos", "Profitability evaluation by business lines or products")
            ]
        },
        panelTitle: L("Resultados garantizados", "Guaranteed results"),
        panelItems: [
            L("Información financiera confiable y a tiempo", "Reliable and timely financial information"),
            L("Mitigación total de riesgos por sanciones tributarias", "Total mitigation of risks from tax penalties"),
            L("Visibilidad absoluta de la rentabilidad del negocio", "Absolute visibility into business profitability"),
        ],
        theme: {
            badge: "bg-emerald-500/10 text-emerald-400 border-emerald-500/20",
            dotColor: "bg-emerald-400",
            hover: "hover:border-emerald-300",
        },
    },
    {
        id: "area-rrhh",
        image: logoAruba,
        imageAlt: L("Reunión de recursos humanos con un colaborador", "Human resources meeting with an employee"),
        cardTitle: L("Recursos Humanos", "Human Resources"),
        cardShort: L("Planilla, contratación y capacitación.", "Payroll, hiring and training."),
        badge: L("Capital Humano", "Human Capital"),
        title: L("Administración de Capital Humano y RRHH", "Human Capital & HR Administration"),
        intro: L(
            "Potenciamos el motor principal de su empresa: su gente. Nos encargamos de administrar el ciclo de vida laboral de los colaboradores con procesos justos, eficientes y alineados con la legislación laboral local, fomentando un clima organizacional óptimo.",
            "We empower your company's main engine: your people. We manage the employee lifecycle with fair, efficient processes aligned with local labor legislation, fostering an optimal organizational climate."
        ),
        services: [
            {
                title: L("Gestión de planillas y cargas", "Payroll & Contributions Management"),
                desc: L("Cálculo exacto de nóminas, deducciones de ley, provisiones, aguinaldos y gestión de cargas sociales.", "Exact calculation of payroll, statutory deductions, provisions, bonuses, and social security management."),
            },
            {
                title: L("Administración de expedientes y contratos", "File & Contract Administration"),
                desc: L("Elaboración blindada de contratos laborales, adendum, control de vacaciones y gestión legal de personal.", "Secure drafting of employment contracts, addendums, vacation tracking, and legal personnel management."),
            },
            {
                title: L("Desarrollo organizacional y clima", "Organizational Development & Climate"),
                desc: L("Diseño de programas de capacitación continua, evaluaciones de desempeño y encuestas de clima laboral.", "Design of continuous training programs, performance reviews, and work climate surveys."),
            },
            {
                title: L("Salud ocupacional y bienestar", "Occupational Health & Wellness"),
                desc: L("Coordinación de comités de salud ocupacional, prevención de riesgos y programas de bienestar integral.", "Coordination of occupational health committees, risk prevention, and comprehensive wellness programs."),
            },
        ],
        extraInfo: {
            title: L("Estrategia de Bienestar y Retención de Talento", "Wellness & Talent Retention Strategy"),
            description: L(
                "Fomentamos un entorno de trabajo saludable y estructurado mediante planes de carrera, incentivos corporativos, y el estricto cumplimiento de los reglamentos internos y de salud ocupacional exigidos por la ley.",
                "We foster a healthy and structured work environment through career plans, corporate incentives, and strict compliance with internal regulations and occupational health laws."
            ),
            items: [
                L("Diseño de planes de compensación y beneficios competitivos", "Design of competitive compensation and benefits plans"),
                L("Programas estructurados de integración y retención de talento", "Structured talent integration and retention programs"),
                L("Digitalización integral de expedientes laborales y legales", "Comprehensive digitalization of labor and legal records"),
                L("Gestión de relaciones laborales y resolución de conflictos", "Labor relations management and conflict resolution")
            ]
        },
        panelTitle: L("Ventajas operativas de gestión", "Operational management advantages"),
        panelItems: [
            L("Cumplimiento normativo y laboral 100% garantizado", "100% guaranteed regulatory and labor compliance"),
            L("Procesos de pago de planilla sin errores ni retrasos", "Error-free and timely payroll processing"),
            L("Mayor retención de talento clave en su empresa", "Higher retention of key talent in your company"),
        ],
        theme: {
            badge: "bg-purple-500/10 text-purple-400 border-purple-500/20",
            dotColor: "bg-purple-400",
            hover: "hover:border-purple-300",
        },
    },
    {
        id: "area-marketing",
        image: hero4Img,
        imageAlt: L("Equipo de marketing analizando campañas", "Marketing team analyzing campaigns"),
        cardTitle: "Marketing",
        cardShort: L("Estrategia, contenido y campañas digitales.", "Strategy, content and digital campaigns."),
        badge: L("Marketing y Comunicación", "Marketing & Communication"),
        title: L("Estrategia de Marketing y Posicionamiento Digital", "Marketing Strategy & Digital Positioning"),
        intro: L(
            "Impulsamos la presencia de su marca en el mercado mediante estrategias omnicanal basadas en datos. Desarrollamos campañas creativas y de alto rendimiento orientadas a la generación de demanda, conversión y fidelización de clientes.",
            "We boost your brand's presence in the market through data-driven omnichannel strategies. We develop creative, high-performance campaigns aimed at demand generation, conversion, and customer loyalty."
        ),
        services: [
            {
                title: L("Estrategia de marca y posicionamiento", "Brand Strategy & Positioning"),
                desc: L("Definición de propuesta de valor, arquitectura de marca, identidad visual y segmentación de audiencias objetivo.", "Definition of value proposition, brand architecture, visual identity, and target audience segmentation."),
            },
            {
                title: L("Marketing de contenidos y redes sociales", "Content Marketing & Social Media"),
                desc: L("Creación de calendarios editoriales, producción audiovisual, diseño gráfico y gestión profesional de comunidades.", "Creation of editorial calendars, audiovisual production, graphic design, and professional community management."),
            },
            {
                title: L("Publicidad digital y pauta (Ads)", "Digital Advertising & Paid Media"),
                desc: L("Gestión avanzada de campañas de pauta publicitaria en Google Ads, Meta Ads y redes B2B para generación de leads.", "Advanced management of paid ad campaigns on Google Ads, Meta Ads, and B2B networks for lead generation."),
            },
            {
                title: L("Analítica web y optimización de ROI", "Web Analytics & ROI Optimization"),
                desc: L("Medición rigurosa de KPIs, auditoría de embudos de conversión y reportes mensuales de retorno de inversión.", "Rigorous KPI measurement, conversion funnel auditing, and monthly ROI reports."),
            },
        ],
        extraInfo: {
            title: L("Innovación Comercial y Generación de Leads", "Commercial Innovation & Lead Generation"),
            description: L(
                "Diseñamos embudos de conversión automatizados y campañas orientadas a resultados comerciales directos, conectando su marca con prospectos altamente calificados y optimizando cada dólar invertido en publicidad.",
                "We design automated conversion funnels and campaigns oriented toward direct commercial results, connecting your brand with highly qualified prospects and optimizing every dollar spent on advertising."
            ),
            items: [
                L("Desarrollo de estrategias avanzadas de Inbound Marketing", "Development of advanced Inbound Marketing strategies"),
                L("Diseño y optimización de pauta publicitaria hipersegmentada", "Design and optimization of hyper-segmented advertising"),
                L("Construcción de dashboards analíticos de tráfico y ventas", "Construction of traffic and sales analytical dashboards"),
                L("Optimización continua del costo por adquisición (CPA)", "Continuous optimization of cost per acquisition (CPA)")
            ]
        },
        panelTitle: L("Impacto comercial directo", "Direct commercial impact"),
        panelItems: [
            L("Aumento sistemático de oportunidades comerciales (Leads)", "Systematic increase in commercial opportunities (Leads)"),
            L("Consistencia comunicacional en todos los canales digitales", "Communicational consistency across all digital channels"),
            L("Retorno de inversión medible y optimizado constantemente", "Measurable and constantly optimized return on investment"),
        ],
        theme: {
            badge: "bg-amber-500/10 text-amber-400 border-amber-500/20",
            dotColor: "bg-amber-400",
            hover: "hover:border-amber-300",
        },
    },
];

/* ------------------------------------------------------------------ */
/*  GESTIÓN DE TALENTO                                                */
/* ------------------------------------------------------------------ */
const talent = {
    id: "area-gestion",
    image: logoHpe,
    imageAlt: L("Entrevista de selección de personal", "Recruitment interview"),
    cardTitle: L("Gestión de Talento", "Talent Management"),
    cardShort: L("Selección de personal de punta a punta.", "End-to-end personnel selection."),
    badge: L("Gestión de Talento", "Talent Management"),
    title: L("Metodología Integral de Selección de Talento", "End-to-End Talent Selection Framework"),
    intro: L(
        "Encontramos al candidato adecuado para cada puesto, operativo o ejecutivo, mediante un proceso estructurado, riguroso y científico que va desde el levantamiento del perfil hasta su integración exitosa a la cultura corporativa.",
        "We find the right candidate for every role, operational or executive, through a structured, rigorous, and scientific process ranging from profile building to successful cultural integration."
    ),
    steps: [
        {
            title: L("Definición y levantamiento de perfil", "Profile definition and scoping"),
            desc: L("Analizamos a fondo las competencias técnicas, blandas y objetivos estratégicos que el puesto exige.", "We thoroughly analyze the technical, soft skills, and strategic objectives required by the role."),
        },
        {
            title: L("Reclutamiento y filtrado masivo/ejecutivo", "Recruitment and screening"),
            desc: L("Búsqueda activa en bases de datos, redes especializadas y preselección rigurosa de currículos.", "Active sourcing in databases, specialized networks, and rigorous resume pre-selection."),
        },
        {
            title: L("Evaluación técnica y entrevistas por competencias", "Technical assessment & competency interviews"),
            desc: L("Aplicación de pruebas psicométricas, técnicas y entrevistas profundas para evaluar ajustes de encaje cultural.", "Application of psychometric and technical tests, plus deep interviews to evaluate cultural fit."),
        },
        {
            title: L("Contratación, inducción y seguimiento", "Hiring, onboarding, and tracking"),
            desc: L("Acompañamiento en la oferta formal, proceso de incorporación y seguimiento continuo del desempeño inicial.", "Support in the formal offer, onboarding process, and continuous tracking of initial performance."),
        },
    ],
    extraInfo: {
        title: L("Acompañamiento y Garantía de Éxito", "Support & Success Guarantee"),
        description: L(
            "Nuestro compromiso va más allá de la contratación. Aseguramos la adaptación y el rendimiento óptimo del colaborador incorporado mediante un seguimiento cercano y métricas de desempeño comprobadas.",
            "Our commitment goes beyond hiring. We ensure the adaptation and optimal performance of the onboarded collaborator through close follow-up and proven performance metrics."
        ),
        items: [
            L("Seguimiento personalizado durante el periodo de prueba", "Personalized tracking during the probationary period"),
            L("Garantía de respaldo y reemplazo bajo condiciones específicas", "Backup and replacement guarantee under specific conditions"),
            L("Informes detallados sobre competencias y ajuste cultural", "Detailed reports on competencies and cultural fit"),
            L("Evaluación de clima de integración con el equipo de trabajo", "Integration climate assessment with the work team")
        ]
    },
    panelTitle: L("Garantía de Calidad", "Quality Assurance"),
    panelItems: [
        L("Evaluación continua orientada a métricas de rendimiento", "Continuous evaluation oriented to performance metrics"),
        L("Controles rigurosos en cada etapa del proceso de selección", "Strict controls at each stage of the selection process"),
        L("Aseguramiento total de la excelencia operativa interna", "Total assurance of internal operational excellence"),
    ],
    theme: {
        badge: "bg-cyan-500/10 text-cyan-400 border-cyan-500/20",
        dotColor: "bg-cyan-400",
        hover: "hover:border-cyan-300",
    },
};

const summaryCards = [...areas, talent];
---

<style>
    html {
        scroll-behavior: smooth;
    }

    .reveal-on-scroll {
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.8s ease-out, transform 0.8s ease-out;
    }

    .reveal-on-scroll.is-visible {
        opacity: 1;
        transform: translateY(0);
    }
</style>

<main class="bg-slate-50 overflow-hidden">
    <!-- Hero Section -->
    <section class="relative bg-gradient-to-br from-[#060b19] via-[#0b132b] to-[#00529B] py-24 px-4 text-white overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-t from-[#060b19]/80 via-transparent to-transparent"></div>

        <div class="relative max-w-5xl mx-auto text-center z-10 reveal-on-scroll">
            <div class="inline-block mb-4">
                <span class="bg-white/10 backdrop-blur-md border border-white/15 text-tyta-amber font-bold tracking-widest uppercase text-xs px-4 py-1.5 rounded-full shadow-lg">
                    {L('Outsourcing de Procesos y TI', 'Business Process & IT Outsourcing')}
                </span>
            </div>
            <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-white tracking-tight leading-tight mt-2 mb-6">
                {L('Outsourcing Estratégico y Talento Especializado', 'Strategic Outsourcing & Specialized Talent')}
            </h1>
            <p class="text-lg sm:text-xl text-slate-300 max-w-3xl mx-auto font-normal leading-relaxed">
                {L(
                    'Gestionamos y ejecutamos las funciones empresariales diarias con un enfoque especializado en el área de TI, finanzas, RRHH, marketing y contabilidad.',
                    'Managing and executing your daily business functions with a specialized focus on IT, finance, HR, marketing, and accounting.'
                )}
            </p>
        </div>
    </section>

    <!-- Tarjetas de Áreas de Especialización -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-12 relative z-20 mb-20 reveal-on-scroll">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-5">
            {summaryCards.map((card, index) => (
                <a
                    href={`#${card.id}`}
                    class={`bg-white rounded-2xl shadow-xl shadow-slate-200/50 border border-slate-100 overflow-hidden hover:shadow-2xl hover:-translate-y-1.5 transition-all duration-300 group flex flex-col ${index === 4 ? 'sm:col-span-2 lg:col-span-1' : ''}`}
                >
                    <div class="h-36 overflow-hidden relative">
                        <div class="absolute inset-0 bg-blue-950/20 group-hover:bg-blue-950/0 transition-colors z-10"></div>
                        <Image
                            src={card.image}
                            alt={card.cardTitle}
                            width={600}
                            height={360}
                            class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
                        />
                    </div>
                    <div class="p-5 flex-1 flex flex-col justify-between gap-4">
                        <div>
                            <h3 class="font-bold text-slate-900 text-base mb-1 group-hover:text-tyta-amber transition-colors duration-300">
                                {card.cardTitle}
                            </h3>
                            <p class="text-xs text-slate-500 leading-relaxed">{card.cardShort}</p>
                        </div>
                        <span class="inline-flex items-center gap-1.5 text-xs font-bold text-tyta-amber opacity-0 -translate-y-1 group-hover:opacity-100 group-hover:translate-y-0 group-hover:gap-2.5 transition-all duration-300">
                            {L('Ver detalle', 'See details')}
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                        </span>
                    </div>
                </a>
            ))}
        </div>
    </section>

    <!-- Secciones Detalladas (Áreas) -->
    {areas.map((area) => (
        <section
            id={area.id}
            class="w-full p-0 border-b border-slate-200/60 scroll-mt-24 reveal-on-scroll mb-16"
        >
            <div class="space-y-12">
                <!-- Banner Inmersivo de Fondo con Texto Sobrepuesto -->
                <div class="relative w-full min-h-[680px] sm:min-h-[600px] lg:min-h-[560px] overflow-hidden flex items-center">
                    <!-- Imagen de Fondo Principal -->
                    <Image
                        src={area.image}
                        alt={area.imageAlt}
                        width={1600}
                        height={800}
                        class="absolute inset-0 w-full h-full object-cover object-[center_top] md:object-[center_10%]"
                    />

                    <!-- Overlay de Degradado Oscuro -->
                    <div class="absolute inset-0 bg-gradient-to-r from-slate-950/95 via-slate-950/80 to-slate-950/30"></div>

                    <!-- Contenido sobrepuesto -->
                    <div class="relative z-10 w-full px-6 py-16 sm:px-10 sm:py-16 lg:px-16 lg:py-20 max-w-5xl space-y-6 text-white">
                        <!-- Etiqueta -->
                        <div class={`inline-flex items-center gap-2 bg-white/10 backdrop-blur-md px-3.5 py-1.5 rounded-full text-xs font-extrabold tracking-widest uppercase border border-white/15 shadow-md ${area.theme.badge.split(' ')[1]}`}>
                            {area.badge}
                        </div>

                        <!-- Título -->
                        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight leading-tight text-white drop-shadow-sm">
                            {area.title}
                        </h2>

                        <!-- Descripción -->
                        <p class="text-slate-200 text-sm sm:text-base lg:text-lg leading-relaxed font-normal max-w-3xl">
                            {area.intro}
                        </p>

                        <!-- Lista rápida de Píldoras -->
                        <div class="pt-2 grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs font-semibold text-slate-200">
                            {area.panelItems.map((panelItem) => (
                                <div class="flex items-center gap-2 bg-white/10 backdrop-blur-sm px-3 py-2 rounded-xl border border-white/10">
                                    <span class={`w-2 h-2 rounded-full shrink-0 ${area.theme.dotColor}`}></span>
                                    {panelItem}
                                </div>
                            ))}
                        </div>
                    </div>
                </div>

                <!-- Sub-sección: Tarjetas en Cuadrícula de Servicios (Sin iconos ni números) -->
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 space-y-8">

---
// src/components/pages/services/ItOutsourcingPage.astro
import { Image } from "astro:assets";
import { getLocaleFromUrl, localizedPath } from "../../../i18n";

// Imágenes de servicios
import hero1Img from "../../../assets/images/outsourcing.png";
import hero2Img from "../../../assets/images/Finanzas.png";
import hero4Img from "../../../assets/images/Marketing.png";
import logoHpe from "../../../assets/images/RRHH.png";
import logoAruba from "../../../assets/images/GestionTalento.png";

const locale = getLocaleFromUrl(Astro.url);
const contactHref = localizedPath(locale, "/contact");

// Atajo para textos bilingües
const L = (es: string, en: string) => (locale === 'en' ? en : es);

/* ------------------------------------------------------------------ */
/*  ÁREAS CON SECCIÓN DETALLADA                                       */
/* ------------------------------------------------------------------ */
const areas = [
    {
        id: "area-ti",
        image: hero1Img,
        imageAlt: L("Especialista de TI trabajando en un centro de datos", "IT specialist working in a data center"),
        cardTitle: L("Tecnología (TI)", "Information Technology"),
        cardShort: L("Soporte, servidores, redes y seguridad.", "Support, servers, networks and security."),
        badge: L("Dominio Tecnológico", "Technology"),
        title: L("Outsourcing de Tecnología (TI)", "Information Technology (IT) Outsourcing"),
        intro: L(
            "Asumimos la operación diaria de la tecnología de su empresa: desde la mesa de ayuda que atiende a sus colaboradores hasta la administración de servidores, redes y seguridad. Usted cuenta con un equipo técnico dedicado y un servicio medible, sin el costo de contratar, capacitar y retener personal propio de TI.",
            "We take over the day-to-day operation of your company's technology: from the help desk that supports your employees to the administration of servers, networks and security. You get a dedicated technical team and a measurable service, without the cost of hiring, training and retaining in-house IT staff."
        ),
        services: [
            {
                title: L("Mesa de ayuda y soporte a usuarios", "Help desk and user support"),
                desc: L("Atención de incidentes y solicitudes de sus colaboradores, remota y en sitio, con tiempos de respuesta definidos.", "Handling of incidents and requests from your employees, remote and on-site, with defined response times."),
            },
            {
                title: L("Servidores y almacenamiento", "Servers and storage"),
                desc: L("Administración, actualización y monitoreo de servidores y almacenamiento, físicos o virtualizados.", "Administration, updates and monitoring of physical or virtualized servers and storage."),
            },
            {
                title: L("Redes y conectividad", "Networks and connectivity"),
                desc: L("Configuración y supervisión de la red local, el Wi-Fi corporativo y los enlaces de comunicación.", "Setup and supervision of your local network, corporate Wi-Fi and communication links."),
            },
            {
                title: L("Seguridad y respaldos", "Security and backups"),
                desc: L("Protección de equipos y datos, gestión de antivirus y políticas de respaldo con planes de recuperación.", "Protection of devices and data, antivirus management and backup policies with recovery plans."),
            },
        ],
        panelTitle: L("Qué recibe su empresa", "What your company gets"),
        panelItems: [
            L("Personal técnico dedicado a su operación", "Technical staff dedicated to your operation"),
            L("Monitoreo preventivo de la infraestructura", "Preventive monitoring of your infrastructure"),
            L("Reportes periódicos de incidentes y desempeño", "Regular incident and performance reports"),
        ],
        theme: {
            badge: "bg-blue-500/10 text-blue-700 border-blue-500/20",
            hover: "hover:border-blue-300",
            check: "bg-blue-50 text-blue-600",
            panel: "from-blue-950 to-blue-900 border-blue-800/50",
            fade: "from-blue-950 via-blue-950/60 to-transparent",
            dot: "bg-blue-500/20 text-blue-300",
        },
    },
    {
        id: "area-finanzas",
        image: hero2Img,
        imageAlt: L("Profesional revisando reportes financieros", "Professional reviewing financial reports"),
        cardTitle: L("Finanzas y Contabilidad", "Finance & Accounting"),
        cardShort: L("Contabilidad, conciliaciones e impuestos.", "Accounting, reconciliations and taxes."),
        badge: L("Finanzas y Contabilidad", "Finance & Accounting"),
        title: L("Outsourcing de Finanzas y Contabilidad", "Finance & Accounting Outsourcing"),
        intro: L(
            "Llevamos la contabilidad y las operaciones financieras de su empresa con procesos ordenados y al día. Registramos, conciliamos y reportamos para que usted tenga información confiable al cierre de cada mes y cumpla a tiempo con sus obligaciones fiscales.",
            "We run your company's accounting and financial operations with orderly, up-to-date processes. We record, reconcile and report so you have reliable information at every month-end and meet your tax obligations on time."
        ),
        services: [
            {
                title: L("Contabilidad general", "General accounting"),
                desc: L("Registro de transacciones, cierres mensuales y elaboración de estados financieros.", "Transaction recording, monthly closings and preparation of financial statements."),
            },
            {
                title: L("Cuentas por pagar y por cobrar", "Payables and receivables"),
                desc: L("Control de facturas, pagos a proveedores y seguimiento de cobros a clientes.", "Invoice control, supplier payments and follow-up on customer collections."),
            },
            {
                title: L("Conciliaciones bancarias", "Bank reconciliations"),
                desc: L("Verificación periódica de movimientos para detectar diferencias y mantener los saldos al día.", "Regular review of transactions to detect differences and keep balances up to date."),
            },
            {
                title: L("Obligaciones fiscales", "Tax obligations"),
                desc: L("Preparación de declaraciones de impuestos y apoyo ante revisiones de las autoridades tributarias.", "Preparation of tax returns and support during reviews by tax authorities."),
            },
        ],
        panelTitle: L("Resultados para su negocio", "Results for your business"),
        panelItems: [
            L("Información financiera lista cada cierre de mes", "Financial information ready at every month-end"),
            L("Menor riesgo de multas por incumplimiento", "Lower risk of penalties for non-compliance"),
            L("Reportes claros de flujo de caja y gastos", "Clear cash flow and expense reports"),
        ],
        theme: {
            badge: "bg-emerald-500/10 text-emerald-700 border-emerald-500/20",
            hover: "hover:border-emerald-300",
            check: "bg-emerald-50 text-emerald-600",
            panel: "from-emerald-950 to-emerald-900 border-emerald-800/50",
            fade: "from-emerald-950 via-emerald-950/60 to-transparent",
            dot: "bg-emerald-500/20 text-emerald-300",
        },
    },
    {
        id: "area-rrhh",
        image: logoAruba,
        imageAlt: L("Reunión de recursos humanos con un colaborador", "Human resources meeting with an employee"),
        cardTitle: L("Recursos Humanos", "Human Resources"),
        cardShort: L("Planilla, contratación y capacitación.", "Payroll, hiring and training."),
        badge: L("Capital Humano", "Human Capital"),
        title: L("Outsourcing de Recursos Humanos", "Human Resources Outsourcing"),
        intro: L(
            "Gestionamos la administración del personal de su empresa, desde el ingreso de un nuevo colaborador hasta el pago de la planilla. Nos encargamos de los procesos y documentos laborales para que su equipo directivo se concentre en el negocio y no en los trámites.",
            "We manage your company's personnel administration, from the onboarding of a new employee to payroll payment. We handle labor processes and paperwork so your leadership team can focus on the business, not the red tape."
        ),
        services: [
            {
                title: L("Planilla y cargas sociales", "Payroll and social contributions"),
                desc: L("Cálculo de salarios, deducciones, cargas sociales y beneficios de ley, con boletas y reportes.", "Calculation of salaries, deductions, social contributions and legal benefits, with payslips and reports."),
            },
            {
                title: L("Contratación e inducción", "Hiring and onboarding"),
                desc: L("Contratos de trabajo, expedientes del personal y proceso de ingreso de nuevos colaboradores.", "Employment contracts, personnel files and the onboarding process for new hires."),
            },
            {
                title: L("Capacitación y desarrollo", "Training and development"),
                desc: L("Planes de formación según las necesidades de cada puesto y de la empresa.", "Training plans based on the needs of each role and of the company."),
            },
            {
                title: L("Clima y evaluación del desempeño", "Work climate and performance reviews"),
                desc: L("Encuestas, evaluaciones y planes de mejora para retener a su talento.", "Surveys, evaluations and improvement plans to retain your talent."),
            },
        ],
        panelTitle: L("Qué incluye la gestión", "What the service includes"),
        panelItems: [
            L("Expedientes y trámites laborales al día", "Up-to-date personnel files and labor procedures"),
            L("Cumplimiento de la legislación laboral vigente", "Compliance with current labor legislation"),
            L("Reportes de personal y rotación", "Staffing and turnover reports"),
        ],
        theme: {
            badge: "bg-purple-500/10 text-purple-700 border-purple-500/20",
            hover: "hover:border-purple-300",
            check: "bg-purple-50 text-purple-600",
            panel: "from-purple-950 to-purple-900 border-purple-800/50",
            fade: "from-purple-950 via-purple-950/60 to-transparent",
            dot: "bg-purple-500/20 text-purple-300",
        },
    },
    {
        id: "area-marketing",
        image: hero4Img,
        imageAlt: L("Equipo de marketing analizando campañas", "Marketing team analyzing campaigns"),
        cardTitle: "Marketing",
        cardShort: L("Estrategia, contenido y campañas digitales.", "Strategy, content and digital campaigns."),
        badge: L("Marketing y Comunicación", "Marketing & Communication"),
        title: L("Outsourcing de Marketing", "Marketing Outsourcing"),
        intro: L(
            "Planificamos y ejecutamos la comunicación de su marca para atraer clientes: definimos la estrategia, producimos el contenido y administramos las campañas. Medimos cada acción para que usted sepa qué resultados genera su inversión.",
            "We plan and execute your brand's communication to attract customers: we define the strategy, produce the content and manage the campaigns. We measure every action so you know what results your investment generates."
        ),
        services: [
            {
                title: L("Estrategia y marca", "Strategy and brand"),
                desc: L("Definición de mensaje, público objetivo e identidad visual coherente.", "Definition of message, target audience and a consistent visual identity."),
            },
            {
                title: L("Redes sociales y contenido", "Social media and content"),
                desc: L("Calendario editorial, diseño de piezas gráficas y gestión de sus perfiles.", "Editorial calendar, graphic design and management of your profiles."),
            },
            {
                title: L("Campañas de pauta digital", "Digital ad campaigns"),
                desc: L("Anuncios en buscadores y redes sociales orientados a generar contactos y ventas.", "Search and social media ads focused on generating leads and sales."),
            },
            {
                title: L("Medición y reportes", "Measurement and reporting"),
                desc: L("Análisis mensual de alcance, interacción y resultados comerciales.", "Monthly analysis of reach, engagement and commercial results."),
            },
        ],
        panelTitle: L("Cómo trabajamos", "How we work"),
        panelItems: [
            L("Plan de acción alineado a sus metas comerciales", "Action plan aligned with your business goals"),
            L("Contenido propio para cada canal", "Tailored content for each channel"),
            L("Informes con métricas claras", "Reports with clear metrics"),
        ],
        theme: {
            badge: "bg-amber-500/10 text-amber-700 border-amber-500/20",
            hover: "hover:border-amber-300",
            check: "bg-amber-50 text-amber-600",
            panel: "from-amber-950 to-amber-900 border-amber-800/50",
            fade: "from-amber-950 via-amber-950/60 to-transparent",
            dot: "bg-amber-500/20 text-amber-300",
        },
    },
];

/* ------------------------------------------------------------------ */
/*  GESTIÓN DE TALENTO                                                */
/* ------------------------------------------------------------------ */
const talent = {
    id: "area-gestion",
    image: logoHpe,
    imageAlt: L("Entrevista de selección de personal", "Recruitment interview"),
    cardTitle: L("Gestión de Talento", "Talent Management"),
    cardShort: L("Selección de personal de punta a punta.", "End-to-end personnel selection."),
    badge: L("Gestión de Talento", "Talent Management"),
    title: L("Metodología Integral de Selección de Talento", "End-to-End Talent Selection Framework"),
    intro: L(
        "Encontramos al candidato adecuado para cada puesto, operativo o ejecutivo, con un proceso estructurado que va de la definición del perfil a la contratación. Después damos seguimiento para confirmar que la persona se integra y cumple lo esperado.",
        "We find the right candidate for every role, operational or executive, through a structured process that goes from defining the profile to hiring. Afterwards we follow up to confirm the person settles in and delivers as expected."
    ),
    steps: [
        {
            title: L("Definición del perfil", "Profile definition"),
            desc: L("Levantamos con usted las funciones, requisitos y competencias que necesita el puesto.", "We work with you to define the duties, requirements and skills the role needs."),
        },
        {
            title: L("Reclutamiento y filtrado", "Recruiting and screening"),
            desc: L("Convocatoria, revisión de currículos y preselección de los candidatos más afines.", "Job posting, résumé review and shortlisting of the best-matching candidates."),
        },
        {
            title: L("Evaluación y entrevistas", "Assessment and interviews"),
            desc: L("Entrevistas, pruebas técnicas y verificación de referencias de los finalistas.", "Interviews, technical tests and reference checks for the finalists."),
        },
        {
            title: L("Contratación y seguimiento", "Hiring and follow-up"),
            desc: L("Apoyo en la oferta e ingreso, y seguimiento del desempeño durante el período inicial.", "Support with the offer and onboarding, and performance follow-up during the initial period."),
        },
    ],
};

const summaryCards = [...areas, talent];
---

<style>
    html {
        scroll-behavior: smooth;
    }

    .reveal-on-scroll {
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.8s ease-out, transform 0.8s ease-out;
    }

    .reveal-on-scroll.is-visible {
        opacity: 1;
        transform: translateY(0);
    }
</style>

<main class="bg-slate-50 overflow-hidden">
    <!-- Hero Section -->
    <section class="relative bg-gradient-to-br from-[#060b19] via-[#0b132b] to-[#00529B] py-24 px-4 text-white overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-t from-[#060b19]/80 via-transparent to-transparent"></div>

        <div class="relative max-w-5xl mx-auto text-center z-10 reveal-on-scroll">
            <div class="inline-block mb-4">
                <span class="bg-white/10 backdrop-blur-md border border-white/15 text-tyta-amber font-bold tracking-widest uppercase text-xs px-4 py-1.5 rounded-full shadow-lg">
                    {L('Outsourcing de Procesos y TI', 'Business Process & IT Outsourcing')}
                </span>
            </div>
            <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-white tracking-tight leading-tight mt-2 mb-6">
                {L('Outsourcing Estratégico y Talento Especializado', 'Strategic Outsourcing & Specialized Talent')}
            </h1>
            <p class="text-lg sm:text-xl text-slate-300 max-w-3xl mx-auto font-normal leading-relaxed">
                {L(
                    'Gestionamos y ejecutamos las funciones empresariales diarias con un enfoque especializado en el área de TI, finanzas, RRHH, marketing y contabilidad.',
                    'Managing and executing your daily business functions with a specialized focus on IT, finance, HR, marketing, and accounting.'
                )}
            </p>
        </div>
    </section>

    <!-- Tarjetas de Áreas de Especialización -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-12 relative z-20 mb-20 reveal-on-scroll">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-5">
            {summaryCards.map((card, index) => (
                <a
                    href={`#${card.id}`}
                    class={`bg-white rounded-2xl shadow-xl shadow-slate-200/50 border border-slate-100 overflow-hidden hover:shadow-2xl hover:-translate-y-1.5 transition-all duration-300 group flex flex-col ${index === 4 ? 'sm:col-span-2 lg:col-span-1' : ''}`}
                >
                    <div class="h-36 overflow-hidden relative">
                        <div class="absolute inset-0 bg-blue-950/20 group-hover:bg-blue-950/0 transition-colors z-10"></div>
                        <Image
                            src={card.image}
                            alt={card.cardTitle}
                            width={600}
                            height={360}
                            class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
                        />
                    </div>
                    <div class="p-5 flex-1 flex flex-col justify-between gap-4">
                        <div>
                            <!-- Título cambia a amarillo en hover -->
                            <h3 class="font-bold text-slate-900 text-base mb-1 group-hover:text-tyta-amber transition-colors duration-300">
                                {card.cardTitle}
                            </h3>
                            <p class="text-xs text-slate-500 leading-relaxed">{card.cardShort}</p>
                        </div>
                        <!-- Texto 'Ver detalle' y flecha en color amarillo (text-tyta-amber) al hacer hover -->
                        <span class="inline-flex items-center gap-1.5 text-xs font-bold text-tyta-amber opacity-0 -translate-y-1 group-hover:opacity-100 group-hover:translate-y-0 group-hover:gap-2.5 transition-all duration-300">
                            {L('Ver detalle', 'See details')}
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                        </span>
                    </div>
                </a>
            ))}
        </div>
    </section>

    <!-- Secciones Detalladas -->
    {areas.map((area, index) => {
        const reverse = index % 2 === 1;
        return (
            <section id={area.id} class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-b border-slate-200/60 scroll-mt-24 reveal-on-scroll">
                <div class="grid lg:grid-cols-12 gap-10 items-center">
                    <div class={`lg:col-span-7 space-y-6 ${reverse ? 'lg:order-2' : ''}`}>
                        <div class={`inline-flex items-center px-3 py-1 rounded-full text-xs font-bold tracking-widest uppercase border ${area.theme.badge}`}>
                            {area.badge}
                        </div>
                        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
                            {area.title}
                        </h2>
                        <p class="text-slate-600 leading-relaxed">
                            {area.intro}
                        </p>
                        <div class="pt-2">
                            <p class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-3">
                                {L('Qué incluye', 'What it covers')}
                            </p>
                            <div class="grid sm:grid-cols-2 gap-4">
                                {area.services.map((service) => (
                                    <div class={`bg-white p-5 rounded-2xl border border-slate-200 shadow-sm transition-all ${area.theme.hover}`}>
                                        <div class="flex items-start gap-3">
                                            <span class={`mt-0.5 shrink-0 w-6 h-6 rounded-full flex items-center justify-center ${area.theme.check}`}>
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                                            </span>
                                            <div>
                                                <h4 class="font-bold text-slate-900 text-sm mb-1">{service.title}</h4>
                                                <p class="text-xs text-slate-500 leading-relaxed">{service.desc}</p>
                                            </div>
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </div>
                    </div>

                    <div class={`lg:col-span-5 ${reverse ? 'lg:order-1' : ''}`}>
                        <div class={`relative bg-gradient-to-br ${area.theme.panel} text-white rounded-3xl shadow-xl overflow-hidden border`}>
                            <div class="relative h-44 sm:h-52 overflow-hidden group">
                                <Image
                                    src={area.image}
                                    alt={area.cardTitle}
                                    width={800}
                                    height={420}
                                    class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-700"
                                />
                                <div class={`absolute inset-0 bg-gradient-to-t ${area.theme.fade} pointer-events-none`}></div>
                            </div>
                            <div class="relative px-8 pb-8 -mt-4">
                                <h3 class="text-xl font-bold mb-4">{area.panelTitle}</h3>
                                <ul class="space-y-3 text-sm text-slate-200">
                                    {area.panelItems.map((item) => (
                                        <li class="flex items-start gap-3">
                                            <span class={`mt-0.5 shrink-0 w-5 h-5 rounded-full flex items-center justify-center ${area.theme.dot}`}>
                                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                                            </span>
                                            <span>{item}</span>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        );
    })}

    <!-- Gestión de Talento -->
    <section id={talent.id} class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 scroll-mt-24 reveal-on-scroll">
        <div class="grid lg:grid-cols-12 gap-12 items-center">
            <div class="lg:col-span-7 space-y-8">
                <div>
                    <div class="inline-flex items-center gap-2 bg-tyta-amber/10 text-tyta-amber px-3 py-1 rounded-full text-xs font-bold tracking-widest uppercase mb-3 border border-tyta-amber/20">
                        {talent.badge}
                    </div>
                    <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
                        {talent.title}
                    </h2>
                    <p class="text-slate-600 mt-4 leading-relaxed text-base">
                        {talent.intro}
                    </p>
                </div>

                <div class="grid sm:grid-cols-2 gap-5">
                    {talent.steps.map((step, index) => {
                        const isBlue = index % 2 === 0;
                        return (
                            <div class={`relative bg-white p-7 rounded-3xl border border-slate-200/80 shadow-md shadow-slate-100 hover:shadow-xl transition-all duration-300 group overflow-hidden ${isBlue ? 'hover:border-tyta-blue/40' : 'hover:border-tyta-amber/50'}`}>
                                <div class={`absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r opacity-0 group-hover:opacity-100 transition-opacity ${isBlue ? 'from-tyta-blue to-cyan-500' : 'from-tyta-amber to-amber-400'}`}></div>
                                <div class={`w-12 h-12 rounded-2xl flex items-center justify-center font-extrabold text-base mb-5 group-hover:scale-110 transition-transform ${isBlue ? 'bg-tyta-blue/10 text-tyta-blue' : 'bg-tyta-amber/10 text-tyta-amber'}`}>
                                    {`0${index + 1}`}
                                </div>
                                <h4 class="font-extrabold text-slate-900 text-lg mb-2">{step.title}</h4>
                                <p class="text-sm text-slate-600 leading-relaxed">{step.desc}</p>
                            </div>
                        );
                    })}
                </div>
            </div>

            <!-- Tarjeta de Garantía de Calidad -->
            <div class="lg:col-span-5">
                <div class="relative bg-gradient-to-br from-[#060b19] via-[#0b132b] to-[#00529B] text-white rounded-3xl shadow-2xl overflow-hidden border border-white/10">
                    <div class="relative h-44 sm:h-52 overflow-hidden group">
                        <Image
                            src={talent.image}
                            alt={talent.cardTitle}
                            width={800}
                            height={420}
                            class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-700"
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-[#060b19] via-[#060b19]/60 to-transparent pointer-events-none"></div>
                    </div>
                    <div class="relative px-8 pb-8 -mt-4 z-10">
                        <h3 class="text-2xl sm:text-3xl font-extrabold mb-3 text-white tracking-tight">
                            {L('Garantía de Calidad', 'Quality Assurance')}
                        </h3>
                        <p class="text-slate-300 text-sm leading-relaxed">
                            {L(
                                'Nuestro propósito fundamental es asegurar la excelencia operativa mediante métricas, controles rigurosos y evaluación continua.',
                                'Our primary objective is to guarantee service excellence through metrics, strict controls, and continuous evaluation.'
                            )}
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Final Moderno -->
    <section class="bg-white py-20 px-4 mt-8 border-t border-slate-200/60 reveal-on-scroll">
        <div class="max-w-4xl mx-auto text-center">

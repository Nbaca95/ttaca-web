---
// src/components/pages/services/ItOutsourcingPage.astro
import { getLocaleFromUrl, getTranslations, localizedPath } from "../../../i18n";

const locale = getLocaleFromUrl(Astro.url);
const t = getTranslations(locale);
const content = t.servicesPages.itOutsourcing;
const contactHref = localizedPath(locale, "/contact");
---

<main>
    <!-- Hero Section -->
    <section class="relative bg-gradient-to-r from-slate-900 to-blue-900 py-20 px-4 text-white overflow-hidden">
        <div class="absolute inset-0 bg-[url('/assets/content.png')] opacity-10"></div>
        <div class="relative max-w-5xl mx-auto text-center">
            <span class="text-tyta-amber font-semibold tracking-wider uppercase text-sm">{content.hero.eyebrow}</span>
            <h1 class="text-4xl md:text-6xl font-bold text-white mt-4 mb-6">{content.hero.title}</h1>
            <p class="text-xl text-slate-300 max-w-3xl mx-auto">
                {content.hero.intro}
            </p>
        </div>
    </section>

    <!-- Propuesta de Valor -->
    <section class="max-w-6xl mx-auto px-4 py-20">
        <div class="grid md:grid-cols-2 gap-16 items-center">
            <div>
                <h2 class="text-3xl font-bold text-slate-900 mb-6">{content.valueProp.title}</h2>
                <p class="text-slate-600 mb-6 leading-relaxed">
                    {content.valueProp.text}
                </p>
                <div class="space-y-4">
                    {content.valueProp.features.map((feature) => (
                        <div class="flex gap-4">
                            <span class="text-tyta-amber text-2xl">{feature.icon}</span>
                            <div>
                                <h4 class="font-bold text-slate-900">{feature.title}</h4>
                                <p class="text-sm text-slate-600">{feature.desc}</p>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
            <div class="bg-slate-50 p-10 rounded-2xl border border-slate-200">
                <h3 class="text-xl font-bold mb-6">{content.benefits.title}</h3>
                <ul class="space-y-4">
                    {content.benefits.items.map((item) => (
                        <li class="flex items-center gap-3 text-slate-700">
                            <span class="bg-tyta-amber/10 text-tyta-amber rounded-full p-1">✓</span>
                            {item}
                        </li>
                    ))}
                </ul>
            </div>
        </div>
    </section>

    <!-- CTA Final -->
    <section class="bg-slate-100 py-16 px-4">
        <div class="max-w-4xl mx-auto text-center">
            <h2 class="text-3xl font-bold text-slate-900 mb-6">{content.finalCta.title}</h2>
            <p class="text-slate-600 mb-8">{content.finalCta.text}</p>
            <div class="flex justify-center gap-4">
                <a href={contactHref} class="bg-tyta-blue text-white px-8 py-3 rounded font-bold hover:bg-blue-800 transition-colors">
                    {content.finalCta.buttonLabel}
                </a>
            </div>
        </div>
    </section>
</main>
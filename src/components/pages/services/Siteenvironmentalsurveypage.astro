---
// src/components/pages/services/SiteEnvironmentalSurveyPage.astro
import { getLocaleFromUrl, getTranslations, localizedPath } from "../../../i18n";

const locale = getLocaleFromUrl(Astro.url);
const t = getTranslations(locale);
const content = t.servicesPages.siteEnvironmentalSurvey;
const contactHref = localizedPath(locale, "/contact");
---

<main class="py-16 px-4 max-w-4xl mx-auto">
    <h1 class="text-4xl font-bold mb-8">{content.title}</h1>
    <div class="prose lg:prose-xl">
        <p>{content.intro}</p>
        <ul class="list-disc pl-6 space-y-4">
            {content.items.map((item) => (
                <li><strong>{item.label}</strong> {item.desc}</li>
            ))}
        </ul>
    </div>
    <div class="mt-12 p-6 bg-blue-900 text-white rounded-lg">
        <h3 class="font-bold">{content.cta.title}</h3>
        <a href={contactHref} class="text-tyta-amber underline font-bold">{content.cta.linkLabel}</a>
    </div>
</main>
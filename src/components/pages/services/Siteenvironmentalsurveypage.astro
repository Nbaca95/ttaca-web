---
// src/components/pages/services/SiteEnvironmentalSurveyPage.astro
import { Image } from "astro:assets";
import { getLocaleFromUrl, getTranslations, localizedPath } from "../../../i18n";
import heroBg from "../../../assets/images/site-survey.jpg";
import bgCircuit from "../../../assets/content.png";

const locale = getLocaleFromUrl(Astro.url);
const isEn = locale === "en";
const t = getTranslations(locale);
const content = t.servicesPages.siteEnvironmentalSurvey;
const contactHref = localizedPath(locale, "/contact");

const pageData = isEn
    ? {
          badge: "Specialized Infrastructure Engineering",
          heroTitle: content.title || "Site Environmental Survey",
          heroSubtitle:
              content.intro ||
              "Comprehensive physical, electrical, thermal, and structural assessment of Data Centers and server rooms to guarantee mission-critical availability and manufacturer compliance.",
          primaryCta: "Schedule a Technical Survey",
          overviewBadge: "Why Conduct a Site Survey?",
          overviewTitle: "Preventing Critical Failures Before Installation or Expansion",
          overviewText:
              "Before deploying enterprise servers, high-density storage arrays, or hyperconverged infrastructure, certifying the physical environment is essential. Our Site Environmental Survey identifies hidden electrical, cooling, structural, and safety risks that could void manufacturer warranties or cause unplanned downtime.",
          highlights: [
              {
                  metric: "100%",
                  label: "Standards Compliance",
                  detail: "Aligned with TIA-942, ASHRAE TC 9.9, and NFPA guidelines.",
              },
              {
                  metric: "24/7",
                  label: "Operational Continuity",
                  detail: "Detection of single points of failure in power and cooling.",
              },
              {
                  metric: "OEM",
                  label: "Warranty Readiness",
                  detail: "Pre-installation verification required by HPE, Dell, and Lenovo.",
              },
          ],
          pillarsBadge: "Technical Inspection Domains",
          pillarsTitle: "What We Audit in Your Data Center or IDF/MDF Room",
          pillarsSubtitle:
              "Every evaluation is performed on-site by certified field engineers using calibrated measurement instruments.",
          pillars: [
              {
                  title: "Electrical Power & Grounding",
                  desc: "Verification of dedicated circuits, PDU/UPS capacity, phase balancing, voltage stability, neutral-to-ground readings (< 2V), and dedicated physical grounding systems.",
                  icon: "bolt",
              },
              {
                  title: "HVAC & Thermal Management",
                  desc: "Measurement of ambient temperature, relative humidity, dew point, BTU thermal load capacity, cold/hot aisle airflow distribution, and air conditioning redundancy.",
                  icon: "thermometer",
              },
              {
                  title: "Physical Space, Access & Routing",
                  desc: "Evaluation of rack clearances (front/rear service corridors), door dimensions, freight elevator load limits, raised floor load capacity, and structured cabling pathways.",
                  icon: "layout",
              },
              {
                  title: "Fire Suppression & Environmental Safety",
                  desc: "Inspection of clean-agent fire suppression systems, early smoke detection, water leak sensors, humidity control, and dust/particulate contamination levels.",
                  icon: "shield",
              },
              {
                  title: "Connectivity & Rack Readiness",
                  desc: "Audit of copper/fiber patch panels, rack U-space availability, vertical/horizontal cable management, dual-power A/B feeds, and out-of-band management ports.",
                  icon: "network",
              },
              {
                  title: "Risk Mitigation & Remediation Plan",
                  desc: "Prioritized executive and engineering report detailing critical findings, photographic evidence, compliance gaps, and actionable corrective recommendations.",
                  icon: "clipboard",
              },
          ],
          processBadge: "Methodology",
          processTitle: "Our 4-Phase Assessment Process",
          processSteps: [
              {
                  step: "1",
                  title: "Pre-Visit Discovery",
                  desc: "Review of architectural blueprints, single-line electrical diagrams, and target hardware specifications.",
              },
              {
                  step: "2",
                  title: "On-Site Instrumentation & Audit",
                  desc: "Physical inspection and precision measurements across electrical panels, HVAC units, racks, and access routes.",
              },
              {
                  step: "3",
                  title: "Engineering Analysis & Gap Matrix",
                  desc: "Comparison of collected metrics against international Data Center standards and OEM environmental requirements.",
              },
              {
                  step: "4",
                  title: "Executive Report & Roadmap",
                  desc: "Delivery of a certified technical dossier with remediation priorities before equipment delivery or migration.",
              },
          ],
          deliverablesBadge: "Final Documentation",
          deliverablesTitle: "What You Receive Upon Completion",
          deliverables: [
              "Certified Site Environmental Survey Report with pass/fail checklists per subsystem.",
              "Electrical load, grounding verification, and thermal dissipation measurements.",
              "Annotated photographic record of racks, pathways, power panels, and risk zones.",
              "Prioritized corrective action plan (Critical, High, and Preventive recommendations).",
          ],
          ctaBadge: "Ready to Certify Your Infrastructure?",
          ctaTitle: content.cta?.title || "Ensure Your Site Meets Every Technical Requirement",
          ctaSubtitle:
              "Avoid installation delays, hardware damage, and warranty issues with an on-site evaluation by our specialized engineers.",
          ctaButton: content.cta?.linkLabel || "Request a Site Survey",
      }
    : {
          badge: "Ingeniería Especializada de Infraestructura",
          heroTitle: "Evaluación Ambiental y de Infraestructura",
          heroSubtitle:
              "Revisión integral de condiciones físicas, eléctricas, térmicas y estructurales en Data Centers y cuartos de servidores para garantizar alta disponibilidad y cumplimiento con los fabricantes.",
          primaryCta: "Agendar Evaluación Técnica",
          overviewBadge: "¿Por qué realizar esta evaluación?",
          overviewTitle: "Prevenga fallas críticas antes de instalar o expandir su infraestructura",
          overviewText:
              "Antes de desplegar servidores empresariales, arreglos de almacenamiento de alta densidad o soluciones hiperconvergentes, es indispensable evaluar y certificar el entorno físico del sitio. Esta inspección detecta riesgos ocultos en energía, climatización, espacio y seguridad que pueden comprometer la garantía del fabricante o provocar caídas no planificadas.",
          highlights: [
              {
                  metric: "100%",
                  label: "Cumplimiento Normativo",
                  detail: "Alineado con estándares TIA-942, ASHRAE TC 9.9 y normativas NFPA.",
              },
              {
                  metric: "24/7",
                  label: "Continuidad Operativa",
                  detail: "Identificación de puntos únicos de falla en energía y enfriamiento.",
              },
              {
                  metric: "OEM",
                  label: "Respaldo de Garantía",
                  detail: "Validación previa exigida por fabricantes como HPE, Dell y Lenovo.",
              },
          ],
          pillarsBadge: "Áreas de Inspección Técnica",
          pillarsTitle: "Qué evaluamos en su Data Center o cuarto de comunicaciones",
          pillarsSubtitle:
              "Cada inspección es ejecutada en sitio por ingenieros de campo especializados utilizando instrumentos de medición calibrados.",
          pillars: [
              {
                  title: "Energía Eléctrica y Puesta a Tierra",
                  desc: "Verificación de circuitos dedicados, capacidad de UPS y PDU, balanceo de fases, estabilidad de voltaje, medición neutro-tierra (< 2V) y malla de tierra física dedicada.",
                  icon: "bolt",
              },
              {
                  title: "Climatización (HVAC) y Carga Térmica",
                  desc: "Medición de temperatura ambiente, humedad relativa, punto de rocío, capacidad térmica en BTU, flujo de aire en pasillos fríos/calientes y redundancia de aires de precisión.",
                  icon: "thermometer",
              },
              {
                  title: "Espacio Físico, Accesos y Rutas",
                  desc: "Evaluación de despejes frontales y posteriores de racks, dimensiones de puertas, capacidad de montacargas, resistencia de piso falso y canalizaciones de cableado.",
                  icon: "layout",
              },
              {
                  title: "Supresión de Incendios y Seguridad Ambiental",
                  desc: "Revisión de sistemas de extinción con agente limpio, detección temprana de humo, sensores de filtración de agua, control de humedad y niveles de polvo o partículas.",
                  icon: "shield",
              },
              {
                  title: "Conectividad y Preparación de Racks",
                  desc: "Auditoría de patch panels de cobre y fibra óptica, disponibilidad de unidades de rack (U), ordenadores de cableado, redundancia eléctrica A/B y puertos de gestión remota.",
                  icon: "network",
              },
              {
                  title: "Análisis de Riesgos y Plan de Remediación",
                  desc: "Informe ejecutivo y técnico priorizado con hallazgos críticos, evidencia fotográfica, brechas de cumplimiento y recomendaciones correctivas accionables.",
                  icon: "clipboard",
              },
          ],
          processBadge: "Metodología",
          processTitle: "Nuestro proceso de evaluación en 4 fases",
          processSteps: [
              {
                  step: "1",
                  title: "Revisión Documental Previa",
                  desc: "Análisis de planos arquitectónicos, diagramas unifilares eléctricos y especificaciones del equipamiento a instalar.",
              },
              {
                  step: "2",
                  title: "Inspección y Medición en Sitio",
                  desc: "Levantamiento físico y mediciones de precisión en tableros eléctricos, unidades HVAC, racks y rutas de ingreso.",
              },
              {
                  step: "3",
                  title: "Análisis de Ingeniería y Brechas",
                  desc: "Contraste de los parámetros obtenidos frente a estándares internacionales y requisitos ambientales del fabricante.",
              },
              {
                  step: "4",
                  title: "Informe Técnico y Hoja de Ruta",
                  desc: "Entrega del dossier técnico con prioridades de adecuación antes de la recepción o migración de los equipos.",
              },
          ],
          deliverablesBadge: "Documentación Final",
          deliverablesTitle: "Entregables que recibe su empresa",
          deliverables: [
              "Informe técnico de evaluación del sitio con listas de verificación por subsistema.",
              "Registro de mediciones eléctricas, verificación de tierra física y disipación térmica.",
              "Memoria fotográfica anotada de racks, canalizaciones, tableros eléctricos y zonas críticas.",
              "Plan de acción correctivo priorizado (hallazgos críticos, altos y recomendaciones preventivas).",
          ],
          ctaBadge: "¿Listo para certificar su sala técnica?",
          ctaTitle: "Asegure que su sitio cumpla con cada requisito técnico",
          ctaSubtitle:
              "Evite retrasos en implementaciones, daños en equipamiento y pérdida de garantías con una inspección profesional en sitio.",
          ctaButton: content.cta?.linkLabel || "Solicitar Evaluación del Sitio",
      };
---

<style>
    .reveal {
        opacity: 0;
        transform: translateY(28px);
        transition: opacity 0.75s ease-out, transform 0.75s ease-out;
    }
    .reveal.active {
        opacity: 1;
        transform: translateY(0);
    }

    .survey-hero-bg {
        object-position: right center;
        transform: translateX(8%) scale(1.06);
    }
    @media (min-width: 1024px) {
        .survey-hero-bg {
            transform: translateX(14%) scale(1.06);
        }
    }
</style>

<main class="bg-white text-slate-900 overflow-hidden">
    <!-- Hero Full-Width -->
    <section class="relative min-h-[540px] lg:min-h-[600px] flex items-center bg-[#060b19] text-white overflow-hidden">
        <Image
            src={heroBg}
            alt={pageData.heroTitle}
            width={1920}
            height={1080}
            class="survey-hero-bg absolute inset-0 w-full h-full object-cover opacity-55"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-[#060b19] via-[#0b132b]/85 to-[#0b132b]/35"></div>
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_75%_30%,rgba(242,142,43,0.14),transparent_55%)] pointer-events-none"></div>

        <div class="relative z-10 max-w-7xl mx-auto px-6 py-24 w-full">
            <div class="max-w-3xl">
                <span class="inline-block px-6 py-2 mb-6 text-xs font-extrabold uppercase tracking-widest bg-blue-500/10 backdrop-blur-md text-sky-400 rounded-full border border-blue-400/30 shadow-md">
                    {pageData.badge}
                </span>

                <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.1] mb-6 drop-shadow-sm">
                    {pageData.heroTitle}
                </h1>

                <p class="text-lg sm:text-xl text-slate-200 leading-relaxed mb-10 max-w-2xl">
                    {pageData.heroSubtitle}
                </p>

                <div class="flex flex-wrap items-center gap-4">
                    <a
                        href={contactHref}
                        class="group inline-flex items-center justify-center bg-tyta-amber text-slate-950 text-sm font-bold uppercase tracking-wider px-8 py-4 rounded-full shadow-[0_6px_25px_rgba(242,142,43,0.35)] hover:shadow-[0_10px_32px_rgba(242,142,43,0.5)] hover:-translate-y-0.5 transition-all duration-300"
                    >
                        <span>{pageData.primaryCta}</span>
                        <svg class="w-4 h-4 ml-2.5 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Resumen Ejecutivo y Métricas Clave -->
    <section class="py-20 bg-slate-50 border-b border-slate-200/70">
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid lg:grid-cols-12 gap-12 items-center">
                <div class="reveal lg:col-span-7">
                    <span class="inline-block px-5 py-1.5 mb-4 text-xs font-extrabold uppercase tracking-widest bg-blue-50 text-tyta-blue rounded-full border border-blue-100 shadow-sm">
                        {pageData.overviewBadge}
                    </span>
                    <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-5">
                        {pageData.overviewTitle}
                    </h2>
                    <p class="text-slate-600 text-base sm:text-lg leading-relaxed">
                        {pageData.overviewText}
                    </p>
                </div>

                <div class="reveal lg:col-span-5 grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-1 gap-4">
                    {pageData.highlights.map((item) => (
                        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm flex items-center gap-5 hover:border-tyta-amber/60 transition-colors">
                            <div class="min-w-[84px] text-center py-2.5 px-3 rounded-xl bg-slate-900 text-tyta-amber font-extrabold text-2xl tracking-tight">
                                {item.metric}
                            </div>
                            <div>
                                <h3 class="font-bold text-slate-900 text-base">{item.label}</h3>
                                <p class="text-xs sm:text-sm text-slate-500 mt-0.5 leading-snug">{item.detail}</p>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </section>

    <!-- Áreas de Inspección Técnica -->
    <section id="alcance-tecnico" class="relative py-24 bg-gradient-to-b from-[#060b19] via-[#0b132b] to-[#111d42] text-white overflow-hidden">
        <div class="absolute inset-0 z-0 pointer-events-none">
            <div
                class="absolute inset-0 bg-repeat opacity-[0.09] mix-blend-overlay"
                style={`background-image: url(${bgCircuit.src}); background-size: 450px;`}
            ></div>
            <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[760px] h-[280px] bg-tyta-amber/10 rounded-full blur-3xl"></div>
        </div>

        <div class="relative z-10 max-w-7xl mx-auto px-6">
            <div class="reveal text-center max-w-3xl mx-auto mb-16">
                <span class="inline-block px-6 py-2 mb-4 text-xs font-extrabold uppercase tracking-widest bg-slate-800/90 text-tyta-amber rounded-full border border-slate-700 shadow-md">
                    {pageData.pillarsBadge}
                </span>
                <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-4">
                    {pageData.pillarsTitle}
                </h2>
                <p class="text-slate-300 text-base sm:text-lg leading-relaxed">
                    {pageData.pillarsSubtitle}
                </p>
            </div>

            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                {pageData.pillars.map((pillar, index) => (
                    <div
                        class="reveal relative overflow-hidden bg-slate-900/75 backdrop-blur-md p-8 md:p-9 rounded-3xl border border-slate-700/70 border-t-2 border-t-tyta-amber/50 hover:border-tyta-amber hover:shadow-[0_20px_45px_rgba(0,0,0,0.45)] hover:-translate-y-1.5 transition-all duration-300 flex flex-col group"
                        style={`transition-delay: ${(index % 3) * 90}ms`}
                    >
                        <div class="absolute inset-x-0 top-0 h-24 bg-gradient-to-b from-tyta-amber/10 to-transparent opacity-60 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>

                        <div class="relative z-10 text-tyta-amber mb-5 transform group-hover:-translate-y-1 group-hover:scale-105 transition-all duration-300">
                            {pillar.icon === "bolt" && (
                                <svg class="w-9 h-9" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                    <path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z" />
                                </svg>
                            )}
                            {pillar.icon === "thermometer" && (
                                <svg class="w-9 h-9" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                    <path d="M14 4v10.54a4 4 0 1 1-4 0V4a2 2 0 0 1 4 0Z" />
                                </svg>
                            )}
                            {pillar.icon === "layout" && (
                                <svg class="w-9 h-9" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                    <rect width="18" height="18" x="3" y="3" rx="2" />
                                    <path d="M3 9h18" />
                                    <path d="M9 21V9" />
                                </svg>
                            )}
                            {pillar.icon === "shield" && (
                                <svg class="w-9 h-9" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                    <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
                                    <path d="m9 12 2 2 4-4" />
                                </svg>
                            )}
                            {pillar.icon === "network" && (
                                <svg class="w-9 h-9" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                    <rect x="16" y="16" width="6" height="6" rx="1" />
                                    <rect x="2" y="16" width="6" height="6" rx="1" />
                                    <rect x="9" y="2" width="6" height="6" rx="1" />
                                    <path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3" />
                                    <path d="M12 12V8" />
                                </svg>
                            )}
                            {pillar.icon === "clipboard" && (
                                <svg class="w-9 h-9" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                    <rect width="8" height="4" x="8" y="2" rx="1" ry="1" />
                                    <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
                                    <path d="m9 14 2 2 4-4" />
                                </svg>
                            )}
                        </div>

                        <h3 class="relative z-10 text-xl font-bold text-white mb-3 group-hover:text-tyta-amber transition-colors">
                            {pillar.title}
                        </h3>
                        <p class="relative z-10 text-sm text-slate-300 leading-relaxed flex-grow">
                            {pillar.desc}
                        </p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Metodología de 4 Fases + Entregables -->
    <section class="py-24 bg-slate-50 text-slate-900 relative overflow-hidden">
        <div class="max-w-7xl mx-auto px-6">
            <div class="reveal text-center max-w-3xl mx-auto mb-16">
                <span class="inline-block px-5 py-1.5 mb-4 text-xs font-extrabold uppercase tracking-widest bg-blue-50 text-tyta-blue rounded-full border border-blue-100 shadow-sm">
                    {pageData.processBadge}
                </span>
                <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900">
                    {pageData.processTitle}
                </h2>
            </div>

            <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-20">
                {pageData.processSteps.map((item, index) => (
                    <div
                        class="reveal bg-white border border-slate-200/80 rounded-3xl p-7 shadow-sm hover:shadow-xl hover:border-tyta-amber/60 transition-all duration-300"
                        style={`transition-delay: ${index * 100}ms`}
                    >
                        <span class="inline-block text-xs font-extrabold tracking-widest px-3 py-1 rounded-full bg-slate-900 text-tyta-amber mb-5">
                            {isEn ? `PHASE ${item.step}` : `FASE ${item.step}`}
                        </span>
                        <h3 class="text-lg font-bold text-slate-900 mb-2.5">{item.title}</h3>
                        <p class="text-sm text-slate-600 leading-relaxed">{item.desc}</p>
                    </div>
                ))}
            </div>

            <!-- Bloque de Entregables y Puntos de i18n -->
            <div class="reveal bg-gradient-to-br from-slate-950 via-slate-900 to-blue-950 text-white border border-slate-800 rounded-3xl p-8 md:p-12 shadow-xl">
                <div class="grid lg:grid-cols-12 gap-10 items-start">
                    <div class="lg:col-span-5">
                        <span class="inline-block px-4 py-1.5 mb-4 text-xs font-extrabold uppercase tracking-widest bg-white/10 text-tyta-amber rounded-full border border-white/15">
                            {pageData.deliverablesBadge}
                        </span>
                        <h3 class="text-2xl sm:text-3xl font-extrabold text-white mb-4">
                            {pageData.deliverablesTitle}
                        </h3>
                        <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
                            {isEn
                                ? "Our engineering dossier gives IT managers, facilities teams, and auditors full visibility over site readiness before deployment."
                                : "Nuestro dossier de ingeniería brinda a gerentes de TI, equipos de infraestructura y auditores visibilidad completa sobre la preparación del sitio antes del despliegue."}
                        </p>
                    </div>

                    <div class="lg:col-span-7 space-y-4">
                        {pageData.deliverables.map((deliverable) => (
                            <div class="flex items-start gap-4 p-4 rounded-2xl bg-slate-900/80 border border-slate-800">
                                <span class="w-6 h-6 rounded-full bg-tyta-amber text-slate-950 flex items-center justify-center flex-shrink-0 mt-0.5">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" />
                                    </svg>
                                </span>
                                <span class="text-sm sm:text-base text-slate-200 leading-relaxed">{deliverable}</span>
                            </div>
                        ))}
                    </div>
                </div>

                {content.items && content.items.length > 0 && (
                    <div class="mt-8 pt-8 border-t border-white/10 grid grid-cols-1 md:grid-cols-3 gap-4">
                        {content.items.map((item) => (
                            <div class="p-5 rounded-2xl bg-slate-950/60 border border-slate-800/80">
                                <p class="text-xs font-bold uppercase tracking-wider text-tyta-amber mb-1.5">
                                    {item.label}
                                </p>
                                <p class="text-sm text-slate-300 leading-relaxed">{item.desc}</p>
                            </div>
                        ))}
                    </div>
                )}
            </div>
        </div>
    </section>

    <!-- CTA Final -->
    <section class="py-20 bg-white px-6 border-t border-slate-100">
        <div class="reveal max-w-4xl mx-auto bg-gradient-to-br from-slate-950 via-slate-900 to-blue-950 text-white rounded-3xl p-10 md:p-16 text-center shadow-2xl border border-slate-800 relative overflow-hidden">
            <div class="absolute -top-24 -right-24 w-72 h-72 bg-tyta-amber/15 rounded-full blur-3xl pointer-events-none"></div>

            <div class="relative z-10">
                <span class="inline-block px-4 py-1.5 mb-5 text-xs font-extrabold uppercase tracking-widest bg-white/10 text-tyta-amber rounded-full border border-white/15">
                    {pageData.ctaBadge}
                </span>
                <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-4">
                    {pageData.ctaTitle}
                </h2>
                <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto mb-9 leading-relaxed">
                    {pageData.ctaSubtitle}
                </p>

                <a
                    href={contactHref}
                    class="group inline-flex items-center justify-center bg-tyta-amber text-slate-950 text-sm font-bold uppercase tracking-wider px-9 py-4 rounded-full shadow-[0_6px_25px_rgba(242,142,43,0.35)] hover:shadow-[0_10px_32px_rgba(242,142,43,0.55)] hover:-translate-y-0.5 transition-all duration-300"
                >
                    <span>{pageData.ctaButton}</span>
                    <svg class="w-4 h-4 ml-2.5 transform group-hover:translate-x-1.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                </a>
            </div>
        </div>
    </section>
</main>

<script is:inline>
    const observer = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) entry.target.classList.add("active");
            });
        },
        { threshold: 0.1 }
    );

    document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
</script>
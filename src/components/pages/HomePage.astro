---
import Hero from "../Hero.astro";
import { getLocaleFromUrl, getTranslations, localizedPath } from "../../i18n";
import { Image } from 'astro:assets';
import noti1Img from "../../assets/images/Noti1.jpg";
import noti2Img from "../../assets/images/Noti2.jpg";
import noti3Img from "../../assets/images/Noti3.jpg";

// Imágenes de fondo de las tarjetas de servicios (mismo orden que t.homePage.services.items)
import servicio1Img from "../../assets/images/outsourcing.png";
import servicio2Img from "../../assets/images/consultoria.jpg";
import servicio3Img from "../../assets/images/soporte-hpe.jpg";
import servicio4Img from "../../assets/images/site-survey.jpg";

// -------------------------------------------------------------------------
// 1. LOGOS DE SOCIOS TECNOLÓGICOS (12 espacios configurados)
// Reemplaza las rutas "../../assets/images/..." por tus archivos reales
// -------------------------------------------------------------------------
import logoHpe from "../../assets/images/Hpe.jpg";
import logoVmware from "../../assets/images/Vmware.jpg";
import logoDell from "../../assets/images/Dell1.png";
import logoMicrosoft from "../../assets/images/Microsoft.jpg";
import logoVeeam from "../../assets/images/Veeam.jpg";
import logoSymantec from "../../assets/images/Symantec.png";
// 4 espacios adicionales para Socios Tecnológicos:
//import logoSocio9 from "../../assets/images/RECOPE.png";
//import logoSocio10 from "../../assets/images/INS.png";
//import logoSocio11 from "../../assets/images/RECOPE.png";
import Lenovo from "../../assets/images/Lenovo.png";

// -------------------------------------------------------------------------
// 2. LOGOS DE EMPRESAS QUE CONFÍAN EN NOSOTROS (10 espacios configurados)
// Reemplaza las rutas "../../assets/images/..." por tus archivos reales
// -------------------------------------------------------------------------
import logoRecope from "../../assets/images/RECOPE.png";
import logoIns from "../../assets/images/INS.png";
import logoLafise from "../../assets/images/Lafise.png";
import logoCCSS from "../../assets/images/ccss.png";
import logoBanpro from "../../assets/images/BANPRO.png";
import logoPopular from "../../assets/images/Popular.png";
import logoEvertec from "../../assets/images/Evertec.png";
// 4 espacios adicionales para Empresas que confían en nosotros:
import logoLiberty from "../../assets/images/Liberty.png";
import logoClaro from "../../assets/images/Claro.png";
import logoRegistro from "../../assets/images/Registro.png";
import logoIntel from "../../assets/images/Intel.png";
import logoHp from "../../assets/images/Hp.png";
import logoFIFCO from "../../assets/images/FIFCO.jpg";
import logoWalmart from "../../assets/images/Walmart.jpg";
import logoUCR from "../../assets/images/UCR.jpg";
import logoUNA from "../../assets/images/UNA.png";
import logoMarriot from "../../assets/images/Marriott.jpg";

const locale = getLocaleFromUrl(Astro.url);
const t = getTranslations(locale);
const contactHref = localizedPath(locale, "/contact");
const serviceHref = (slug: string) => localizedPath(locale, `/services/${slug}`);

const newsImages = [noti1Img, noti2Img, noti3Img];
const serviceImages = [servicio1Img, servicio2Img, servicio3Img, servicio4Img];

// Lista individual de Socios Tecnológicos
const partnerLogos = [
    { name: 'HPE', logo: logoHpe, colorClass: 'hover:border-[#01A982]/50' },
    { name: 'VMware', logo: logoVmware, colorClass: 'hover:border-[#607078]/50' },
    { name: 'Dell Technologies', logo: logoDell, colorClass: 'hover:border-[#007DB8]/50' },
    { name: 'Microsoft', logo: logoMicrosoft, colorClass: 'hover:border-[#00A4EF]/50' },
    { name: 'Veeam', logo: logoVeeam, colorClass: 'hover:border-[#00B259]/50' },
    { name: 'Symantec', logo: logoSymantec, colorClass: 'hover:border-[#FDBB30]/60' },
    
    // 4 nuevos espacios agregados:
    //{ name: 'Socio Tecnológico 9', logo: logoSocio9, colorClass: 'hover:border-tyta-blue/40' },
    //{ name: 'Socio Tecnológico 10', logo: logoSocio10, colorClass: 'hover:border-tyta-blue/40' },
    //{ name: 'Socio Tecnológico 11', logo: logoSocio11, colorClass: 'hover:border-tyta-blue/40' },
    { name: 'Lenovo', logo: Lenovo, colorClass: 'hover:border-[#E2231A]/50' },
];

// Lista individual de Empresas que confían en nosotros
const clientLogos = [
    { name: 'RECOPE', logo: logoRecope },
    { name: 'INS', logo: logoIns },
    { name: 'Banco LAFISE', logo: logoLafise },
    { name: 'CCSS', logo: logoCCSS },
    { name: 'BANPRO', logo: logoBanpro },
    { name: 'Banco Popular', logo: logoPopular },
    { name: 'EVERTEC', logo: logoEvertec },
    // 4 nuevos espacios agregados:
    { name: 'LIBERTY', logo: logoLiberty },
    { name: 'CLARO', logo: logoClaro },
    { name: 'Registro Nacional', logo: logoRegistro },
    { name: 'HP', logo: logoHp },
    { name: 'MARRIOTT', logo: logoMarriot },
    { name: 'FIFCO', logo: logoFIFCO },
    { name: 'WALMART', logo: logoWalmart },
    { name: 'UCR', logo: logoUCR },
    { name: 'UNA', logo: logoUNA },
    { name: 'INTEL', logo: logoIntel },
];
---

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

<style>
    .reveal {
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.8s ease-out, transform 0.8s ease-out;
    }
    .reveal.active {
        opacity: 1;
        transform: translateY(0);
    }

    .testimonials-swiper { 
        padding-bottom: 50px !important; 
    }
    .testimonials-swiper .swiper-pagination { 
        bottom: 0px !important; 
    }
    .testimonials-swiper .swiper-pagination-bullet {
        width: 10px;
        height: 10px;
        background: #cbd5e1;
        opacity: 1;
        transition: all 0.3s ease;
    }
    .testimonials-swiper .swiper-pagination-bullet-active {
        width: 28px;
        border-radius: 6px;
        background: #0f172a;
    }

    /* ---------- Carruseles continuos (Logos Partners & Clientes) ---------- */
    .logo-marquee-swiper .swiper-wrapper {
        transition-timing-function: linear !important;
    }

    .logo-marquee-mask {
        -webkit-mask-image: linear-gradient(to right, transparent, black 6%, black 94%, transparent);
        mask-image: linear-gradient(to right, transparent, black 6%, black 94%, transparent);
    }

    /* ---------- Tarjetas de servicios ---------- */
    .service-card {
        height: 320px;
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease, border-color 0.3s ease, height 0.3s ease;
    }

    .service-card:hover,
    .service-card:focus-visible {
        height: 400px;
        transform: translateY(-8px);
        z-index: 50;
    }

    /* Descripción: se despliega suavemente */
    .service-desc {
        display: grid;
        grid-template-rows: 0fr;
        transition: grid-template-rows 0.3s ease-out;
    }
    .service-card:hover .service-desc,
    .service-card:focus-visible .service-desc {
        grid-template-rows: 1fr;
    }

    /* Capa oscura extra al hacer hover para que el texto se lea bien */
    .service-overlay {
        opacity: 0;
        transition: opacity 0.3s ease-out;
    }
    .service-card:hover .service-overlay,
    .service-card:focus-visible .service-overlay {
        opacity: 1;
    }

    /* "Conocer más" + flecha */
    .service-footer {
        opacity: 0;
        transform: translateY(12px);
        pointer-events: none;
        transition: opacity 0.3s ease-out, transform 0.3s ease-out;
    }
    .service-card:hover .service-footer,
    .service-card:focus-visible .service-footer {
        opacity: 1;
        transform: translateY(0);
        pointer-events: auto;
    }

    /* Pantallas táctiles (no hay hover): mostrar todo el contenido siempre */
    @media (hover: none) {
        .service-card { height: 400px; }
        .service-desc { grid-template-rows: 1fr; }
        .service-overlay { opacity: 1; }
        .service-footer { opacity: 1; transform: none; pointer-events: auto; }
    }
</style>

<Hero />

<!-- Cifras -->
<section class="py-16 bg-tyta-dark text-white">
    <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 sm:grid-cols-3 gap-8 text-center">
        {t.homePage.stats.map((stat, index) => (
            <div class="reveal" style={`transition-delay: ${index * 100}ms`}>
                <div class="text-4xl md:text-5xl font-extrabold text-tyta-amber mb-2">
                    <span class="stat-counter" data-target={stat.target} data-prefix={stat.prefix}>{stat.prefix}0</span>
                </div>
                <div class="text-sm text-slate-300">{stat.label}</div>
            </div>
        ))}
    </div>
</section>

<!-- Sección de Servicios -->
<section class="py-24 bg-white text-slate-900 relative overflow-hidden">
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-tyta-blue/5 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-tyta-amber/5 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div class="reveal text-center max-w-3xl mx-auto mb-20">
            <span class="inline-block px-4 py-1.5 mb-4 text-sm font-bold tracking-widest uppercase bg-slate-100 text-tyta-blue rounded-full border border-slate-200">
                {locale === 'es' ? 'Nuestros Servicios y Soluciones' : 'Our Services and Solutions'}
            </span>
            <p class="text-slate-600 text-lg leading-relaxed mt-2">
                {locale === 'es' ? 'Infraestructura, soporte y consultoría para su empresa.' : 'Infrastructure, support and consultancy for your company.'}
            </p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 items-start">
            {t.homePage.services.items.map((service, index) => (
                <a
                    href={serviceHref(service.slug)}
                    class="reveal service-card group relative block bg-slate-900 text-white rounded-3xl border border-white/10 hover:border-tyta-amber/50 shadow-[0_20px_40px_rgba(15,23,42,0.25)] overflow-hidden"
                    style={`transition-delay: ${index * 120}ms`}
                >
                    <!-- Imagen de fondo -->
                    {serviceImages[index] && (
                        <Image
                            src={serviceImages[index]}
                            alt=""
                            width={640}
                            height={800}
                            class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-110"
                        />
                    )}

                    <!-- Capa base: oscurece un poco la imagen para que el título se lea -->
                    <div class="absolute inset-0 bg-gradient-to-b from-slate-950/20 via-slate-950/40 to-slate-950/60"></div>
                    <!-- Capa extra que aparece en hover -->
                    <div class="service-overlay absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/80 to-slate-950/40"></div>

                    <!-- Contenido centrado -->
                    <div class="relative z-10 h-full flex flex-col items-center justify-center text-center px-8">
                        <!-- Título en blanco por defecto y amarillo al hacer hover -->
                        <h3 class="text-xl font-bold text-white drop-shadow-lg group-hover:text-tyta-amber transition-colors duration-200">
                            {service.title}
                        </h3>

                        <div class="service-desc w-full">
                            <div class="overflow-hidden">
                                <p class="text-sm text-slate-200 mt-4 leading-relaxed pt-1">
                                    {service.description}
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Conocer más + flecha (solo en hover) -->
                    <div class="service-footer absolute left-8 right-8 bottom-8 z-10 pt-5 border-t border-white/15 flex items-center justify-between">
                        <span class="text-xs font-bold uppercase tracking-wider text-tyta-amber">
                            {t.homePage.services.ctaLabel || (locale === 'es' ? 'Ver detalles' : 'View details')}
                        </span>
                        <span class="w-8 h-8 rounded-full bg-tyta-amber text-slate-950 flex items-center justify-center group-hover:translate-x-1 transition-transform duration-200">
                            →
                        </span>
                    </div>
                </a>
            ))}
        </div>
    </div>
</section>

<!-- Partners Tecnológicos (Carrusel Continuo con Logos) -->
<section class="py-24 bg-gradient-to-b from-slate-50 via-slate-50/80 to-white border-t border-slate-100 overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 text-center">
        <div class="reveal max-w-2xl mx-auto">
            <span class="inline-block px-4 py-1.5 mb-4 text-xs font-bold tracking-widest uppercase bg-slate-100 text-tyta-blue rounded-full border border-slate-200/80 shadow-sm">
                {locale === 'es' ? 'Socios Tecnológicos' : 'Technology Partners'}
            </span>
            <p class="text-slate-600 text-lg mb-14">{t.homePage.partners.subtitle}</p>
        </div>

        <div class="reveal logo-marquee-mask py-4">
            <div class="partners-swiper logo-marquee-swiper swiper">
                <div class="swiper-wrapper items-center">
                    {partnerLogos.map((socio) => (
                        <div class="swiper-slide py-3">
                            <div
                                title={socio.name}
                                class={`group relative h-32 md:h-36 px-7 flex items-center justify-center border border-slate-200/70 rounded-3xl bg-white shadow-[0_8px_30px_rgb(15,23,42,0.04)] grayscale opacity-80 hover:grayscale-0 hover:opacity-100 ${socio.colorClass} transition-all duration-500 ease-out hover:-translate-y-1.5 hover:shadow-[0_18px_38px_rgb(15,23,42,0.09)] cursor-pointer`}
                            >
                                {socio.logo ? (
                                    <Image
                                        src={socio.logo}
                                        alt={socio.name}
                                        width={320}
                                        height={160}
                                        class="max-h-20 md:max-h-24 w-auto max-w-[85%] object-contain mix-blend-multiply transition-transform duration-500 ease-out group-hover:scale-105"
                                    />
                                ) : (
                                    <span class="font-bold text-slate-500 text-base">{socio.name}</span>
                                )}
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Clientes (Carrusel Continuo con Logos) -->
<section class="py-24 bg-white border-t border-slate-100/80 overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 text-center">
        <div class="reveal max-w-2xl mx-auto">
            <span class="inline-block px-4 py-1.5 mb-4 text-xs font-bold tracking-widest uppercase bg-slate-100 text-tyta-blue rounded-full border border-slate-200/80 shadow-sm">
                {locale === 'es' ? 'Empresas que confían en nosotros' : 'Trusted Companies'}
            </span>
            <p class="text-slate-600 text-lg mb-14">{t.homePage.clients.subtitle}</p>
        </div>

        <div class="reveal logo-marquee-mask py-4">
            <div class="clients-swiper logo-marquee-swiper swiper">
                <div class="swiper-wrapper items-center">
                    {clientLogos.map((cliente) => (
                        <div class="swiper-slide py-3">
                            <div
                                title={cliente.name}
                                class="group relative h-32 md:h-36 px-7 flex items-center justify-center border border-slate-200/70 rounded-3xl bg-white shadow-[0_8px_30px_rgb(15,23,42,0.04)] grayscale opacity-80 hover:grayscale-0 hover:opacity-100 hover:border-tyta-blue/35 transition-all duration-500 ease-out hover:-translate-y-1.5 hover:shadow-[0_18px_38px_rgb(15,23,42,0.09)] cursor-pointer"
                            >
                                {cliente.logo ? (
                                    <Image
                                        src={cliente.logo}
                                        alt={cliente.name}
                                        width={320}
                                        height={160}
                                        class="max-h-20 md:max-h-24 w-auto max-w-[85%] object-contain mix-blend-multiply transition-transform duration-500 ease-out group-hover:scale-105"
                                    />
                                ) : (
                                    <span class="text-center text-base font-bold text-slate-500">{cliente.name}</span>
                                )}
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Casos de Éxito / Testimonios -->
<section class="reveal py-24 bg-slate-50/50">
    <div class="max-w-7xl mx-auto px-6 text-center">
        <span class="inline-block px-4 py-1.5 mb-4 text-sm font-bold tracking-widest uppercase bg-slate-100 text-tyta-blue rounded-full border border-slate-200">
            {t.aboutPage.successStories.badge}
        </span>
        <p class="text-slate-500 mb-16 max-w-xl mx-auto">{t.aboutPage.successStories.subtitle}</p>
    </div>
    
    <div class="max-w-5xl mx-auto px-6 relative">
        <div class="testimonials-swiper swiper overflow-hidden">
            <div class="swiper-wrapper !flex !items-stretch">
                {t.aboutPage.successStories.testimonials.map((testimonio) => (
                    <div class="swiper-slide !h-auto p-3 flex">
                        <div class="w-full h-full flex flex-col justify-between bg-white p-8 md:p-10 rounded-3xl shadow-xl shadow-slate-200/50 border border-slate-100 text-left relative group hover:-translate-y-2 hover:shadow-2xl hover:shadow-slate-300/50 hover:border-tyta-amber transition-all duration-300">
                            <div>
                                <div class="flex items-center gap-1 text-amber-400 mb-6 text-lg">
                                    ★★★★★
                                </div>
                                <p class="text-slate-600 text-base md:text-lg mb-6 leading-relaxed italic">
                                    "{testimonio.text}"
                                </p>
                                {t.aboutPage.successStories.translatedNote && (
                                    <p class="text-xs text-slate-400 italic mb-6">{t.aboutPage.successStories.translatedNote}</p>
                                )}
                            </div>
                            <div class="border-t border-slate-100 pt-5 mt-auto flex items-center justify-between">
                                <div>
                                    <h4 class="font-bold text-slate-900 text-base">{testimonio.name}</h4>
                                    <p class="text-sm text-slate-500 font-medium">{testimonio.role}, <span class="text-slate-800">{testimonio.company}</span></p>
                                </div>
                                <div class="text-slate-200 text-5xl font-serif select-none group-hover:text-amber-400/30 transition-colors">”</div>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
            <div class="swiper-pagination !relative !bottom-0 mt-10"></div>
        </div>
    </div>
</section>

<!-- Noticias y Novedades -->
<section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-6">
        <div class="reveal text-center max-w-2xl mx-auto mb-16">
            <span class="inline-block px-4 py-1.5 mb-4 text-sm font-bold tracking-widest uppercase bg-slate-100 text-tyta-blue rounded-full border border-slate-200">
                {locale === 'es' ? 'Noticias y Novedades' : 'News & Updates'}
            </span>
            <p class="text-slate-600 text-lg">{t.homePage.news.subtitle}</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {newsImages.map((imgSrc, index) => (
                <article
                    class="reveal bg-slate-900 rounded-3xl border border-slate-800 shadow-xl shadow-slate-900/20 overflow-hidden hover:-translate-y-2 hover:shadow-2xl hover:border-tyta-amber transition-all duration-300 group flex flex-col"
                    style={`transition-delay: ${index * 120}ms`}
                >
                    <div class="w-full h-full relative overflow-hidden bg-slate-900">
                        <Image 
                            src={imgSrc} 
                            alt={`Noticia Redes T&TA ${index + 1}`}
                            class="w-full h-full object-cover block"
                        />
                    </div>
                </article>
            ))}
        </div>
    </div>
</section>

<!-- CTA Final -->
<section class="relative py-24 bg-gradient-to-br from-[#060b19] via-[#0b132b] to-[#111d42] text-white text-center overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(0,180,134,0.06),transparent_60%)] pointer-events-none"></div>
    
    <div class="reveal relative z-10 max-w-3xl mx-auto px-6">
        <span class="inline-block bg-white/10 backdrop-blur-md text-tyta-amber text-xs font-bold tracking-widest uppercase px-4 py-1.5 rounded-full border border-white/10 mb-6">
            {locale === 'es' ? 'Trabajemos juntos' : 'Let’s Work Together'}
        </span>
        <h2 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-6">{t.homePage.finalCta.title}</h2>
        <p class="text-base sm:text-lg text-slate-300 max-w-xl mx-auto mb-10 leading-relaxed">{t.homePage.finalCta.subtitle}</p>
        
        <a
            href={contactHref}
            class="group relative inline-flex items-center justify-center bg-tyta-amber text-slate-950 text-sm font-bold tracking-wider uppercase px-10 py-5 rounded-full overflow-hidden transition-all duration-300 shadow-[0_4px_25px_rgba(242,142,43,0.35)] hover:shadow-[0_6px_30px_rgba(242,142,43,0.5)] hover:-translate-y-0.5"
        >
            <span class="absolute inset-0 w-full h-full bg-gradient-to-r from-amber-400/0 via-white/40 to-amber-400/0 -translate-x-full group-hover:translate-x-full transition-transform duration-700 ease-out"></span>
            <span class="relative z-10 flex items-center gap-3">
                {t.homePage.finalCta.buttonLabel}
                <svg class="w-4 h-4 transform group-hover:translate-x-1.5 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
            </span>
        </a>
    </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" is:inline></script>
<script define:vars={{ numberLocale: locale === 'es' ? 'es-CR' : 'en-US' }} is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        // Carrusel continuo de Socios Tecnológicos
        new Swiper('.partners-swiper', {
            loop: true,
            speed: 3800,
            allowTouchMove: true,
            slidesPerView: 2,
            spaceBetween: 24,
            autoplay: {
                delay: 0,
                disableOnInteraction: false,
                pauseOnMouseEnter: true,
            },
            breakpoints: {
                640: { slidesPerView: 3, spaceBetween: 28 },
                768: { slidesPerView: 4, spaceBetween: 32 },
                1024: { slidesPerView: 5, spaceBetween: 36 },
            }
        });

        // Carrusel continuo de Clientes (en dirección opuesta)
        new Swiper('.clients-swiper', {
            loop: true,
            speed: 4200,
            allowTouchMove: true,
            slidesPerView: 2,
            spaceBetween: 24,
            autoplay: {
                delay: 0,
                reverseDirection: true,
                disableOnInteraction: false,
                pauseOnMouseEnter: true,
            },
            breakpoints: {
                640: { slidesPerView: 3, spaceBetween: 28 },
                768: { slidesPerView: 4, spaceBetween: 32 },
                1024: { slidesPerView: 5, spaceBetween: 36 },
            }
        });

        // Carrusel de Testimonios
        new Swiper('.testimonials-swiper', {
            loop: true, 
            slidesPerView: 1, 
            spaceBetween: 30, 
            autoHeight: false,
            breakpoints: { 
                768: { slidesPerView: 2 } 
            },
            pagination: { 
                el: '.swiper-pagination', 
                clickable: true 
            },
            autoplay: { 
                delay: 6000, 
                disableOnInteraction: false 
            }
        });

        const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) entry.target.classList.add('active');
            });
        }, { threshold: 0.1 });

        document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));

        const counterObserver = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                const el = entry.target;
                const target = parseInt(el.dataset.target, 10);
                const prefix = el.dataset.prefix || '';
                const duration = 1600;
                const startTime = performance.now();

                function tick(now) {
                    const progress = Math.min((now - startTime) / duration, 1);
                    const eased = 1 - Math.pow(1 - progress, 3);
                    const current = Math.floor(eased * target);
                    el.textContent = prefix + current.toLocaleString(numberLocale);
                    if (progress < 1) {
                        requestAnimationFrame(tick);
                    } else {
                        el.textContent = prefix + target.toLocaleString(numberLocale);
                    }
                }
                requestAnimationFrame(tick);
                counterObserver.unobserve(el);
            });
        }, { threshold: 0.5 });

        document.querySelectorAll('.stat-counter').forEach((el) => counterObserver.observe(el));
    });
</script>
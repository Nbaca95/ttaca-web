---
import Hero from "../Hero.astro";
import { getLocaleFromUrl, getTranslations, localizedPath } from "../../i18n";
import { Image } from 'astro:assets';
import noti1Img from "../../assets/images/Noti1.jpg";
import noti2Img from "../../assets/images/Noti2.jpg";
import noti3Img from "../../assets/images/Noti3.jpg";

const locale = getLocaleFromUrl(Astro.url);
const t = getTranslations(locale);
const contactHref = localizedPath(locale, "/contact");
const serviceHref = (slug: string) => localizedPath(locale, `/services/${slug}`);

const newsImages = [noti1Img, noti2Img, noti3Img];

const partnerLogos = [
    { name: 'Kaspersky', colorClass: 'hover:text-[#005B94]' },
    { name: 'VMware', colorClass: 'hover:text-[#607078]' },
    { name: 'Thales', colorClass: 'hover:text-[#00A3E0]' },
    { name: 'Microsoft', colorClass: 'hover:text-[#00A4EF]' },
    { name: 'Veeam', colorClass: 'hover:text-[#00B259]' },
    { name: 'Trend Micro', colorClass: 'hover:text-[#D71920]' },
    { name: 'Micro Focus', colorClass: 'hover:text-[#38C6F4]' },
    { name: 'Fortinet', colorClass: 'hover:text-[#EE3124]' },
];
---

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

<style>
    .reveal {
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.8s ease-out, transform 0.8s ease-out;
    }
    .reveal.active {
        opacity: 1;
        transform: translateY(0);
    }

    .testimonials-swiper { 
        padding-bottom: 50px !important; 
    }
    .testimonials-swiper .swiper-pagination { 
        bottom: 0px !important; 
    }
    .testimonials-swiper .swiper-pagination-bullet {
        width: 10px;
        height: 10px;
        background: #cbd5e1;
        opacity: 1;
        transition: all 0.3s ease;
    }
    .testimonials-swiper .swiper-pagination-bullet-active {
        width: 28px;
        border-radius: 6px;
        background: #0f172a;
    }

    /* Tarjetas con altura fija inicial para evitar empujar a las vecinas */
    .service-card {
        height: 320px;
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease, border-color 0.3s ease, height 0.3s ease;
    }

    .service-card:hover {
        height: 400px;
        transform: translateY(-8px);
        z-index: 50;
    }
</style>

<Hero />

<!-- Cifras -->
<section class="py-16 bg-tyta-dark text-white">
    <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 sm:grid-cols-3 gap-8 text-center">
        {t.homePage.stats.map((stat, index) => (
            <div class="reveal" style={`transition-delay: ${index * 100}ms`}>
                <div class="text-4xl md:text-5xl font-extrabold text-tyta-amber mb-2">
                    <span class="stat-counter" data-target={stat.target} data-prefix={stat.prefix}>{stat.prefix}0</span>
                </div>
                <div class="text-sm text-slate-300">{stat.label}</div>
            </div>
        ))}
    </div>
</section>

<!-- Sección de Servicios con Fondo Blanco y Tarjetas de Alto Impacto -->
<section class="py-24 bg-white text-slate-900 relative overflow-hidden">
    <!-- Elementos decorativos sutiles de fondo en tonos claros -->
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-tyta-blue/5 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-tyta-amber/5 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div class="reveal text-center max-w-3xl mx-auto mb-20">
            <span class="inline-block px-4 py-1.5 mb-4 text-xs font-semibold tracking-widest uppercase bg-slate-100 text-tyta-blue rounded-full border border-slate-200">
                {locale === 'es' ? 'Soluciones Tecnológicas Integrales' : 'Comprehensive Tech Solutions'}
            </span>
            <h2 class="text-4xl md:text-5xl font-extrabold mb-6 tracking-tight text-slate-900">{t.homePage.services.title}</h2>
            <p class="text-slate-600 text-lg leading-relaxed">{t.homePage.services.subtitle}</p>
        </div>
        
        <!-- Contenedor con Grid de Servicios con alineación superior para que la expansión hacia abajo sea limpia -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 items-start">
            {t.homePage.services.items.map((service, index) => (
                <a
                    href={serviceHref(service.slug)}
                    class="reveal service-card group relative flex flex-col items-center text-center justify-between p-8 bg-slate-900 text-white rounded-3xl border border-slate-800 hover:border-tyta-amber hover:shadow-[0_20px_40px_rgba(15,23,42,0.25)] overflow-hidden"
                    style={`transition-delay: ${index * 120}ms`}
                >
                    <!-- Efecto de brillo superior al hacer hover -->
                    <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-tyta-amber to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

                    <div class="w-full flex flex-col items-center">
                        <!-- Icono Centrado -->
                        <div class="w-16 h-16 rounded-2xl bg-slate-800 border border-slate-700 flex items-center justify-center text-3xl mb-6 transform group-hover:scale-110 group-hover:rotate-3 transition-transform duration-300 shadow-inner">
                            {service.icon}
                        </div>

                        <!-- Título Visible Siempre -->
                        <h3 class="text-xl font-bold text-white group-hover:text-tyta-amber transition-colors duration-200">
                            {service.title}
                        </h3>

                        <!-- Descripción Oculta al Inicio y Revelada en Hover -->
                        <div class="grid grid-rows-[0fr] group-hover:grid-rows-[1fr] transition-all duration-300 ease-out w-full">
                            <div class="overflow-hidden">
                                <p class="text-sm text-slate-300 mt-4 leading-relaxed pt-1">
                                    {service.description}
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Botón de Acción Oculto al Inicio y Revelado en Hover -->
                    <div class="w-full pt-6 mt-6 border-t border-slate-800/80 flex items-center justify-between opacity-0 translate-y-3 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-300 ease-out">
                        <span class="text-xs font-bold uppercase tracking-wider text-tyta-amber">
                            {t.homePage.services.ctaLabel || (locale === 'es' ? 'Ver detalles' : 'View details')}
                        </span>
                        <span class="w-8 h-8 rounded-full bg-slate-800 flex items-center justify-center text-tyta-amber border border-slate-700 group-hover:bg-tyta-amber group-hover:text-slate-950 transition-all duration-200">
                            →
                        </span>
                    </div>
                </a>
            ))}
        </div>
    </div>
</section>

<!-- Partners Tecnológicos -->
<section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-6 text-center">
        <div class="reveal">
            <h2 class="text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 mb-2">{t.partners.title}</h2>
            <p class="text-slate-600 mb-16">{t.homePage.partners.subtitle}</p>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-8 gap-6 items-center">
            {partnerLogos.map((socio, index) => (
                <div class="reveal group cursor-pointer" style={`transition-delay: ${(index % 4) * 80}ms`}>
                    <div class={`h-16 flex items-center justify-center font-bold text-slate-400 border border-slate-100 rounded-lg bg-white grayscale group-hover:grayscale-0 ${socio.colorClass} transition-all duration-300 hover:scale-105 hover:shadow-md`}>
                        {socio.name}
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>

<!-- Clientes -->
<section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6 text-center">
        <div class="reveal">
            <h2 class="text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 mb-2">{t.clients.title}</h2>
            <p class="text-slate-600 mb-16">{t.homePage.clients.subtitle}</p>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6 items-center">
            {t.homePage.clients.items.map((cliente, index) => (
                <div class="reveal group cursor-pointer" style={`transition-delay: ${(index % 3) * 100}ms`}>
                    <div class="h-16 flex items-center justify-center px-2 text-center text-sm font-bold text-slate-400 border border-slate-100 rounded-lg bg-slate-50/50 grayscale group-hover:grayscale-0 group-hover:text-tyta-blue transition-all duration-300 hover:scale-105 hover:shadow-md hover:bg-white">
                        {cliente.name}
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>

<!-- Casos de Éxito / Testimonios -->
<section class="reveal py-24 bg-slate-50/50">
    <div class="max-w-7xl mx-auto px-6 text-center">
        <span class="inline-block px-4 py-1.5 mb-4 text-xs font-semibold tracking-wider uppercase bg-slate-200/60 rounded-full text-slate-700">{t.aboutPage.successStories.badge}</span>
        <h2 class="text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 mb-3">{t.aboutPage.successStories.title}</h2>
        <p class="text-slate-500 mb-16 max-w-xl mx-auto">{t.aboutPage.successStories.subtitle}</p>
    </div>
    
    <div class="max-w-5xl mx-auto px-6 relative">
        <div class="testimonials-swiper swiper overflow-hidden">
            <div class="swiper-wrapper !flex !items-stretch">
                {t.aboutPage.successStories.testimonials.map((testimonio) => (
                    <div class="swiper-slide !h-auto p-3 flex">
                        <div class="w-full h-full flex flex-col justify-between bg-white p-8 md:p-10 rounded-3xl shadow-xl shadow-slate-200/50 border border-slate-100 text-left relative group hover:-translate-y-2 hover:shadow-2xl hover:shadow-slate-300/50 hover:border-tyta-amber transition-all duration-300">
                            <div>
                                <div class="flex items-center gap-1 text-amber-400 mb-6 text-lg">
                                    ★★★★★
                                </div>
                                <p class="text-slate-600 text-base md:text-lg mb-6 leading-relaxed italic">
                                    "{testimonio.text}"
                                </p>
                                {t.aboutPage.successStories.translatedNote && (
                                    <p class="text-xs text-slate-400 italic mb-6">{t.aboutPage.successStories.translatedNote}</p>
                                )}
                            </div>
                            <div class="border-t border-slate-100 pt-5 mt-auto flex items-center justify-between">
                                <div>
                                    <h4 class="font-bold text-slate-900 text-base">{testimonio.name}</h4>
                                    <p class="text-sm text-slate-500 font-medium">{testimonio.role}, <span class="text-slate-800">{testimonio.company}</span></p>
                                </div>
                                <div class="text-slate-200 text-5xl font-serif select-none group-hover:text-amber-400/30 transition-colors">”</div>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
            <div class="swiper-pagination !relative !bottom-0 mt-10"></div>
        </div>
    </div>
</section>

<!-- Noticias y Novedades -->
<section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-6">
        <div class="reveal text-center max-w-2xl mx-auto mb-16">
            <h2 class="text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 mb-4">{t.homePage.news.title}</h2>
            <p class="text-slate-600 text-lg">{t.homePage.news.subtitle}</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {newsImages.map((imgSrc, index) => (
                <article
                    class="reveal bg-slate-900 rounded-3xl border border-slate-800 shadow-xl shadow-slate-900/20 overflow-hidden hover:-translate-y-2 hover:shadow-2xl hover:border-tyta-amber transition-all duration-300 group flex flex-col"
                    style={`transition-delay: ${index * 120}ms`}
                >
                    <div class="w-full h-full relative overflow-hidden bg-slate-900">
                        <Image 
                            src={imgSrc} 
                            alt={`Noticia Redes T&TA ${index + 1}`}
                            class="w-full h-full object-cover block"
                        />
                    </div>
                </article>
            ))}
        </div>
    </div>
</section>

<!-- CTA Final -->
<section class="relative py-24 bg-gradient-to-br from-[#060b19] via-[#0b132b] to-[#111d42] text-white text-center overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(0,180,134,0.06),transparent_60%)] pointer-events-none"></div>
    
    <div class="reveal relative z-10 max-w-3xl mx-auto px-6">
        <span class="inline-block bg-white/10 backdrop-blur-md text-tyta-amber text-xs font-bold tracking-widest uppercase px-4 py-1.5 rounded-full border border-white/10 mb-6">
            {locale === 'es' ? 'Trabajemos juntos' : 'Let’s Work Together'}
        </span>
        <h2 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-6">{t.homePage.finalCta.title}</h2>
        <p class="text-base sm:text-lg text-slate-300 max-w-xl mx-auto mb-10 leading-relaxed">{t.homePage.finalCta.subtitle}</p>
        
        <a
            href={contactHref}
            class="group relative inline-flex items-center justify-center bg-tyta-amber text-slate-950 text-sm font-bold tracking-wider uppercase px-10 py-5 rounded-full overflow-hidden transition-all duration-300 shadow-[0_4px_25px_rgba(242,142,43,0.35)] hover:shadow-[0_6px_30px_rgba(242,142,43,0.5)] hover:-translate-y-0.5"
        >
            <span class="absolute inset-0 w-full h-full bg-gradient-to-r from-amber-400/0 via-white/40 to-amber-400/0 -translate-x-full group-hover:translate-x-full transition-transform duration-700 ease-out"></span>
            <span class="relative z-10 flex items-center gap-3">
                {t.homePage.finalCta.buttonLabel}
                <svg class="w-4 h-4 transform group-hover:translate-x-1.5 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
            </span>
        </a>
    </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" is:inline></script>
<script define:vars={{ numberLocale: locale === 'es' ? 'es-CR' : 'en-US' }} is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        new Swiper('.testimonials-swiper', {
            loop: true, 
            slidesPerView: 1, 
            spaceBetween: 30, 
            autoHeight: false,
            breakpoints: { 
                768: { slidesPerView: 2 } 
            },
            pagination: { 
                el: '.swiper-pagination', 
                clickable: true 
            },
            autoplay: { 
                delay: 6000, 
                disableOnInteraction: false 
            }
        });

        const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) entry.target.classList.add('active');
            });
        }, { threshold: 0.1 });

        document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));

        const counterObserver = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                const el = entry.target;
                const target = parseInt(el.dataset.target, 10);
                const prefix = el.dataset.prefix || '';
                const duration = 1600;
                const startTime = performance.now();

                function tick(now) {
                    const progress = Math.min((now - startTime) / duration, 1);
                    const eased = 1 - Math.pow(1 - progress, 3);
                    const current = Math.floor(eased * target);
                    el.textContent = prefix + current.toLocaleString(numberLocale);
                    if (progress < 1) {
                        requestAnimationFrame(tick);
                    } else {
                        el.textContent = prefix + target.toLocaleString(numberLocale);
                    }
                }
                requestAnimationFrame(tick);
                counterObserver.unobserve(el);
            });
        }, { threshold: 0.5 });

        document.querySelectorAll('.stat-counter').forEach((el) => counterObserver.observe(el));
    });
</script>
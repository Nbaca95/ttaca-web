---
// src/components/pages/ContactPage.astro
import { Image } from "astro:assets";
import bgContact from "../../assets/images/fondo-contact.jpg";
import { getLocaleFromUrl, getTranslations, localizedPath } from "../../i18n";

const locale = getLocaleFromUrl(Astro.url);
const t = getTranslations(locale);

const topicOptions = [
    { value: "it-outsourcing", label: t.services.itOutsourcing },
    { value: "it-consulting", label: t.services.itConsulting },
    { value: "hpe-authorized-center", label: t.services.hpeAuthorizedCenter },
    { value: "site-environmental-survey", label: t.services.siteEnvironmentalSurvey },
    { value: "other", label: t.contact.topicOther },
];

// Configura aquí tu enlace de Setmore
const setmoreBookingUrl = "https://tu-enlace-de-setmore.setmore.com";
---

<style>
    .reveal {
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.8s ease-out, transform 0.8s ease-out;
    }
    .reveal.active {
        opacity: 1;
        transform: translateY(0);
    }

    /* Floating label */
    .float-label {
        position: absolute;
        left: 1rem;
        top: 1rem;
        color: #64748b; /* slate-500 */
        pointer-events: none;
        transition: all 0.15s ease-out;
    }
    .float-input:focus + .float-label,
    .float-input:not(:placeholder-shown) + .float-label {
        top: 0.4rem;
        font-size: 0.7rem;
        font-weight: 700;
        color: #00529B; /* tyta-blue */
    }
    .float-input:not(:focus):not(:placeholder-shown) + .float-label {
        color: #475569; /* slate-600 */
    }
</style>

<main class="relative bg-white overflow-hidden">
    <!-- Fondo compartido por el encabezado y el formulario -->
    <div class="absolute inset-x-0 top-0 h-[560px] md:h-[950px] z-0 pointer-events-none">
        <Image src={bgContact} alt="" class="w-full h-full object-cover object-top md:object-[center_28%]" />
        <div class="absolute inset-0 bg-gradient-to-b from-slate-900/90 from-0% via-slate-900/40 via-55% to-white to-95%"></div>
    </div>

    <!-- Encabezado Armonizado -->
    <section class="relative z-10 h-[460px] flex items-center justify-center">
        <div class="max-w-3xl px-6 text-center text-white">
            <span class="inline-block px-6 py-2 mb-6 text-xs font-extrabold uppercase tracking-widest bg-slate-800 rounded-full text-tyta-amber border border-slate-700 shadow-md">
                {locale === 'en' ? 'Contact Us' : 'Comuníquese con Nosotros'}
            </span>
            <p class="text-lg text-slate-200 max-w-2xl mx-auto">
                {t.contact.subtitle}
            </p>
        </div>
    </section>

    <!-- Formulario + información -->
    <section class="relative z-10 max-w-6xl mx-auto px-4 pb-20 grid md:grid-cols-5 gap-12">
        <!-- Formulario -->
        <div class="reveal md:col-span-3">
            <div class="bg-white shadow-sm rounded-2xl p-8 border border-slate-100">
                <form id="contact-form" class="space-y-6" novalidate>
                    <input
                        type="checkbox"
                        name="botcheck"
                        class="hidden"
                        style="display: none;"
                        tabindex="-1"
                        autocomplete="off"
                    />

                    <input type="hidden" name="access_key" value="YOUR_WEB3FORMS_ACCESS_KEY" />
                    <input type="hidden" name="subject" value="Nuevo mensaje desde el sitio web T&TA" />

                    <div class="relative">
                        <input
                            type="text"
                            id="name"
                            name="name"
                            required
                            data-validate
                            placeholder=" "
                            class="float-input peer w-full px-4 pt-6 pb-2 rounded-lg border border-slate-200 bg-white focus:outline-none focus:ring-2 focus:ring-tyta-blue transition-colors"
                        />
                        <label for="name" class="float-label">{t.contact.name}</label>
                    </div>

                    <div class="relative">
                        <input
                            type="email"
                            id="email"
                            name="email"
                            required
                            data-validate
                            placeholder=" "
                            class="float-input peer w-full px-4 pt-6 pb-2 rounded-lg border border-slate-200 bg-white focus:outline-none focus:ring-2 focus:ring-tyta-blue transition-colors"
                        />
                        <label for="email" class="float-label">{t.contact.email}</label>
                    </div>

                    <div class="relative">
                        <input
                            type="tel"
                            id="phone"
                            name="phone"
                            data-validate
                            pattern="^[+]?[0-9\s\-().]{7,20}$"
                            placeholder=" "
                            class="float-input peer w-full px-4 pt-6 pb-2 rounded-lg border border-slate-200 bg-white focus:outline-none focus:ring-2 focus:ring-tyta-blue transition-colors"
                        />
                        <label for="phone" class="float-label">{t.contact.phone}</label>
                    </div>

                    <div>
                        <label for="topic" class="block text-sm font-bold text-slate-700 mb-2">{t.contact.topic}</label>
                        <select
                            id="topic"
                            name="topic"
                            class="w-full px-4 py-3 rounded-lg border border-slate-200 bg-white focus:outline-none focus:ring-2 focus:ring-tyta-blue transition-colors text-slate-700"
                        >
                            <option value="">{t.contact.topicPlaceholder}</option>
                            {topicOptions.map((option) => (
                                <option value={option.value}>{option.label}</option>
                            ))}
                        </select>
                    </div>

                    <div class="relative">
                        <textarea
                            id="message"
                            name="message"
                            rows="5"
                            required
                            data-validate
                            placeholder=" "
                            class="float-input peer w-full px-4 pt-6 pb-2 rounded-lg border border-slate-200 bg-white focus:outline-none focus:ring-2 focus:ring-tyta-blue transition-colors resize-none"
                        ></textarea>
                        <label for="message" class="float-label">{t.contact.message}</label>
                    </div>

                    <!-- Botón del formulario en color azul con efecto de flecha -->
                    <button
                        type="submit"
                        id="contact-submit"
                        class="group/btn inline-flex items-center justify-center bg-tyta-blue hover:bg-tyta-dark text-white font-bold uppercase tracking-wider text-sm px-8 py-4 rounded-full transition-all duration-300 shadow-md hover:shadow-lg disabled:opacity-60 disabled:cursor-not-allowed"
                    >
                        <span class="flex items-center gap-2">
                            {t.contact.submit}
                            <svg class="w-4 h-4 opacity-0 -translate-x-2 group-hover/btn:opacity-100 group-hover/btn:translate-x-0 transition-all duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                            </svg>
                        </span>
                    </button>

                    <div id="contact-result" class="hidden items-start gap-3 rounded-lg p-4 text-sm font-medium" role="status">
                        <span id="contact-result-icon" class="text-lg leading-none"></span>
                        <span id="contact-result-text"></span>
                    </div>
                </form>
            </div>
        </div>

        <!-- Información de contacto y Agendamiento Setmore con estilo unificado -->
        <div class="reveal md:col-span-2 space-y-6">
            <!-- Tarjeta de Canales de Comunicación -->
            <div class="bg-slate-900 rounded-3xl border border-tyta-amber p-8 space-y-6 shadow-[0_20px_40px_rgba(15,23,42,0.25)] relative overflow-hidden group">
                <!-- Línea superior amarilla decorativa -->
                <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-tyta-amber to-transparent"></div>

                <div>
                    <h2 class="text-xl font-extrabold text-white tracking-tight">
                        {locale === 'en' ? 'Communication Channels' : 'Canales de Comunicación'}
                    </h2>
                    <p class="text-xs text-slate-300 mt-1">
                        {locale === 'en' ? 'We are ready to assist your enterprise.' : 'Estamos listos para atender sus requerimientos tecnológicos.'}
                    </p>
                </div>

                <div class="flex gap-4 items-start">
                    <div class="w-12 h-12 rounded-2xl bg-slate-800 border border-slate-700 flex items-center justify-center text-xl shadow-inner flex-shrink-0">
                        📍
                    </div>
                    <div>
                        <p class="text-xs font-bold uppercase tracking-wider text-tyta-amber mb-0.5">{t.contactPage.addressLabel}</p>
                        <p class="text-slate-200 text-sm leading-relaxed">{t.contactPage.addressValue}</p>
                    </div>
                </div>

                <div class="flex gap-4 items-start">
                    <div class="w-12 h-12 rounded-2xl bg-slate-800 border border-slate-700 flex items-center justify-center text-xl shadow-inner flex-shrink-0">
                        📞
                    </div>
                    <div>
                        <p class="text-xs font-bold uppercase tracking-wider text-tyta-amber mb-0.5">{t.contactPage.phoneLabel}</p>
                        <a href="tel:+50622217783" class="text-slate-200 text-sm font-medium hover:text-tyta-amber transition-colors">(506) 2221-7783</a>
                    </div>
                </div>

                <div class="flex gap-4 items-start">
                    <div class="w-12 h-12 rounded-2xl bg-slate-800 border border-slate-700 flex items-center justify-center text-xl shadow-inner flex-shrink-0">
                        ✉️
                    </div>
                    <div>
                        <p class="text-xs font-bold uppercase tracking-wider text-tyta-amber mb-0.5">{t.contactPage.emailLabel}</p>
                        <a href="mailto:info@ttaca.com" class="text-slate-200 text-sm font-medium hover:text-tyta-amber transition-colors">info@ttaca.com</a>
                    </div>
                </div>
            </div>

            <!-- Tarjeta de Agendamiento -->
            <div class="bg-slate-900 rounded-3xl border border-tyta-amber p-8 space-y-6 shadow-[0_20px_40px_rgba(15,23,42,0.25)] relative overflow-hidden group">
                <!-- Línea superior amarilla decorativa -->
                <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-tyta-amber to-transparent"></div>

                <div class="flex items-center gap-4">
                    <div class="w-14 h-14 rounded-2xl bg-slate-800 border border-slate-700 flex items-center justify-center text-2xl shadow-inner flex-shrink-0">
                        📅
                    </div>
                    <div>
                        <h3 class="font-bold text-lg text-white">
                            {locale === 'en' ? 'Schedule a Session' : 'Agendar una sesión'}
                        </h3>
                        <p class="text-xs text-slate-300 mt-0.5">
                            {locale === 'en' ? 'Pick a date & time for a Teams meeting' : 'Seleccione fecha y hora para reunión por Teams'}
                        </p>
                    </div>
                </div>

                <p class="text-sm text-slate-300 leading-relaxed">
                    {locale === 'en' 
                        ? 'Book a direct slot with our technical experts through our scheduling calendar.' 
                        : 'Reserve un espacio directamente en nuestro calendario digital.'}
                </p>

                <!-- Botón de color amarillo con efecto de flecha -->
                <a
                    href={setmoreBookingUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group/btn relative w-full inline-flex items-center justify-center bg-tyta-amber text-slate-950 text-sm font-bold tracking-wider uppercase py-4 px-6 rounded-full overflow-hidden transition-all duration-300 shadow-[0_4px_25px_rgba(242,142,43,0.35)] hover:shadow-[0_6px_30px_rgba(242,142,43,0.5)] hover:-translate-y-0.5"
                >
                    <span class="absolute inset-0 w-full h-full bg-gradient-to-r from-amber-400/0 via-white/40 to-amber-400/0 -translate-x-full group-hover/btn:translate-x-full transition-transform duration-700 ease-out"></span>
                    <span class="relative z-10 flex items-center gap-2">
                        {locale === 'en' ? 'Book Online' : 'Reserva en línea'}
                        <svg class="w-4 h-4 opacity-0 -translate-x-2 group-hover/btn:opacity-100 group-hover/btn:translate-x-0 transition-all duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                        </svg>
                    </span>
                </a>
            </div>
        </div>
    </section>

    <!-- Mapa -->
    <section class="relative z-10 max-w-6xl mx-auto px-4 pb-20">
        <div class="reveal rounded-2xl overflow-hidden border border-slate-100 shadow-lg">
            <iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d982.4949586287995!2d-84.0909722!3d9.935635600000001!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8fa0e38e821b12d9%3A0x29f32212706035e0!2sT%26TA%20de%20Centroamerica!5e0!3m2!1ses!2scr!4v1786474357134!5m2!1ses!2scr"
                class="w-full h-72 md:h-[480px] block border-0"
                allowfullscreen
                loading="lazy"
                referrerpolicy="strict-origin-when-cross-origin"
                title={t.contactPage.mapTitle}
            ></iframe>
        </div>
    </section>
</main>

<script
    define:vars={{
        submittingLabel: t.contact.submitting,
        submitLabel: t.contact.submit,
        successMessage: t.contact.success,
        errorMessage: t.contact.error,
    }}
>
    const form = document.getElementById('contact-form');
    const submitBtn = document.getElementById('contact-submit');
    const resultEl = document.getElementById('contact-result');
    const resultIcon = document.getElementById('contact-result-icon');
    const resultText = document.getElementById('contact-result-text');

    if (form && submitBtn && resultEl && resultIcon && resultText) {
        form.addEventListener('submit', async (e) => {
            e.preventDefault();

            submitBtn.disabled = true;
            submitBtn.textContent = submittingLabel;
            resultEl.classList.add('hidden');
            resultEl.classList.remove('flex');

            try {
                const formData = new FormData(form);
                const response = await fetch('https://api.web3forms.com/submit', {
                    method: 'POST',
                    headers: { Accept: 'application/json' },
                    body: formData,
                });
                const result = await response.json();

                if (result.success) {
                    resultEl.className = 'flex items-start gap-3 rounded-lg p-4 text-sm font-medium bg-emerald-50 text-emerald-700 border border-emerald-200';
                    resultIcon.textContent = '✓';
                    resultText.textContent = successMessage;
                    form.reset();
                    document.querySelectorAll('#contact-form [data-validate]').forEach((field) => {
                        field.classList.remove('border-red-400', 'border-emerald-400');
                        field.classList.add('border-slate-200');
                    });
                } else {
                    throw new Error(result.message || 'Submission failed');
                }
            } catch (error) {
                resultEl.className = 'flex items-start gap-3 rounded-lg p-4 text-sm font-medium bg-red-50 text-red-700 border border-red-200';
                resultIcon.textContent = '⚠';
                resultText.textContent = errorMessage;
            } finally {
                submitBtn.disabled = false;
                submitBtn.textContent = submitLabel;
            }
        });
    }

    document.querySelectorAll('#contact-form [data-validate]').forEach((field) => {
        const markValidity = () => {
            field.classList.remove('border-red-400', 'border-emerald-400', 'border-slate-200');
            if (!field.value) {
                field.classList.add('border-slate-200');
                return;
            }
            field.classList.add(field.checkValidity() ? 'border-emerald-400' : 'border-red-400');
        };
        field.addEventListener('blur', markValidity);
        field.addEventListener('input', () => {
            if (field.classList.contains('border-red-400') || field.classList.contains('border-emerald-400')) {
                markValidity();
            }
        });
    });

    const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (entry.isIntersecting) entry.target.classList.add('active');
        });
    }, { threshold: 0.1 });

    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
</script>
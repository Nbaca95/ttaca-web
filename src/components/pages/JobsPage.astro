---
// src/components/pages/JobsPage.astro
import { getLocaleFromUrl, getTranslations } from "../../i18n";
import { Image } from 'astro:assets';
import jobImage from "../../assets/job3.jfif"; // Asegúrate de que el archivo sea .jpg

const locale = getLocaleFromUrl(Astro.url);
const t = getTranslations(locale);

const steps = [
    {
        href: "https://cloud07.legadmi.com/apex/f?p=2072:64::::::",
        icon: "📝",
        title: locale === 'en' ? 'Step 1' : 'Paso 1',
        text: locale === 'en' ? 'Register' : 'Registrarse',
        desc: locale === 'en' ? 'Register in our portal to submit your application.' : 'Regístrese en nuestro portal para iniciar su proceso de postulación.'
    },
    {
        href: "https://cloud07.legadmi.com/apex/f?p=2072:1:::::P1OS,SCHID:1,",
        icon: "🔑",
        title: locale === 'en' ? 'Step 2' : 'Paso 2',
        text: locale === 'en' ? 'Sign In' : 'Iniciar Sesión',
        desc: locale === 'en' ? 'Access your existing profile and manage your information.' : 'Ingrese a nuestro portal con sus credenciales registradas.'
    },
    {
        href: "https://cloud07.legadmi.com/apex/f?p=2072:84::::84::&cs=3cwtXoJtMsJkRrrqsSKzr_6NQP_AxmcJfL0GP8h9cB5vLOcsCDxUvXaEuN7JqI8paUB8D3vVe_m7fXt4ce9_Wpg",
        icon: "🔒",
        title: locale === 'en' ? 'Step 3' : 'Paso 3',
        text: locale === 'en' ? 'Forgot Password?' : 'Recuperar Contraseña',
        desc: locale === 'en' ? 'Recover your password quickly to sign back in.' : 'Recupere su contraseña de forma segura para recuperar el acceso.'
    }
];

const benefits = [
    locale === 'en' ? 'Fully online process' : 'Proceso 100% en línea',
    locale === 'en' ? 'Fast response' : 'Respuesta ágil',
    locale === 'en' ? 'Human support' : 'Soporte personalizado',
];
---

<style>
    .reveal {
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 1s cubic-bezier(0.16, 1, 0.3, 1), transform 1s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .reveal.active {
        opacity: 1;
        transform: translateY(0);
    }

    .dot-grid {
        background-image: radial-gradient(circle, #f39c12 1.5px, transparent 1.5px);
        background-size: 22px 22px;
    }

    @media (min-width: 1024px) {
        .fade-desktop {
            -webkit-mask-image: linear-gradient(to right, rgba(0,0,0,0) 0%, rgba(0,0,0,0.4) 12%, rgba(0,0,0,1) 30%, rgba(0,0,0,1) 100%);
            mask-image: linear-gradient(to right, rgba(0,0,0,0) 0%, rgba(0,0,0,0.4) 12%, rgba(0,0,0,1) 30%, rgba(0,0,0,1) 100%);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .reveal { opacity: 1; transform: none; transition: none; }
        .pulse-dot { animation: none; }
    }

    .pulse-dot {
        animation: pulse-ring 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }
    @keyframes pulse-ring {
        0%, 100% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.45); }
        50% { box-shadow: 0 0 0 6px rgba(34, 197, 94, 0); }
    }
</style>

<main class="relative bg-white text-slate-800 min-h-screen selection:bg-amber-500/20 flex flex-col justify-between overflow-hidden">
    <!-- Fondo decorativo sutil -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="absolute -top-[10%] -right-[5%] w-[700px] h-[700px] bg-blue-50/50 rounded-full blur-[150px]"></div>
        <div class="absolute bottom-[5%] -left-[5%] w-[600px] h-[600px] bg-amber-50/40 rounded-full blur-[130px]"></div>
    </div>

    <!-- Contenedor Principal -->
    <section class="relative z-10 max-w-7xl mx-auto px-6 py-12 w-full grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center my-auto">

        <!-- COLUMNA IZQUIERDA: Títulos y Tarjetas -->
        <div class="lg:col-span-6 space-y-7 reveal relative z-20">
            <div class="space-y-3">
                <h1 class="text-3xl md:text-4xl xl:text-5xl font-extrabold tracking-tight leading-tight">
                    <span class="bg-gradient-to-r from-[#123456] via-[#1a4a75] to-[#f39c12] bg-clip-text text-transparent">
                        {locale === 'en' ? 'Your next role starts here' : 'Tu próximo paso profesional empieza aquí'}
                    </span>
                </h1>

                <p class="text-sm md:text-base text-slate-600 max-w-lg leading-relaxed font-normal">
                    {locale === 'en'
                        ? 'Create your profile in minutes and get matched with open roles that fit your experience.'
                        : 'Crea tu perfil en minutos y descubre vacantes activas que se ajustan a tu experiencia.'}
                </p>

                <ul class="flex flex-wrap gap-x-5 gap-y-2 pt-1">
                    {benefits.map((b) => (
                        <li class="flex items-center gap-1.5 text-xs font-medium text-slate-500">
                            <svg class="w-3.5 h-3.5 text-[#f39c12] shrink-0" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7.4 7.4a1 1 0 01-1.4 0L3.3 9.5a1 1 0 111.4-1.4l3.6 3.6 6.7-6.7a1 1 0 011.4 0z" clip-rule="evenodd" />
                            </svg>
                            {b}
                        </li>
                    ))}
                </ul>
            </div>

            <!-- Tarjetas en Disposición Vertical -->
            <div class="flex flex-col gap-3.5 max-w-lg">
                {steps.map((item) => (
                    <a
                        href={item.href}
                        class="group relative bg-white hover:bg-slate-900 border border-slate-200/90 hover:border-[#f39c12] rounded-2xl p-4 transition-all duration-300 shadow-sm hover:shadow-xl hover:shadow-slate-900/10 flex items-center justify-between gap-4"
                    >
                        <div class="flex items-center gap-4">
                            <div class="w-11 h-11 rounded-2xl bg-slate-50 border border-slate-100 group-hover:bg-slate-800 group-hover:border-slate-700 flex items-center justify-center text-2xl shrink-0 transition-colors duration-300">
                                {item.icon}
                            </div>
                            <div>
                                <span class="text-[11px] font-bold uppercase tracking-wider text-[#f39c12]">
                                    {item.title}
                                </span>
                                <h3 class="text-base font-bold text-slate-900 group-hover:text-white transition-colors duration-300">
                                    {item.text}
                                </h3>
                                <p class="text-xs text-slate-500 group-hover:text-slate-300 leading-relaxed font-normal mt-0.5 transition-colors duration-300">
                                    {item.desc}
                                </p>
                            </div>
                        </div>
                        <div class="shrink-0 text-xs font-bold uppercase tracking-wider text-[#f39c12] opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300 flex items-center gap-1">
                            <span>{locale === 'en' ? 'Go' : 'Acceder'}</span>
                            <span class="text-sm">&rarr;</span>
                        </div>
                    </a>
                ))}
            </div>

            <!-- CTA principal 
            <a
                href={steps[0].href}
                class="inline-flex items-center gap-2.5 bg-[#123456] hover:bg-[#0d2740] text-white font-bold text-sm px-6 py-3.5 rounded-full shadow-lg shadow-[#123456]/20 transition-colors duration-300"
            >
                {locale === 'en' ? 'Apply now' : 'Postularme ahora'}
                <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10.3 3.3a1 1 0 011.4 0l5 5a1 1 0 010 1.4l-5 5a1 1 0 01-1.4-1.4L13.6 10H4a1 1 0 110-2h9.6l-3.3-3.3a1 1 0 010-1.4z" clip-rule="evenodd" />
                </svg>
            </a> -->
        </div>

        <!-- COLUMNA DERECHA: Imagen -->
        <div class="lg:col-span-6 reveal flex justify-center lg:justify-end items-center relative z-30 w-full">
            <div class="relative w-full max-w-lg lg:max-w-none flex items-center justify-center lg:justify-end">

                <!-- Patrón de puntos decorativo (eco del logo) -->
                <div class="dot-grid absolute -top-6 -left-6 w-32 h-32 opacity-30 pointer-events-none hidden sm:block"></div>

                <!-- Marco de acento detrás de la imagen -->
                <div class="absolute inset-0 translate-x-3 translate-y-3 rounded-2xl border-2 border-[#f39c12]/40 hidden sm:block"></div>

                <Image
                    src={jobImage}
                    alt={locale === 'en' ? 'Join the T&TA team' : 'Oportunidades laborales en T&TA'}
                    width={800}
                    height={600}
                    class="relative z-30 w-full h-auto object-cover max-h-[600px] rounded-2xl shadow-xl fade-desktop"
                />

                <!-- Insignia flotante 
                <div class="absolute z-40 -bottom-5 left-4 sm:left-8 bg-white rounded-xl shadow-xl border border-slate-100 px-4 py-3 flex items-center gap-3 max-w-[220px]">
                    <span class="relative flex h-2.5 w-2.5 shrink-0">
                        <span class="pulse-dot absolute inline-flex h-full w-full rounded-full bg-green-500"></span>
                    </span>
                    <p class="text-xs font-semibold text-slate-800 leading-snug">
                        {locale === 'en' ? 'Hiring is open right now' : 'Estamos contratando ahora'}
                    </p>
                </div> -->
            </div>
        </div>

    </section>
</main>

<script>
    const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (entry.isIntersecting) entry.target.classList.add('active');
        });
    }, { threshold: 0.1 });

    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
</script>
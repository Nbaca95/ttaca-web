---
// src/components/Footer.astro
import { Image } from "astro:assets";
import backgroundPattern from "../assets/content.png";
import { getLocaleFromUrl, getTranslations, localizedPath } from "../i18n";

const locale = getLocaleFromUrl(Astro.url);
const t = getTranslations(locale);
const currentYear = new Date().getFullYear();

const homeHref = localizedPath(locale, "/");
const aboutHref = localizedPath(locale, "/about");
const jobsHref = localizedPath(locale, "/jobs");
const contactHref = localizedPath(locale, "/contact");
const privacyHref = localizedPath(locale, "/privacy");
const serviceHref = (slug: string) => localizedPath(locale, `/services/${slug}`);
---

<footer class="relative bg-slate-900 text-slate-300 py-12 border-t-4 border-tyta-amber overflow-hidden">
    <!-- Capa de fondo con la imagen y el degradado azul -->
    <div class="absolute inset-0 z-0 opacity-20">
        <Image
            src={backgroundPattern}
            alt="Fondo técnico"
            class="w-full h-full object-cover"
        />
        <!-- Degradado azul superpuesto -->
        <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/90 to-blue-900/40"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">

        <!-- Columna 1: Branding/Contacto -->
        <div class="space-y-4">
            <h3 class="text-white font-bold text-lg">T&TA Centroamérica</h3>
            <p class="text-sm leading-relaxed">
                {t.footer.description}
            </p>
            <div class="text-sm space-y-2 pt-2">
                <p class="flex items-center gap-2"><span class="text-tyta-amber">📍</span> San José, Costa Rica</p>
                <p class="flex items-center gap-2"><span class="text-tyta-amber">📞</span> (506) 2221-7783</p>
                <p class="flex items-center gap-2"><span class="text-tyta-amber">✉️</span> info@ttaca.com</p>
            </div>
        </div>

        <!-- Columna 2: Servicios -->
        <div>
            <h3 class="text-white font-bold text-lg mb-4">{t.services.title}</h3>
            <ul class="space-y-2 text-sm">
                <li><a href={serviceHref("it-outsourcing")} class="hover:text-tyta-amber transition-colors">{t.services.itOutsourcing}</a></li>
                <li><a href={serviceHref("it-consulting")} class="hover:text-tyta-amber transition-colors">{t.services.itConsulting}</a></li>
                <li><a href={serviceHref("hpe-authorized-center")} class="hover:text-tyta-amber transition-colors">{t.services.hpeAuthorizedCenter}</a></li>
                <li><a href={serviceHref("site-environmental-survey")} class="hover:text-tyta-amber transition-colors">{t.services.siteEnvironmentalSurvey}</a></li>
            </ul>
        </div>

        <!-- Columna 3: Enlaces -->
        <div>
            <h3 class="text-white font-bold text-lg mb-4">{t.footer.company}</h3>
            <ul class="space-y-2 text-sm">
                <li><a href={homeHref} class="hover:text-tyta-amber transition-colors">{t.nav.home}</a></li>
                <li><a href={aboutHref} class="hover:text-tyta-amber transition-colors">{t.nav.about}</a></li>
                <li><a href={jobsHref} class="hover:text-tyta-amber transition-colors">{t.nav.jobs}</a></li>
                <li><a href={contactHref} class="hover:text-tyta-amber transition-colors">{t.nav.contact}</a></li>
            </ul>
        </div>

        <!-- Columna 4: Redes y Privacidad -->
        <div>
            <h3 class="text-white font-bold text-lg mb-4">{t.footer.followUs}</h3>
            <div class="flex space-x-3 mb-6">
                <a href="#" class="hover:text-[#1877F2] transition-colors">
                    <span class="sr-only">Facebook</span>
                    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg>
                </a>
                <a href="#" class="hover:text-white transition-colors">
                    <span class="sr-only">X (Twitter)</span>
                    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                </a>
                <a href="#" class="hover:text-[#E1306C] transition-colors">
                    <span class="sr-only">Instagram</span>
                    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.77 1.683 4.922 4.92.058 1.266.07 1.646.07 4.85s-.012 3.584-.07 4.85c-.149 3.235-1.666 4.77-4.92 4.922-1.266.058-1.646.07-4.85.07s-3.584-.012-4.85-.07c-3.235-.149-4.77-1.666-4.922-4.922-.058-1.266-.07-1.646-.07-4.85s.012-3.584.07-4.85c.148-3.235 1.683-4.77 4.92-4.922 1.266-.058 1.646-.07 4.85-.07zm0 1.583c-3.155 0-3.528.012-4.774.068-2.613.12-3.696 1.488-3.815 3.815-.056 1.247-.068 1.619-.068 4.774s.012 3.528.068 4.774c.12 2.613 1.488 3.696 3.815 3.815 1.247.056 1.619.068 4.774.068s3.528-.012 4.774-.068c2.613-.12 3.696-1.488 3.815-3.815.056-1.247.068-1.619.068-4.774s-.012-3.528-.068-4.774c-.12-2.613-1.488-3.696-3.815-3.815-1.247-.056-1.619-.068-4.774-.068zm0 3.036a5.217 5.217 0 110 10.434 5.217 5.217 0 010-10.434zm0 1.583a3.634 3.634 0 100 7.268 3.634 3.634 0 000-7.268zm5.952-4.52a1.217 1.217 0 110 2.434 1.217 1.217 0 010-2.434z"/></svg>
                </a>
                <a href="#" class="hover:text-[#0077B5] transition-colors">
                    <span class="sr-only">LinkedIn</span>
                    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                </a>
            </div>

            <!-- Políticas de Privacidad -->
            <h3 class="text-white font-bold text-lg mb-2">{locale === 'es' ? 'Legal' : 'Legal'}</h3>
            <ul class="space-y-2 text-sm">
                <li>
                    <a href={privacyHref} class="hover:text-tyta-amber transition-colors">
                        {locale === 'es' ? 'Política de Privacidad' : 'Privacy Policy'}
                    </a>
                </li>
            </ul>
        </div>
    </div>

    <!-- Copyright -->
    <div class="relative z-10 max-w-7xl mx-auto px-4 mt-12 pt-8 border-t border-slate-700/50 text-center text-xs text-slate-500">
        &copy; {currentYear} T&TA Centroamérica. {t.footer.rights}
    </div>
</footer>
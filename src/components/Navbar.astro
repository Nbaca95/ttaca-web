---
// src/components/Navbar.astro
import { Image } from "astro:assets";
import logoEstatico from "../assets/logo-estatico.webp";
import logoAnimado from "../assets/logo-animado.gif";
//import ThemeToggle from "./ThemeToggle.tsx";
import {
  getLocaleFromUrl,
  getTranslations,
  localizedPath,
  stripLocalePrefix,
} from "../i18n";

const locale = getLocaleFromUrl(Astro.url);
const t = getTranslations(locale);
const otherLocale = locale === "es" ? "en" : "es";
const rawPath = stripLocalePrefix(Astro.url.pathname);

const homeHref = localizedPath(locale, "/");
const aboutHref = localizedPath(locale, "/about");
const jobsHref = localizedPath(locale, "/jobs");
const contactHref = localizedPath(locale, "/contact");
const otherLocaleHref = localizedPath(otherLocale, rawPath);

// Marcas dentro del sub-dropdown "Consultoría de TI"
const brandServices = [
  { slug: "veeam", label: t.services.veeam },
  { slug: "aruba-networks", label: t.services.arubaNetworks },
  { slug: "vmware", label: t.services.vmware },
  { slug: "dell", label: t.services.dell },
  { slug: "lenovo", label: t.services.lenovo },
  { slug: "site-environmental-survey", label: t.services.siteEnvironmentalSurvey },
] as const;

const serviceHref = (slug: string) => localizedPath(locale, `/services/${slug}`);
---

<div class="w-full sticky top-0 z-50 shadow-xs">
    <div
        class="w-full bg-[var(--color-bg)] border-b border-[var(--color-border)] py-2.5 text-xs text-[var(--color-text-secondary)] hidden md:block"
    >
        <div
            class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row justify-center items-center gap-6"
        >
            <div class="flex items-center space-x-6">
                <a
                    href="tel:+50622217783"
                    class="flex items-center space-x-2 hover:text-tyta-blue transition-colors font-medium"
                >
                    <svg
                        class="w-4 h-4 text-tyta-blue"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                    >
                        <path
                            d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-1C7.42 18 2 12.58 2 6V3z"
                        ></path>
                    </svg>
                    <span>(506) 2221-7783</span>
                </a>
                <a
                    href="mailto:info@ttaca.com"
                    class="flex items-center space-x-2 hover:text-tyta-blue transition-colors font-medium"
                >
                    <svg
                        class="w-4 h-4 text-tyta-blue"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                    >
                        <path
                            d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"
                        ></path>
                        <path
                            d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"
                        ></path>
                    </svg>
                    <span>info@ttaca.com</span>
                </a>
            </div>

            <span class="text-gray-300 hidden sm:block">|</span>

            <div class="flex items-center space-x-4">
                <a
                    href="#"
                    class="hover:text-[#1877F2] transition-colors"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <span class="sr-only">Facebook</span>
                    <svg
                        class="w-4 h-4"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"
                        ></path>
                    </svg>
                </a>

                <a
                    href="#"
                    class="hover:text-black transition-colors"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <span class="sr-only">X (Twitter)</span>
                    <svg
                        class="w-4 h-4"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                        ></path>
                    </svg>
                </a>

                <a
                    href="#"
                    class="hover:text-[#E1306C] transition-colors"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <span class="sr-only">Instagram</span>
                    <svg
                        class="w-4 h-4"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M12.315 2c2.43 0 2.784.01 3.71.054 1.139.052 1.907.23 2.58.5a4.764 4.764 0 011.665 1.086 4.74 4.74 0 011.086 1.665c.269.672.447 1.44.5 2.58.044.925.054 1.28.054 3.71s-.01 2.784-.054 3.71c-.052 1.139-.23 1.907-.5 2.58a4.764 4.764 0 01-1.086 1.665 4.74 4.74 0 01-1.665 1.086c-.672.269-1.44.447-2.58.5-.925.044-1.28.054-3.71.054s-2.784-.01-3.71-.054c-1.139-.052-1.907-.23-2.58-.5a4.74 4.74 0 01-1.665-1.086 4.74 4.74 0 01-1.086-1.665c-.269-.672-.447-1.44-.5-2.58C2.01 14.315 2 13.96 2 11.517s.01-2.784.054-3.71c.052-1.139.23-1.907.5-2.58A4.74 4.74 0 013.639 4.13a4.74 4.74 0 011.665-1.086c.672-.268 1.44-.447 2.58-.5.925-.044 1.28-.054 3.71-.054zM12 7a5 5 0 100 10 5 5 0 000-10zm0 8.333a3.333 3.333 0 110-6.666 3.333 3.333 0 010 6.666zm5.333-8.666a.833.833 0 100-1.666.833.833 0 000 1.666z"
                            clip-rule="evenodd"></path>
                    </svg>
                </a>

                <a
                    href="#"
                    class="hover:text-[#0077B5] transition-colors"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <span class="sr-only">LinkedIn</span>
                    <svg
                        class="w-4 h-4"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
                        ></path>
                    </svg>
                </a>
            </div>
        </div>
    </div>

    <header class="w-full bg-[var(--color-bg)] border-b border-[var(--color-border)] relative">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-24">
                <div
                    class="w-[200px] flex-shrink-0 flex items-center py-2 overflow-hidden justify-start"
                >
                    <a
                        id="logo-link"
                        href={homeHref}
                        class="cursor-pointer block focus:outline-none"
                    >
                        <Image
                            id="logo-img"
                            src={logoEstatico}
                            alt="Logo T&TA Centroamérica"
                            class="h-20 w-auto object-contain transition-all duration-300 transform origin-left"
                        />
                    </a>
                </div>

                <nav
                    class="hidden md:flex space-x-8 text-sm font-semibold tracking-wide ml-50 flex-grow justify-start h-full items-center"
                >
                    <a
                        href={homeHref}
                        aria-current={rawPath === "/" ? "page" : undefined}
                        class="text-slate-700 hover:text-tyta-amber border-b-2 border-transparent hover:border-tyta-amber transition-all duration-200 px-1 py-2"
                    >
                        {t.nav.home}
                    </a>
                    <a
                        href={aboutHref}
                        aria-current={rawPath === "/about" ? "page" : undefined}
                        class="text-slate-700 hover:text-tyta-amber border-b-2 border-transparent hover:border-tyta-amber transition-all duration-200 px-1 py-2"
                    >
                        {t.nav.about}
                    </a>

                    <div
                        class="relative group px-1 py-2 border-b-2 border-transparent hover:border-tyta-amber transition-all duration-200"
                    >
                        <button
                            type="button"
                            aria-haspopup="true"
                            class="text-slate-700 group-hover:text-tyta-amber flex items-center space-x-1 cursor-pointer transition-colors"
                        >
                            <span>{t.nav.services}</span>
                            <svg
                                class="w-4 h-4 transition-transform group-hover:rotate-180"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </button>

                        <div
                            class="absolute left-0 mt-2.5 w-64 bg-[var(--color-bg)] border border-[var(--color-border)] rounded-md shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 py-2"
                        >
                            <a
                                href={serviceHref("it-outsourcing")}
                                class="block px-4 py-3 text-sm text-slate-800 hover:bg-slate-50 hover:text-tyta-amber font-medium transition-colors"
                            >
                                {t.services.itOutsourcing}
                            </a>
                            <a
                                href={serviceHref("hpe-authorized-center")}
                                class="block px-4 py-3 text-sm text-slate-800 hover:bg-slate-50 hover:text-tyta-amber font-medium transition-colors"
                            >
                                {t.services.hpeAuthorizedCenter}
                            </a>

                            <div class="relative group/sub">
                                <a
                                    href={serviceHref("it-consulting")}
                                    class="w-full flex items-center justify-between px-4 py-3 text-sm text-slate-800 hover:bg-slate-50 hover:text-tyta-amber font-medium transition-colors"
                                >
                                    <span>{t.services.itConsulting}</span>
                                    <svg
                                        class="w-4 h-4 text-gray-400 group-hover/sub:text-tyta-amber transition-colors"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M9 5l7 7-7 7"></path>
                                    </svg>
                                </a>

                                <div
                                    class="absolute left-full top-0 ml-0.5 w-56 bg-[var(--color-bg)] border border-[var(--color-border)] rounded-md shadow-xl opacity-0 invisible group-hover/sub:opacity-100 group-hover/sub:visible transition-all duration-200 py-2"
                                >
                                    {brandServices.map((brand) => (
                                        <a
                                            href={serviceHref(brand.slug)}
                                            class="block px-4 py-2.5 text-sm text-slate-800 hover:bg-slate-50 hover:text-tyta-amber font-medium transition-colors"
                                        >
                                            {brand.label}
                                        </a>
                                    ))}
                                </div>
                            </div>
                        </div>
                    </div>

                    <a
                        href={jobsHref}
                        aria-current={rawPath === "/jobs" ? "page" : undefined}
                        class="text-slate-700 hover:text-tyta-amber border-b-2 border-transparent hover:border-tyta-amber transition-all duration-200 px-1 py-2"
                    >
                        {t.nav.jobs}
                    </a>
                    <a
                        href={contactHref}
                        aria-current={rawPath === "/contact" ? "page" : undefined}
                        class="text-slate-700 hover:text-tyta-amber border-b-2 border-transparent hover:border-tyta-amber transition-all duration-200 px-1 py-2"
                    >
                        {t.nav.contact}
                    </a>
                </nav>

                <div class="hidden md:flex items-center flex-shrink-0 gap-4">
                    {/* Selector de idioma con estilo tipo botón */}
                    <div
                        class="inline-flex items-center p-1 bg-slate-100 rounded-full border border-slate-200 text-xs font-bold"
                        aria-label={t.nav.language}
                    >
                        <a
                            href={locale === "es" ? undefined : otherLocaleHref}
                            aria-current={locale === "es" ? "page" : undefined}
                            class={`px-3 py-1.5 rounded-full transition-all duration-200 ${
                                locale === "es"
                                    ? "bg-white text-tyta-blue shadow-xs"
                                    : "text-slate-500 hover:text-tyta-blue"
                            }`}
                        >
                            ES
                        </a>
                        <a
                            href={locale === "en" ? undefined : otherLocaleHref}
                            aria-current={locale === "en" ? "page" : undefined}
                            class={`px-3 py-1.5 rounded-full transition-all duration-200 ${
                                locale === "en"
                                    ? "bg-white text-tyta-blue shadow-xs"
                                    : "text-slate-500 hover:text-tyta-blue"
                            }`}
                        >
                            EN
                        </a>
                    </div>

                    

                    {/* Botón Contáctanos comentado para el futuro */}
                    {/* 
                    <a
                        href={contactHref}
                        class="bg-tyta-blue hover:bg-tyta-dark text-white text-xs font-bold tracking-wider uppercase px-6 py-3 rounded-full transition-all duration-300 shadow-md hover:shadow-lg"
                    >
                        {t.nav.contactCta}
                    </a>
                    */}
                </div>

                <div class="flex md:hidden">
                    <button
                        id="mobile-menu-button"
                        type="button"
                        aria-label="Abrir menú"
                        aria-expanded="false"
                        class="text-gray-600 hover:text-tyta-blue focus:outline-none p-2 cursor-pointer"
                    >
                        <svg
                            class="h-6 w-6"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <div
        id="mobile-menu"
        class="hidden md:hidden bg-[var(--color-bg)] border-b border-[var(--color-border)] px-3 pt-3 pb-5 shadow-lg transition-all duration-300 ease-in-out origin-top transform scale-y-0 opacity-0"
    >
        <a
            href={homeHref}
            aria-current={rawPath === "/" ? "page" : undefined}
            class="mobile-link block font-semibold text-sm py-3 px-3 rounded-lg text-tyta-amber"
        >
            {t.nav.home}
        </a>
        <a
            href={aboutHref}
            aria-current={rawPath === "/about" ? "page" : undefined}
            class="mobile-link block text-slate-700 font-semibold text-sm py-3 px-3 rounded-lg"
        >
            {t.nav.about}
        </a>

        <details class="mobile-accordion">
            <summary class="flex items-center justify-between text-slate-700 font-semibold text-sm py-3 px-3 rounded-lg cursor-pointer list-none">
                <span>{t.nav.services}</span>
                <svg class="chevron w-4 h-4 text-slate-400 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
            </summary>

            <div class="pl-3 pb-1 space-y-0.5">
                <a
                    href={serviceHref("it-outsourcing")}
                    class="mobile-link block text-slate-600 text-sm py-2.5 px-3 rounded-lg"
                >
                    {t.services.itOutsourcing}
                </a>
                <a
                    href={serviceHref("hpe-authorized-center")}
                    class="mobile-link block text-slate-600 text-sm py-2.5 px-3 rounded-lg"
                >
                    {t.services.hpeAuthorizedCenter}
                </a>

                <details class="mobile-accordion mobile-accordion-nested">
                    <summary class="flex items-center justify-between text-slate-600 text-sm py-2.5 px-3 rounded-lg cursor-pointer list-none">
                        <span>{t.services.itConsulting}</span>
                        <svg class="chevron w-3.5 h-3.5 text-slate-300 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                        </svg>
                    </summary>
                    <div class="pl-3 space-y-0.5">
                        {brandServices.map((brand) => (
                            <a
                                href={serviceHref(brand.slug)}
                                class="mobile-link block text-slate-500 text-xs py-2 px-3 rounded-lg"
                            >
                                {brand.label}
                            </a>
                        ))}
                    </div>
                </details>
            </div>
        </details>

        <a
            href={jobsHref}
            aria-current={rawPath === "/jobs" ? "page" : undefined}
            class="mobile-link block text-slate-700 font-semibold text-sm py-3 px-3 rounded-lg"
        >
            {t.nav.jobs}
        </a>
        <a
            href={contactHref}
            aria-current={rawPath === "/contact" ? "page" : undefined}
            class="mobile-link block text-slate-700 font-semibold text-sm py-3 px-3 rounded-lg"
        >
            {t.nav.contact}
        </a>

        <div class="border-t border-[var(--color-border)] my-2"></div>

        <div class="flex items-center justify-between px-3 py-1">
            {/* Selector de idioma móvil con estilo tipo botón */}
            <div
                class="inline-flex items-center p-1 bg-slate-100 rounded-full border border-slate-200 text-xs font-bold"
                aria-label={t.nav.language}
            >
                <a
                    href={locale === "es" ? undefined : otherLocaleHref}
                    aria-current={locale === "es" ? "page" : undefined}
                    class={`px-3 py-1.5 rounded-full transition-all duration-200 ${
                        locale === "es"
                            ? "bg-white text-tyta-blue shadow-xs"
                            : "text-slate-500 hover:text-tyta-blue"
                    }`}
                >
                    ES
                </a>
                <a
                    href={locale === "en" ? undefined : otherLocaleHref}
                    aria-current={locale === "en" ? "page" : undefined}
                    class={`px-3 py-1.5 rounded-full transition-all duration-200 ${
                        locale === "en"
                            ? "bg-white text-tyta-blue shadow-xs"
                            : "text-slate-500 hover:text-tyta-blue"
                    }`}
                >
                    EN
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    /* Links del menú móvil: hover suave consistente con el acento ámbar del desktop */
    .mobile-link {
        transition: background-color 0.2s ease, color 0.2s ease;
    }

    .mobile-link:hover {
        background-color: color-mix(in srgb, var(--color-tyta-blue) 6%, transparent);
        color: var(--color-tyta-blue);
    }

    .mobile-link[aria-current="page"] {
        color: var(--color-tyta-amber);
    }

    /* Acordeón de Servicios / Consultoría de TI */
    .mobile-accordion summary::-webkit-details-marker {
        display: none;
    }

    .mobile-accordion > summary:hover {
        background-color: color-mix(in srgb, var(--color-tyta-blue) 6%, transparent);
    }

    .mobile-accordion[open] > summary .chevron {
        transform: rotate(180deg);
    }

    .mobile-accordion-nested {
        margin-left: 0.25rem;
        border-left: 2px solid var(--color-border);
        padding-left: 0.5rem;
    }
</style>

<script
    define:vars={{
        staticSrc: logoEstatico.src,
        animatedSrc: logoAnimado.src,
        homeUrl: homeHref,
    }}
>
    // 1. Script de la animación del Logo y redirección a inicio con transición natural
    const logoLink = document.getElementById("logo-link");
    const logoImg = document.getElementById("logo-img");

    if (logoLink && logoImg) {
        logoLink.addEventListener("click", (e) => {
            e.preventDefault();
            
            // Forzar reinicio del GIF con timestamp y preparar clases de transición suave
            logoImg.src = `${animatedSrc}?t=${Date.now()}`;
            logoImg.classList.add("scale-110", "opacity-95", "transition-all", "duration-700");

            // Aumentamos el tiempo total a 3000ms (3 segundos) para que la animación respire por completo
            const animationDuration = 3000; 

            // Hacemos el fade out 400ms antes de terminar para suavizar la salida
            setTimeout(() => {
                logoImg.classList.add("opacity-0");
            }, animationDuration - 400);

            // Redirección final
            setTimeout(() => {
                window.location.href = homeUrl;
            }, animationDuration);
        });
    }

    // 2. Script para Alternar Menú Móvil con Animación
    const menuButton = document.getElementById("mobile-menu-button");
    const mobileMenu = document.getElementById("mobile-menu");

    if (menuButton && mobileMenu) {
        menuButton.addEventListener("click", () => {
            const isOpen = menuButton.getAttribute("aria-expanded") === "true";
            menuButton.setAttribute("aria-expanded", String(!isOpen));

            mobileMenu.classList.toggle("hidden");
            setTimeout(() => {
                mobileMenu.classList.toggle("scale-y-0");
                mobileMenu.classList.toggle("scale-y-100");
                mobileMenu.classList.toggle("opacity-0");
                mobileMenu.classList.toggle("opacity-100");
            }, 10);
        });
    }
</script>
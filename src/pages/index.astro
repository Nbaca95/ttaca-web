---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
---

<Layout title="Inicio">
	<!-- 1. Menú de navegación global -->
	<Navbar />
	<Hero />

	<!-- 2. Contenedor temporal del cuerpo (Aquí irá el Hero pronto) -->
	<main class="bg-gray-50 py-20 px-6 text-center">
		<h2 class="text-2xl font-bold text-tyta-dark">
			¡Navbar instalado con éxito!
		</h2>
		<p class="text-gray-600 mt-2">
			Mira el navegador para comprobar la barra superior blanca con los estilos corporativos.
		</p>
	</main>
</Layout>